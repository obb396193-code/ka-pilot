      "title": "请求样例",
      "type": "shell",
      "body": "curl -X POST 'https://ad.e.kuaishou.com/rest/openapi/gw/dmp/v2/dmp/population/file/upload' \\\n-H 'Access-Token: [REDACTED_SECRET_EXAMPLE]' \\\n-H 'Content-Type: multipart/form-data' \\\n-F 'advertiser_id=\"12345678\"' \\\n-F 'file=@\"/Users/xxxxxxx03/Desktop/测试人群包/imei-md5.txt\"' \\\n-F 'type=\"3\"'"
    }
  ],
  "outputParamExampleList": [
