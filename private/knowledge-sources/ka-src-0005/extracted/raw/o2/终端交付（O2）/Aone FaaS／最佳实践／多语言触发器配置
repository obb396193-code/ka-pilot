## http 触发器

脚手架默认生成的为 http 触发器，对应的配置文件

(https://o2-img.alistatic.com/i/i09blZ/eHdPM77v4XOdGtRHEmcM0-efd497314a.png)


```
{
  "spec-version": "1.1.0",
  "functions": [
    {
      "name": "main",
      "archive": "./archives/code.zip",
      "handler": "main.handler",
      "trigger": [
        {
          "http": {
            "method": [
              "get",
              "post",
              "put",
              "delete",
              "head"
            ],
            "path": "/*"
          }
        }
      ]
    }
  ],
  "gateway": {
    "kind": "simple-mapping",
    "paths": {
      "/*": {
        "GET": {
          "x-gateway-intergration": {
            "type": "function",
            "url": {
              "group": "${自己应用的应用名}", // 特别注意！！
              "name": "main",
              "version": "latest"
            }
          }
        },
        "POST": {
          "x-gateway-intergration": {
            "type": "function",
            "url": {
              "group": "${自己应用的应用名}", // 特别注意！！
              "name": "main",
              "version": "latest"
            }
          }
        }
      }
    },
    "x-gateway-domain": ""${自己应用的应用名}".fn.alibaba-inc.com" // 特别注意！！
  },
  "platform": [
    "fiber"
  ]
}
```
## HSF 触发器

如果想发布 python faas hsf 服务需要改动触发器配置文件

```
{
  "spec-version": "1.1.0",
  "functions": [
    {
      "name": "main",
      "archive": "./archives/code.zip",
      "handler": "main.handler",
      "trigger": [
        {
          "hsf": true
        }
      ]
    }
  ],
  "platform": [
    "fiber"
  ]
}
```


