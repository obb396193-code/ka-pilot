### 变更创建

```
TOPIC: 'TP_DEF_WORK'

TAG: 'ChangeCreate'

data: {
  // 应用 id
  app_id,
  // 变更 id
  change_id,
  // 变更描述
  change_description,
  // 变更地址
  change_url,
  // 操作人工号
  change_empid,
  // 绑定工作项
  workitems: [
    {
      // 工作项类型
      workitem_type,
      // 工作项 id
      workitem_id,
    }
  ],
  // 额外信息
  extra_infos: {
    publish_plan_ids // 发布计划 id
  }
}
```
