#### Event



before-create-application

> 用于在创建前检查扩展表单的参数，返回是否通过并且可以追加扩展 form

```
// props.contextHelper.eventCenter
eventCenter.asyncOn('before-create-application', async ({ postData, solution }) => { 
  // postData 将要发送的创建应用 body 参数，postData.schema_data 自定义表单参数
  // solution 选择的解决方案（脚手架），solution.generator_detail.schema_json 脚手架 schmema json
  return {
    pass: false, // 格式检查是否通过
    postData: { // 自定义 merge 到 body 的参数
      custom_body_param: 111
    }
  }
});

// 开放平台的内部代码。如果是扩展点的业务方不需要管这部分代码
const eventResults = await e2EEventCenter.waitForAsyncEmit(EventName.beforeCreateApplication, { postData });
for (const eventResult of eventResults) {
  if (eventResult) {
    if (!eventResult.pass) {
      return;
    }
    if (eventResult.postData) {
      postData = {
        ...postData,
        ...eventResult.postData,
      };
    }
  }
}

```
