on></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-rwzk8SUs\">巨量营销平台客户id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">project_ids</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number[]</p></section><section class=\"col description\"><p data-id=\"p838747a-1JqATCoR\">项目id列表，每次最多传入50个</p><ul data-id=\"u738a58b-Z0TQ2bai\"><li data-id=\"ld70c578-kRMnlUFN\"><span style=\"color: #f5222d;\">注意：</span>仅允许传入投放账户下存在的project_id，否则应答参数中compensate_status会返回<code>UNSUPPORTED</code>表示查询失败，因为该项目在advertiser_id下不存在</li></ul></section></section></section><h1 data-id=\"h346b9f0-R72me4XL\" id=\"h346b9f0-R72me4XL\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Fproject%2Fcost_protect_status%2Fget%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%20%20%20%20project_ids_list%20%3D%20PROJECT_IDS%5Cn%20%20%20%20project_ids%20%3D%20json.dumps(project_ids_list)%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22project_ids%5C%5C%5C%22%3A%20%25s%7D%5C%22%20%25%20(advertiser_id%2C%20project_ids)%5Cn%20%20%20%20print(get(my_args))%5Cn%20%20%20%20%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22import%20com.fasterxml.jackson.core.JsonProcessingException%3B%5Cnimport%20com.fasterxml.jackson.databind.ObjectMapper%3B%5Cnimport%20okhttp3.*%3B%5Cnimport%20org.apache.http.client.utils.URIBuilder%3B%5Cn%5Cnimport%20java.io.IOException%3B%5Cnimport%20java.net.URI%3B%5Cnimport%20java.net.URISyntaxException%3B%5Cnimport%20java.net.URL%3B%5Cnimport%20java.util.List%3B%5Cnimport%20java.util.Map%3B%5Cnimport%20java.util.stream.Collectors%3B%5Cn%5Cnpublic%20class%20Demo%20%7B%5Cn%20%20%20%20private%20static%20final%20String%20ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20String%20PATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Fproject%2Fcost_protect_status%2Fget%2F%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20ObjectMapper%20mapper%20%3D%20new%20ObjectMapper()%3B%5Cn%5Cn%20%20%20%20%2F**%5Cn%20%20%20%20%20*%20Build%20request%20URL%5Cn%20%20%20%20%20*%5Cn%20%20%20%20%20*%20%40param%20path%20Request%20path%5Cn%20%20%20%20%20*%20%40return%20Request%20URL%5Cn%20%20%20%20%20*%2F%5Cn%20%20%20%20private%20static%20String%20buildUrl(String%20path)%20throws%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20URI%20uri%20%3D%20new%20URI(%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%2C%20path%2C%20%5C%22%5C%22%2C%20%5C%22%5C%22)%3B%5Cn%20%20%20%20%20%20%20%20return%20uri.toString()%3B%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%5Cn%20%20%20%20%2F**%5Cn%20%20%20%20%20*%20Send%20GET%20request%5Cn%20%20%20%20%20*%5Cn%20%20%20%20%20*%20%40param%20jsonStr%3AArgs%20in%20JSON%20format%5Cn%20%20%20%20%20*%20%40return%20Response%20in%20JSON%20format%5Cn%20%20%20%20%20*%2F%5Cn%20%20%20%20private%20static%20String%20get(String%20jsonStr)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20OkHttpClient%20client%20%3D%20new%20OkHttpClient().newBuilder().build()%3B%5Cn%20%20%20%20%20%20%20%20URIBuilder%20ub%20%3D%20new%20URIBuilder(buildUrl(PATH))%3B%5Cn%20%20%20%20%20%20%20%20Map%3C%20String%2C%20Object%20%3E%20map%20%3D%20mapper.readValue(jsonStr%2C%20Map.class)%3B%5Cn%20%20%20%20%20%20%20%20map.forEach((k%2C%20v)%20-%3E%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20ub.addParameter(k%2C%20v%20instanceof%20String%20%3F%20(String)%20v%20%3A%20mapper.writeValueAsString(v))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%20catch%20(JsonProcessingException%20e)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20e.printStackTrace()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%7D)%3B%5Cn%20%20%20%20%20%20%20%20URL%20url%20%3D%20ub.build().toURL()%3B%5Cn%5Cn%20%20%20%20%20%20%20%20Request%20request%20%3D%20new%20Request.Builder()%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.url(url)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.method(%5C%22GET%5C%22%2C%20null)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.addHeader(%5C%22Access-Token%5C%22%2C%20ACCESS_TOKEN)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.build()%3B%5Cn%20%20%20%20%20%20%20%20Response%20response%20%3D%20client.newCall(request).execute()%3B%5Cn%20%20%20%20%20%20%20%20return%20response.body().string()%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20%5Cn%5Cn%20%20%20%20public%20static%20void%20main(String%5B%5D%20args)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20Long%20advertiser_id%20%3D%20ADVERTISER_ID%3B%5Cn%20%20%20%20%20%20%20%20List%20%3C%20Long%20%3E%20project_ids_list%20%3D%20PROJECT_IDS%3B%5Cn%20%20%20%20%20%20%20%20String%20project_ids%20%3D%20mapper.writeValueAsString(project_ids_list)%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20Args%20in%20JSON%20format%5Cn%20%20%20%20%20%20%20%20String%20myArgs%20%3D%20String.format(%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22project_ids%5C%5C%5C%22%3A%20%25s%7D%5C%22%2Cadvertiser_id%2C%20project_ids)%3B%5Cn%20%20%20%20%20%20%20%20System.out.println(get(myArgs))%3B%5Cn%20%20%20%20%7D%5Cn%7D%5Cn%22%7D%2C%7B%22language%22%3A%22php%22%2C%22text%22%3A%22%5Cn%24ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%24PATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Fproject%2Fcost_protect_status%2Fget%2F%5C%22%3B%5Cn%5Cn%2F**%5Cn%20*%20Build%20request%20URL%5Cn%20*%20%40param%20%24path%20%3A%20Request%20path%5Cn%20*%20%40return%20string%5Cn%20*%2F%5Cnfunction%20build_url(%24path)%5Cn%7B%5Cn%20%20%20%20return%20%5C%22https%3A%2F%2Fapi.oceanengine.com%5C%22%20.%20%24path%3B%5Cn%7D%5Cn%5Cn%2F**%5Cn%20*%20Send%20GET%20request%5Cn%20*%20%40param%20%24json_str%20%3A%20Args%20in%20JSON%20format%5Cn%20*%20%40return%20bool%7Cstring%20%3A%20Response%20in%20JSON%20format%5Cn%20*%2F%5Cnfunction%20get(%24json_str)%5Cn%7B%5Cn%20%20%20%20global%20%24ACCESS_TOKEN%2C%20%24PATH%3B%5Cn%20%20%20%20%24curl%20%3D%20curl_init()%3B%5Cn%5Cn%20%20%20%20%24args%20%3D%20json_decode(%24json_str%2C%20true)%3B%5Cn%5Cn%20%20%20%20%2F*%20Values%20of%20querystring%20is%20also%20in%20JSON%20format%20*%2F%5Cn%20%20%20%20foreach%20(%24args%20as%20%24key%20%3D%3E%20%24value)%20%7B%5Cn%20%20%20%20%20%20%20%20%24args%5B%24key%5D%20%3D%20is_string(%24value)%20%3F%20%24value%20%3A%20json_encode(%24value)%3B%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%24url%20%3D%20build_url(%24PATH)%20.%20%5C%22%3F%5C%22%20.%20http_build_query(%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%24args%5Cn%20%20%20%20%20%20%20%20)%3B%5Cn%5Cn%20%20%20%20curl_setopt_array(%24curl%2C%20array(%5Cn%20%20%20%20%20%20%20%20CURLOPT_URL%20%3D%3E%20%24url%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_RETURNTRANSFER%20%3D%3E%20true%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_ENCODING%20%3D%3E%20%5C%22%5C%22%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_MAXREDIRS%20%3D%3E%2010%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_TIMEOUT%20%3D%3E%200%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_FOLLOWLOCATION%20%3D%3E%20true%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_HTTP_VERSION%20%3D%3E%20CURL_HTTP_VERSION_1_1%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_CUSTOMREQUEST%20%3D%3E%20%5C%22GET%5C%22%2C%5Cn%20%20%20%20%20%20%20%20CURLOPT_HTTPHEADER%20%3D%3E%20array(%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%5C%22Access-Token%3A%20%5C%22%20.%20%24ACCESS_TOKEN%2C%5Cn%20%20%20%20%20%20%20%20)%2C%5Cn%20%20%20%20))%3B%5Cn%5Cn%20%20%20%20%24response%20%3D%20curl_exec(%24curl)%3B%5Cn%20%20%20%20curl_close(%24curl)%3B%5Cn%20%20%20%20return%20%24response%3B%5Cn%7D%5Cn%5Cn%5Cn%24advertiser_id%20%3D%20ADVERTISER_ID%3B%5Cn%24project_ids_list%20%3D%20PROJECT_IDS%3B%5Cn%24project_ids%20%3D%20json_encode(%24project_ids_list)%3B%5Cn%5Cn%2F*%20Args%20in%20JSON%20format%20*%2F%5Cn%24my_args%20%3D%20sprintf(%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22project_ids%5C%5C%5C%22%3A%20%25s%7D%5C%22%2C%20%24advertiser_id%2C%20%24project_ids)%3B%5Cnecho%20get(%24my_args)%3B%5Cn%22%7D%2C%7B%22language%22%3A%22curl%22%2C%22text%22%3A%22curl%20--get%20-H%20%5C%22Access-Token%3Axxx%5C%22%20%5C%5C%5Cn--data-urlencode%20%5C%22advertiser_id%3DADVERTISER_ID%5C%22%20%5C%5C%5Cn--data-urlencode%20%5C%22project_ids%3D%5B%5C%5C%5C%22PROJECT_IDS%5C%5C%5C%22%5D%5C%22%20%5C%5C%5Cnhttps%3A%2F%2Fapi.oceanengine.com%2Fopen_api%2Fv3.0%2Fproject%2Fcost_protect_status%2Fget%2F%22%7D%5D%2C%22disabled%22%3Atrue%2C%22wrap%22%3Afalse%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22id%22%3A%2233AUh%22%2C%22type%22%3A%22block%22%7D\"><div class=\"mulit-codeblock-header\"><div class=\"mulit-codeblock-header-item mulit-codeblock-header-item-active\">Python</div><div class=\"mulit-codeblock-header-item\">Java</div><div class=\"mulit-codeblock-header-item\">Php</div><div class=\"mulit-codeblock-header-item\">Curl</div></div><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 640px; overflow-y: scroll;\"><div class=\"qz-codeblock_content python\"></div><div class=\"qz-codeblock_content java\"></div><div class=\"qz-codeblock_content php\"></div><div class=\"qz-codeblock_content curl\"></div></div></div></div><h1 data-id=\"h346b9f0-W2BHjbbE\" id=\"h346b9f0-W2BHjbbE\">应答字段</h1><section class=\"table api-table\" data-tabletype=\"response\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 248px;\" width=\"248\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">code</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-qrMdFe77\">返回码,详见 <a href=\"https://open.oceanengine.com/labels/7/docs/1696710760866831\">【附录-返回码】</a></p><ul data-id=\"u738a58b-7X2Z18Af\"><li data-id=\"ld70c578-2xEPC7HB\"><span style=\"color: #f5222d;\">注意：</span>本接口为批量查询接口，如存在部分成功/部分失败的情况，此时code返回为0，但会在返回列表的compensate_status里披露失败原因</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">message</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-Vw5F4Ass\">返回信息,详见 <a href=\"https://open.oceanengine.com/labels/7/docs/1696710760866831\">【附录-返回码】</a></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">data</p></section></section><section class=\"col col_param_type\"><p>json</p></section><section class=\"col description\"><p data-id=\"p838747a-ThqJYqqq\">json返回值</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"arrow\" style=\"left: 20px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">compensate_status_info_list</p></section></section><section class=\"col col_param_type\"><p>object[]</p></section><section class=\"col description\"><p data-id=\"p838747a-j2VTkzUU\">项目成本保障信息列表</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">project_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-EkpHHSXA\">项目id</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">compensate_status</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-o9BANnii\">项目成本保障状态 可选值: </p><ul data-id=\"u738a58b-hBZISaNI\"><li data-id=\"ld70c578-2dFa6BIe\"><code>CONFIRMING</code> 成本保障确认中</li><li data-id=\"ld70c578-N8pXEb2H\"><code>ENDED</code> 成本保障已结束</li><li data-id=\"ld70c578-A0TppmI3\"><code>INVALID</code> 成本保障已失效</li><li data-id=\"ld70c578-VDTZd7Gi\"><code>IN_EFFECT</code> 成本保障生效中</li><li data-id=\"ld70c578-piWAV76T\"><code>PAID</code> 成本保障已到账</li><li data-id=\"ld70c578-m9llj1r7\"><code>DEFAULT</code> 无成本保障状态，表示该项目不支持成本保障，此时在巨量营销升级版平台页面上也不会展示相关标志</li></ul><p data-id=\"p838747a-MHCz52Sg\"><br/></p><p data-id=\"p838747a-vzh9uIxk\"><span style=\"color: #f5222d;\">其他异常情况返回：</span></p><ul data-id=\"u738a58b-5lVHzRuX\"><li data-id=\"ld70c578-DgtKijcZ\"><code>FAILED</code> 成本保障查询超时，请重试</li><li data-id=\"ld70c578-RjsDiqn6\"><code>UNSUPPORTED</code> 查询失败，传入参数project信息有误，多为project_id在账户下不存在</li></ul></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">compensate_invalid_reasons</p></section></section><section class=\"col col_param_type\"><p>string[]</p></section><section class=\"col description\"><p data-id=\"p838747a-5kyJFA3O\">成本保障失效原因，仅当compensate_status = <code>INVALID</code> 时&amp;&amp;<span style=\"color: #f5222d;\">仅在以下情况会返回</span>。原因可能有多个，因此可能会返回多个枚举</p><ul data-id=\"u738a58b-myaYxwaf\"><li data-id=\"ld70c578-6F4ZwITi\"><code>AUD_CHANGES</code>单日修改定向超过2次,</li><li data-id=\"ld70c578-SCDBDmS0\"><code>BID_CHANGES</code>单日修改出价超过2次</li><li data-id=\"ld70c578-fzdI07Jy\"><code>ROI_CHANGES</code>单日修改roi_goal超过2次</li><li data-id=\"ld70c578-SNmn3GRl\"><code>ANTI_SPAM</code>命中反作弊</li><li data-id=\"ld70c578-kETmQG6f\"><code>BID_TYPE_EXPIRED</code>选择的出价产品暂不支持成本保障</li><li data-id=\"ld70c578-OV4C68gh\"><code>MANUAL_JUDGE_SPAM</code>有异常的作弊行为</li><li data-id=\"ld70c578-fnyIyh1R\"><code>AUD_BID_CHANGES</code>单日修改定向/出价超过2次</li><li data-id=\"ld70c578-60DfGLoV\"><code>AUD_ROI_CHANGES</code>单日修改定向/ROI目标超过2次</li><li data-id=\"ld70c578-aUJF8BxV\"><code> TRANSFER_ACCOUNT</code>申请转户</li><li data-id=\"ld70c578-SOgjOKkS\"><code>STOP_REJECT_DELETE</code>投放期间出现暂停、拒审或删除操作（仅针对简单投项目进行返回）</li></ul></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">compensate_end_reasons</p></section></section><section class=\"col col_param_type\"><p>string[]</p></section><section class=\"col description\"><p data-id=\"p838747a-juvVlQa5\">成本保障结束原因，仅当compensate_status = <code>ENDED</code> 时&amp;&amp;<span style=\"color: #f5222d;\">仅在以下情况会返回</span></p><p data-id=\"p838747a-8zQ1IDlA\">原因可能有多个，因此可能会返回多个枚举</p><ul data-id=\"u738a58b-ymd4eawR\"><li data-id=\"ld70c578-AVtkUyQn\"><code>UN_OBERCOST</code> 超成本比例没有达到1.2倍</li><li data-id=\"ld70c578-ANVZw7iI\"><code>ROI_REAL_EXPECTED</code>实际roi大于目标roi的80%</li><li data-id=\"ld70c578-ZCpULbfM\"><code>CONVERT_UNDER_THRESHOLD</code>转化数没有达到门槛</li><li data-id=\"ld70c578-mnsQZbOG\"><code>CURRENCY_PRECISION</code>赔付金额小于0.01元</li><li data-id=\"ld70c578-5OOlhMij\"><code>CONVERT_ZERO_NO_COST</code> 转化数为0或无消耗（仅针对进行简单投项目进行返回）</li></ul></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">compensate_amount</p></section></section><section class=\"col col_param_type\"><p>double</p></section><section class=\"col description\"><p data-id=\"p838747a-vPWNZQ4K\">赔付金额（元），最多2位小数</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">compensate_url</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-SsR7oA8M\">赔付规则链接，主要为飞书文档地址，如：<a href=\"https://bytedance.larkoffice.com/docx/UWifd88wfou3bmxHAq7ciOgPn9e\" target=\"_blank\">https://bytedance.larkoffice.com/docx/UWifd88wfou3bmxHAq7ciOgPn9e</a></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">request_id</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-vUwMfP8G\">请求日志id</p></section></section></section><h1 data-id=\"h346b9f0-SPRN5naO\" id=\"h346b9f0-SPRN5naO\">应答示例</h1><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22disabled%22%3Atrue%2C%22wrap%22%3Afalse%2C%22language%22%3A%22json%22%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22text%22%3A%22HTTPS%2F1.1%20200%20OK%5Cn%7B%5Cn%20%20%20%20%5C%22message%5C%22%3A%20%5C%22OK%5C%22%2C%5Cn%20%20%20%20%5C%22code%5C%22%3A%200%2C%5Cn%20%20%20%20%5C%22data%5C%22%3A%20%7B%7D%5Cn%7D%22%2C%22id%22%3A%2224Bej%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content json\"></div></div></div></div><div class=\"qz-error-code_v2\" data-type=\"qzerrorcode\" data-value=\"data:%7B%22interfaceId%22%3A1801099418567744%2C%22id%22%3A%22GI5Ho%22%2C%22type%22%3A%22block%22%2C%22html%22%3A%22%3Ch1%20id%3D%5C%22h346b9f0-Pi6L6UaZ%5C%22%20data-id%3D%5C%22h346b9f0-Pi6L6UaZ%5C%22%3E%E4%B8%9A%E5%8A%A1%E9%94%99%E8%AF%AF%E7%A0%81%3C%2Fh1%3E%3Cp%20data-id%3D%5C%22p838747a-gdfDG8Y1%5C%22%3E%E4%BB%85%E6%8A%AB%E9%9C%B2%E5%BD%93%E5%89%8D%E6%8E%A5%E5%8F%A3%E9%AB%98%E9%A2%91%E7%9A%84%E5%8F%82%E6%95%B0%E6%A0%A1%E9%AA%8C%E6%8A%A5%E9%94%99%EF%BC%8C%E6%9B%B4%E5%A4%9A%E5%B8%B8%E8%A7%81%E6%8A%A5%E9%94%99%E8%AF%A6%E8%A7%81%E2%80%8B%3Ca%20target%3D%5C%22_blank%5C%22%20href%3D%5C%22https%3A%2F%2Fopen.oceanengine.com%2Flabels%2F34%2Fdocs%2F1696710760866831%5C%22%3E%E2%80%8B%E3%80%8C%E8%BF%94%E5%9B%9E%E7%A0%81%E3%80%8D%E2%80%8B%3C%2Fa%3E%E2%80%8B%E6%96%87%E6%A1%A3%3C%2Fp%3E%22%7D\"> </div></div>",
