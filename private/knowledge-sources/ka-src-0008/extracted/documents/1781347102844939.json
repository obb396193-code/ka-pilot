8C%E6%8E%92%E5%BA%8F%5Cn%20%20card_info.sort(function%20(a%2C%20b)%20%7B%5Cn%20%20%20%20return%20a.audit_pass_rate%20-%20b.audit_pass_rate%3B%5Cn%20%20%7D)%3B%5Cn%5Cn%20%20%2F%2F%20%E6%88%AA%E6%96%AD%E6%95%B0%E7%BB%84%EF%BC%8C%E5%8F%AA%E4%BF%9D%E7%95%99%E5%89%8D50%E4%B8%AA%E6%9C%80%E5%B0%8F%E5%80%BC%EF%BC%8C%E5%8D%B3%E7%AD%9B%E9%80%89%E8%BF%87%E5%AE%A1%E7%8E%87%E6%9C%80%E4%BD%8E%E7%9A%84TOP50%E4%B8%AA%E8%B4%A6%E6%88%B7%5Cn%20%20return%20card_info.slice(0%2C%2050)%3B%5Cn%7D%5Cn%5Cn%2F%2F%E8%8E%B7%E5%8F%96T-1%E7%9A%84%E6%97%A5%E6%9C%9F%5Cnfunction%20getPreviousDate()%20%7B%5Cn%20%20return%20Utils.dayjs().subtract(1%2C%20'day').format('YYYY-MM-DD')%3B%5Cn%7D%5Cn%2F%2F%20%E4%B8%8D%E8%A6%81%E4%BF%AE%E6%94%B9%EF%BC%81%EF%BC%81%EF%BC%81%5Cnfunction%20checkConfig()%20%7B%5Cn%20%20if%20(CONFIG.webHookURL%20%3D%3D%3D%20'')%20%7B%5Cn%20%20%20%20throw%20Error(%5Cn%20%20%20%20%20%20'%E8%AF%B7%E5%9C%A8%E9%85%8D%E7%BD%AE%E4%B8%AD%E5%A1%AB%E5%85%A5%E9%A3%9E%E4%B9%A6%E6%9C%BA%E5%99%A8%E4%BA%BAwebhook_url%E3%80%82%E5%A6%82%E4%BD%95%E5%88%9B%E5%BB%BA%E8%AF%B7%E5%8F%82%E8%80%83https%3A%2F%2Fopen.feishu.cn%2Fdocument%2Fclient-docs%2Fbot-v3%2Fadd-custom-bot'%5Cn%20%20%20%20)%3B%5Cn%20%20%7D%5Cn%7D%5Cn%22%2C%22id%22%3A%22DO3r6%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content javascript\"></div></div></div></div><h1 data-id=\"h346b9f0-qM35WeFn\" id=\"h346b9f0-hg3KeaTg\">配套飞书卡片模板</h1><p data-id=\"pa028eb2-ZjjJLRUR\" style=\"text-align: center;\"><img src=\"https://p26-business-sign.byteadimg.com/tos-cn-i-yvqzo4lhg5/3f9159e5efd34abfaed9d6ca7bb642e2~noop.image?rk3s=d3394059&amp;x-expires=2017033840&amp;x-signature=AVsLBUBUBqKt6sEpCPR9N3tL8ws%3D\" data-auto=\"true\" style=\"width: 2000px; visibility: visible; height: auto;\" data-type=\"inline\"></p><p data-id=\"p838747a-gPEzfgFi\">默认已提供一个默认模板，可直接使用</p><p data-id=\"p838747a-6CV5tV6z\">若希望修改模板，可以下载</p><p data-id=\"p838747a-igEYXDW5\"><a href=\"https://lf3-static.bytednsdoc.com/obj/eden-cn/lm_ulwv/ljhwZthlaukjlkulzlp/账户过审率监控.json\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">过审率低卡片模板</a></p><p data-id=\"p838747a-Y9kbh26W\">后，登录<a target=\"_blank\" href=\"https://open.feishu.cn/tool/cardbuilder?from=howtoguide\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">飞书消息卡片搭建器</a>，导入修改模板后，可以在自己的代码中应用</p><h1 id=\"h346b9f0-400ZcDJl\" data-id=\"h346b9f0-nMYIVKJ3\">扩展</h1><h2 id=\"h490b8bf-JG7MYHB4\" data-id=\"h490b8bf-hfQoHdMA\">1 汇总多个adv，做客户级别的判断</h2><p data-id=\"p838747a-LfQKuI3o\"><em>代码修改思路↓</em></p><p data-id=\"p838747a-dkm1CRoA\">可以参考账户广告时/日/周报部分的视线</p><h2 id=\"h490b8bf-GiJ9bNIo\" data-id=\"h490b8bf-ydkQKsjO\">2 账户数据不理想后，对广告进行停投/拉空时段操作</h2><p data-id=\"p838747a-AE40QSj2\">暂时不支持广告数据修改，后续扩展支持，可通过【建议与反馈】向我们提出诉求</p></div>",
