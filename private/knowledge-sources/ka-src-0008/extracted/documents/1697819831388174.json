eight: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-Jc2ga3Ie\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t06eb8d1-KgPz9QZv\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-dCHsNpiR\">授权access-token，获取方法见接口文档<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"_blank\">【获取Access-Token】</a></p></td></tr></tbody></table></div><h5 data-id=\"h7723ecd-F7502pHV\" id=\"link-3\">请求示例</h5><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5Cnimport%20requests%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2F2%2Fuser%2Finfo%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22ad.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20access_token%20%3D%20ACCESS_TOKEN%5Cn%20%20%20%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22access_token%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%20%25%20(access_token)%5Cn%20%20%20%20print(get(my_args))%5Cn%5Cn%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22import%20com.fasterxml.jackson.core.JsonProcessingException%3B%5Cnimport%20com.fasterxml.jackson.databind.ObjectMapper%3B%5Cnimport%20okhttp3.*%3B%5Cnimport%20org.apache.http.client.utils.URIBuilder%3B%5Cn%5Cnimport%20java.io.IOException%3B%5Cnimport%20java.net.URI%3B%5Cnimport%20java.net.URISyntaxException%3B%5Cnimport%20java.net.URL%3B%5Cnimport%20java.util.Map%3B%5Cn%5Cnpublic%20class%20Demo%20%7B%5Cn%20%20%20%20private%20static%20final%20String%20ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20String%20PATH%20%3D%20%5C%22%2Fopen_api%2F2%2Fuser%2Finfo%2F%5C%22%3B%5Cn%5Cn%20%20%20%20%2F**%5Cn%20%20%20%20%20*%20Build%20request%20URL%5Cn%20%20%20%20%20*%5Cn%20%20%20%20%20*%20%40param%20path%20Request%20path%5Cn%20%20%20%20%20*%20%40return%20Request%20URL%5Cn%20%20%20%20%20*%2F%5Cn%20%20%20