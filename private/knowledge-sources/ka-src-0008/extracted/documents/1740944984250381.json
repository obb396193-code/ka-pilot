.oceanengine.com/tools/visual_debug.html?docId=1740944984250381\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-eVJJDh31\" id=\"h346b9f0-eVJJDh31\">请求方法</h1><p data-id=\"p838747a-pn6V5Upv\">GET</p><h1 data-id=\"h346b9f0-WAQo74Xg\" id=\"h346b9f0-WAQo74Xg\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-9Mv3ze5S\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</p></section></section></section><h1 data-id=\"h346b9f0-JpKBNVVK\" id=\"h346b9f0-JpKBNVVK\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 244px;\" width=\"244\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-bdYwHclq\">客户id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">landing_type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-Z20dC6t8\">营销目的，允许值：APP 应用 可选值: </p><ul data-id=\"u738a58b-5J11n6e3\"><li data-id=\"ld70c578-WAEjAP4A\"><code>APP</code> 应用</li><li data-id=\"ld70c578-IDTC9VI1\"><code>DPA</code> 商品</li><li data-id=\"ld70c578-pp1AeIMk\"><code>LINK</code> 销售线索</li><li data-id=\"ld70c578-2NqLJRgl\"><code>MICRO_GAME</code> 小程序</li><li data-id=\"ld70c578-0kUmaMJY\"><code>NATIVE_ACTION</code> 内容营销</li><li data-id=\"ld70c578-XL8BfJ2h\"><code>QUICK_APP</code> 快应用</li><li data-id=\"ld70c578-2hjg9H0t\"><code>SHOP</code> 电商</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">ad_type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-U2LVaEAN\">营销类型，允许值：ALL 可选值: </p><ul data-id=\"u738a58b-cLjH8Eb7\"><li data-id=\"ld70c578-QkBBZKt2\"><code>ALL</code> 信息流</li><li data-id=\"ld70c578-kOdfqXdk\"><code>SEARCH</code> 搜索</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">asset_type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-u7Vfm0Uu\">资产类型，允许值：APP 应用 可选值: </p><ul data-id=\"u738a58b-6IbKRR5g\"><li data-id=\"ld70c578-ZJ8rOhbA\"><code>APP</code>应用</li><li data-id=\"ld70c578-5pT6PpE6\"><code>AWEME</code>抖音主页</li><li data-id=\"ld70c578-BewCBbNM\"><code>ENTERPRISE</code><span style=\"background-color: #f8f8f9;\">企业号落地页</span> </li><li data-id=\"ld70c578-Z55EcmXO\"><code>MICRO_APP</code>字节小程序</li><li data-id=\"ld70c578-IdqAxEhS\"><code>ORANGE</code>橙子落地页</li><li data-id=\"ld70c578-uCnfUaBv\"><code>QUICK_APP</code>快应用</li><li data-id=\"ld70c578-NA5Oj6hN\"><code>THIRDPARTY</code>自研落地页</li><li data-id=\"ld70c578-znBNQz7s\"><code>WECHAT_APP</code>微信小程序</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">multi_asset_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-RlT2Kvql\">多投放载体，允许值：<code>ORANGE_AND_AWEME</code> 建站落地页和抖音主页</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">asset_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-DwZdrMjz\">事件管理资产id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">package_name</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-shUopdLS\">应用包名称</p><ul data-id=\"u738a58b-n7DnA4df\"><li data-id=\"ld70c578-sCcwu7ky\">当asset_type为应用<code>APP</code>时，若asset_id不为空，生效asset_id；</li><li data-id=\"ld70c578-cGzfM6jR\">若asset_id为空且package_name不为空时，生效package_name</li></ul><p data-id=\"p838747a-500QYXLd\"><br/></p><p data-id=\"p838747a-osxejybx\"><span style=\"color: #f5222d;\">注意：当前不支持<u>被共享的</u>应用资产传入包名查询</span></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">app_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-svlRpZZ1\">应用类型，当asset_type为应用<code>APP</code>时必填\n可选值：<code>ANDROID </code>、<code>IOS</code>可选值: </p><ul data-id=\"u738a58b-U5Zg7Ac5\"><li data-id=\"ld70c578-tgcIIDBB\"><code>ANDROID</code> </li><li data-id=\"ld70c578-yFXYyDdE\"><code>DEFAULT</code> </li><li data-id=\"ld70c578-2FvxFoUj\"><code>IOS</code></li><li data-id=\"ld70c578-7Z3llUYI\"><code>HARMONY</code>鸿蒙 <span data-card-editable=\"false\" data-card-type=\"inline\" data-card-value=\"data:%7B%22tagType%22%3A%22add%22%2C%22tagValue%22%3A%22%E6%96%B0%E5%A2%9E%22%2C%22isCustom%22%3Afalse%2C%22id%22%3A%229qptU%22%2C%22type%22%3A%22inline%22%7D\" data-ready-card=\"tag\"></span></li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">app_promotion_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-0Nv1YbTA\">子目标，可选值: </p><ul data-id=\"u738a58b-qX8aHVFc\"><li data-id=\"ld70c578-7vmiHCT5\"><code>DOWNLOAD</code> 应用下载</li><li data-id=\"ld70c578-REvI8GI8\"><code>LAUNCH</code> 应用调起</li><li data-id=\"ld70c578-2RiZWprO\"><code>RESERVE</code> 预约下载</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">marketing_goal</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-DcHYjn92\">营销场景， 可选值: </p><ul data-id=\"u738a58b-8saMa5PK\"><li data-id=\"ld70c578-JjDQ1AJS\"><code>LIVE</code> </li><li data-id=\"ld70c578-w8ivA5SI\"><code>VIDEO_AND_IMAGE</code> </li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">quick_app_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-UWJrkVj3\">快应用资产id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">delivery_mode</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-BSwgX4fD\">投放模式，不传默认为<code>MANUAL</code> 手动投放模式，允许值： </p><ul data-id=\"u738a58b-KG1k17fC\"><li data-id=\"ld70c578-DBmrN3oy\"><code>MANUAL</code> 手动投放模式</li><li data-id=\"ld70c578-IhPnwCJV\"><code>PROCEDURAL</code> 自动投放模式</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">mini_program_id</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-SxzVIxq7\"><span style=\"background-color: #f8f8f9;\">字节小程序资产id，当asset_type=</span><code>MICRO_APP</code><span style=\"background-color: #f8f8f9;\">时需传入</span></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">dpa_adtype</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-DQzLWkU1\"> <span style=\"background-color: #f8f8f9;\">dpa营销类型，</span>可选值: </p><ul data-id=\"u738a58b-i54AFUVW\"><li data-id=\"ld70c578-eI3o3Q8M\"><code>DPA_APP</code> 应用下载</li><li data-id=\"ld70c578-RNFQUu8l\"><code>DPA_LINK</code> 落地页</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">micro_promotion_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-6u8HwWJE\"> <span style=\"background-color: #f8f8f9;\">小程序类型，landing_type = </span><code>MICRO_GAME</code><span style=\"background-color: #f8f8f9;\"> 时有效且必填</span></p><p data-id=\"p838747a-OyTzzqT7\">可选值: </p><ul data-id=\"u738a58b-00677M8K\"><li data-id=\"ld70c578-j4GAKc4t\"><code>BYTE_APP</code>字<span style=\"background-color: #f8f8f9;\">节小程序</span> </li><li data-id=\"ld70c578-AOy