  "abstract": "{\"business_domain\":[\"巨量千川-数据报表\"],\"business_line\":[\"巨量千川\"],\"capability_summary\":\"获取千川全域投放直播间维度的数据，可按不同时间维度查询，并支持排序、分页等操作，需要先通过【获取Access token】接口获取授权access_token。\",\"id\":\"qianchuan.report.get\",\"interface_path\":\"/open_api/v1.0/qianchuan/report/uni_promotion/dimension_data/room/get/\",\"method\":\"GET\",\"official_url\":\"1786235355858947\",\"related_docs\":[{\"id\":\"open_api.access_token.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"请求此接口需要先获取授权access_token\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"}],\"risk_level\":\"low\",\"schema_url\":\"1786235355858947\",\"supplemental_knowledge\":[],\"title\":\"获取全域投放直播间维度数据\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\">\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201785708383584260%2C%20%22docLibId%22%3A%201748264006369288%7D\">\n \n</div>\n<h1 data-id=\"h346b9f0-JmLc8D1a\" id=\"h346b9f0-JmLc8D1a\">请求地址</h1><p data-id=\"p838747a-7dLTBLMQ\"><a href=\"https://api.oceanengine.com/open_api/v1.0/qianchuan/report/uni_promotion/dimension_data/room/get/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://api.oceanengine.com/open_api/v1.0/qianchuan/report/uni_promotion/dimension_data/room/get/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1786235355858947\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/12/docs/1777555692984388\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/12/docs/1839622960207943\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-FU8PYmBc\" id=\"h346b9f0-FU8PYmBc\">请求方法</h1><p data-id=\"p838747a-h4enoL4D\">GET</p><h1 data-id=\"h346b9f0-UA623nVL\" id=\"h346b9f0-UA623nVL\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-ZgA4C42O\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Content-Type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-T627i1ET\">请求消息类型<br/>允许值: <code>application/json</code></p></section></section></section><h1 data-id=\"h346b9f0-Xol3Vc3D\" id=\"h346b9f0-Xol3Vc3D\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-7dArQJ0q\">千川投放账户id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">room_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-95OCMJGl\">直播间id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">start_time</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-7APwwYqK\">开始时间，格式 <code>2021-04-05 00:00:00</code>，开始时间不得早于<code>今日-180</code>天</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">end_time</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-zcwKKTsF\">结束时间，格式 <code>2021-04-05 23:59:59</code>，\n若传dimension为<code>TIME_GRANULARITY_HOURLY</code> 小时纬度，则时间跨度不能超过<code>7</code>天，其余情况时间跨度不能超过<code>180</code>天</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">dimension</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-zWMurtSD\">数据维度 ，如果不传，返回查询日期内的汇总数据\n</p><p data-id=\"p838747a-P62cLnSZ\">允许值:\n</p><ul data-id=\"u738a58b-VJhY5Fep\"><li data-id=\"ld70c578-fnpIbAor\"><code>TIME_GRANULARITY_DAILY</code> (按天维度),会返回每天的数据\n</li><li data-id=\"ld70c578-LCcnd3IZ\"><code>TIME_GRANULARITY_HOURLY</code> (按小时维度)，会返回每小时维度的数据</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">metrics</p></section></section><section class=\"col col_param_type\"><p>string[]</p></section><section class=\"col description\"><p data-id=\"p838747a-HHXlK7NR\">需要查询的消耗指标，见返回参数，默认返回stat_cost</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">order_field</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-6zQ9dYE5\">排序字段，允许值参考数据指标，见返回字段，默认不传为<code>stat_cost</code>，排序字段需在metrics中</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">order_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-fLKkX8Y9\">排序方式，允许值：\n</p><ul data-id=\"u738a58b-IPHjUQAC\"><li data-id=\"ld70c578-CZOHG9KF\"><code>ASC</code> 升序（默认）</li><li data-id=\"ld70c578-xyIgCbml\"><code>DESC</code> 降序</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">page</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-jKYRGoDT\">页码  默认值: <code>1</code></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">page_size</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-UNZnt5st\">页面大小  默认值: <code>10</code></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">filtering</p></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\">过滤器</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">smart_bid_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">投放方式 可选值: <br/><ul data-id=\"u738a58b-eLbKA0Ie\"><li data-id=\"ld70c578-T84gr3lN\"><code>SMART_BID_CONSERVATIVE</code> 放量投放</li><li data-id=\"ld70c578-89N4flTs\"><code>SMART_BID_CUSTOM</code> 控成本投放（默认）</li></ul></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">order_platform</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-mUeYChTp\">下单平台，允许值：</p><ul data-id=\"u738a58b-82FDKSmB\"><li data-id=\"ld70c578-M8CMnpsY\">ALL：全部</li><li data-id=\"ld70c578-se7gaM9H\">QIANCHUAN： 千川pc（默认）</li><li data-id=\"ld70c578-XtbnzNJy\">ECP_AWEME：小店随心推</li></ul></section></section></section><h1 data-id=\"h346b9f0-jkY3Ee8p\" id=\"h346b9f0-jkY3Ee8p\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2Fv1.0%2Fqianchuan%2Fqianchuan%2Freport%2Funi_promotion%2Fdimension_data%2Froom%2Fget%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20post(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20POST%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20url%20%3D%20build_url(PATH)%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%20%20%20%20%5C%22Content-Type%5C%22%3A%20%5C%22application%2Fjson%5C%22%2C%5Cn%20