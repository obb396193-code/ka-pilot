dth: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-LRnX7L6M\">类型</p></td><td class=\"table-last-row\" data-id=\"tfafd194-9Lsyp9QC\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-9jXrvdEQ\">描述</p></td></tr><tr data-id=\"t28b8a14-EvHMUOYf\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-WTCMIyTn\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-VHBvtW5u\">advertiser_id<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">必填</span></span></p></td><td data-id=\"t8b8e80e-Nx0OJpXB\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-fyQ9FEUh\">number</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t6079300-4o8yh4oj\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-b9YEsYTO\">客户ID</p></td></tr><tr data-id=\"t28b8a14-9qPjwMrb\" style=\"height: 100%; width: 100%;\"><td class=\"table-last-column\" data-id=\"t114fa75-9CzGlTMq\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-Ioum7889\">campaign_id</p></td><td class=\"table-last-column\" data-id=\"t114fa75-Dd2zIE1L\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-X9l4yDkS\">number</p></td><td class=\"table-last-column table-last-row\" colspan=\"1\" data-id=\"tc5b1a8b-kXySduMC\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-EAsMbXRj\">计划组id，若传入，则拉取的是组维度的RTA策略</p></td></tr></tbody></table></div><h1 data-id=\"h346b9f0-D7F80Kq6\" id=\"link-4\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ftools%2Frta%2Fget_info%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22ad.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%20%25%20(advertiser_id)%5Cn%20%20%20%20print(get(my_args))%5Cn%20%20%20%20%5Cn%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22import%20com.fasterxml.jackson.core.JsonProcessingException%3B%5Cnimport%20com.fasterxml.jackson.databind.ObjectMapper%3B%5Cnimport%20okhttp3.*%3B%5Cnimport%20org.apache.http.client.utils.URIBuilder%3B%5Cn%5Cnimport%20java.io.IOException%3B%5Cnimport%20java.net.URI%3B%5Cnimport%20java.net.URISyntaxException%3B%5Cnimport%20java.net.URL%3B%5Cnimport%20java.util.List%3B%5Cnimport%20java.util.Map%3B%5Cnimport%20java.util.stream.Collectors%3B%5Cn%5Cnpublic%20class%20Demo%20%7B%5Cn%20%20%20%20private%20static%20final%20String%20ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20String%20PATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ftools%2Frta%2Fget_info%2F%5C%22%3B%5Cn%20%20%20%20private%20