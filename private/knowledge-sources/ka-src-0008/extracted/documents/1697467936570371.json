px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-ffj8TiHz\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t6079300-mNeBNd54\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-4pjHPTuv\">授权access-token，获取方法见接口文档<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"_blank\">【获取Access-Token】</a></p></td></tr></tbody></table></div><h1 data-id=\"h346b9f0-dhr5A3BK\" id=\"link-3\">请求参数</h1><div class=\"table-container qz-card-type-block\"><table class=\"data-table data-table-row-header\" data-custom=\"false\" data-id=\"t1e39d7f-8XgDb0SA\" data-transient-attributes=\"class\" data-width=\"100%\" style=\"width: 100%; height: 100%; outline: none; border-collapse: collapse; max-width: 100%;\"><colgroup data-id=\"c7104f7d-H2bTFfio\"><col data-id=\"c8929a95-nCPx1Wbw\" span=\"1\" width=\"33%\"/><col data-id=\"c8929a95-mJmNtXW9\" span=\"1\" width=\"33%\"/><col data-id=\"c8929a95-hTcQKWBK\" span=\"1\" width=\"33%\"/></colgroup><tbody data-id=\"t6d5e859-Mxhm4GyX\"><tr data-id=\"t28b8a14-4Y1EjDzC\" style=\"height: 100%; width: 100%;\"><td data-id=\"t54b56e0-NQKazyPW\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-mdkfWHPB\">字段</p></td><td data-id=\"t54b56e0-KSbpToaG\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-B5vKkGfx\">类型</p></td><td class=\"table-last-row\" data-id=\"tfafd194-lbJXiRxT\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-bdFKZUNb\">描述</p></td></tr><tr data-id=\"t28b8a14-Crjeo5yx\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-rjV48XO6\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-IuguABGm\">advertiser_ids<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">必填</span></span></p></td><td data-id=\"t8b8e80e-h18qJPn4\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-RrlIt9jm\">number[]</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t6079300-J8nvsHxz\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-bwh56Wi2\">代理商ids</p></td></tr><tr data-id=\"t28b8a14-z4Di0FLf\" style=\"height: 100%; width: 100%;\"><td class=\"table-last-column\" data-id=\"t114fa75-VFiKh3v3\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-WzZTC6Ld\">fields</p></td><td class=\"table-last-column\" data-id=\"t114fa75-xR7aQ0yW\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-TfZXuihx\">string[]</p></td><td class=\"table-last-column table-last-row\" colspan=\"1\" data-id=\"tc5b1a8b-J4J0a4wU\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-FTtX9gg1\">查询字段集合, 如果指定, 则返回结果数组中, 每个元素是包含所查询字段的字典，默认全部指定.允许值: <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"agent_id\"</code>, <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"agent_name\"</code>, <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"customer_id\"</code>, <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"customer_name\"</code>,<code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"company_id\"</code>, <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"company_name\"</code>, <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"create_time\"</code>, <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">\"role\"</code></p></td></tr></tbody></table></div><h1 data-id=\"h346b9f0-kO3Hn7aK\" id=\"link-4\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22def%20get_agent_info()%3A%5Cn%5Cn%20%20%20%20%20%20%20%20import%20requests%5Cn%5Cn%20%20%20%20%20%20%20%20open_api_url_prefix%20%3D%20%5C%22https%3A%2F%2Fad.oceanengine.com%2Fopen_api%2F%5C%22%5Cn%5Cn%20%20%20%20%20%20%20%20uri%20%3D%20%5C%222%2Fagent%2Finfo%2F%5C%22%5Cn%5Cn%20%20%20%20%20%20%20%20url%20%3D%20open_api_url_prefix%20%2B%20uri%5Cn%5Cn%20%20%20%20%20%20%20%20params%20%3D%20%7B%5Cn%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%5C%22advertiser_ids%5C%22%3A%20%5Bxxx%2Cxxx%5D%2C%5Cn%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%5C%22fields%5C%22%3A%20%5B%5C%22xxx%5C%22%2C%5C%22xxxx%5C%22%5D%5Cn%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%20%20%20%20headers%20%3D%20%7B%5C%22Access-Token%5C%22%3A%20%5C%22xxx%5C%22%7D%5Cn%5Cn%20%20%20%20%20%20%20%20rsp%20%3D%20requests.get(url%2C%20json%3Dparams%2C%20headers%3Dheaders)%5Cn%5Cn%20%20%20%20%20%20%20%20rsp_data%20%3D%20rsp.json()%5Cn%5Cn%20%20%20%20%20%20%20%20return%20rsp_data%5Cn%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22public%20static%20JSONObject%20sel