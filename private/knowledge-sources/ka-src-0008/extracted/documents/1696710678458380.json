ngine.com/labels/7/docs/1696710760171535?origin=left_nav\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">附录-地域层级</a>】</p></td></tr></tbody></table></div><h5 data-id=\"h7723ecd-0gX1ME3J\" id=\"link-4\">请求示例</h5><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22def%20demo()%3A%5Cn%20%20%20%20import%20requests%5Cn%20%20%20%20uri%20%3D%20%5C%22https%3A%2F%2Fad.oceanengine.com%2Fopen_api%2F2%2Ftools%2Fregion%2Fget%2F%5C%22%5Cn%20%20%20%20params%3D%7B%5Cn%20%20%20%20%20%20%20%20%5C%22region_level%5C%22%3A%20%5C%22REGION_LEVEL_BUSINESS_DISTRICT%5C%22%5Cn%20%20%20%20%7D%5Cn%20%20%20%20headers%20%3D%20%7B%5C%22Access-Token%5C%22%3A%20%5C%22xxx%5C%22%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20json%3Dparams%2C%20headers%3Dheaders)%5Cn%20%20%20%20rsp%20%3D%20json.loads(rsp.text)%5Cn%20%20%20%20return%20rsp%5Cn%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22public%20JSONObject%20searchRegion()%20%7B%5Cn%20%20%20%20%20%20%20%20String%20access_token%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20%20%20%20%20final%20String%20region_type%20%3D%20%5C%22BUSINESS_DISTRICT%5C%22%3B%5Cn%20%20%20%20%20%20%20%20final%20String%20region_level%20%3D%20%5C%22REGION_LEVEL_BUSINESS_DISTRICT%5C%22%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20%E8%AF%B7%E6%B1%82%E5%9C%B0%E5%9D%80%5Cn%20%20%20%20%20%20%20%20String%20open_api_url_prefix%20%3D%20%5C%22https%3A%2F%2Fad.oceanengine.com%2Fopen_api%2F2%2F%5C%22%3B%5Cn%20%20%20%20%20%20%20%20String%20uri%20%3D%20%5C%22tools%2Fregion%2Fget%2F%5C%22%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20%E8%AF%B7%E6%B1%82%E5%8F%82%E6%95%B0%5Cn%20%20%20%20%20%20%20%20Map%26lt%3Bstring%2Cobject%26gt%3B%20data%20%3D%20new%20HashMap()%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20put(%5C%22region_type%5C%22%2C%20region_type)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20put(%5C%22region_level%5C%22%2C%20region_level)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%7D%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20%E6%9E%84%E9%80%A0%E8%AF%B7%E6%B1%82%5Cn%20%20%20%20%20%20%20%20HttpEntityEnclosingRequestBase%20httpEntity%20%3D%20new%20HttpEntityEnclosingRequestBase()%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%40Override%5Cn%20%20%20%20%20%20%20%20%20%20%20%20public%20String%20getMethod()%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20return%20%5C%22GET%5C%22%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%7D%3B%5Cn%5Cn%20%20%20%20%20%20%20%20httpEntity.setHeader(%5C%22Access-Token%5C%22%2Caccess_token)%3B%5Cn%5Cn%20%20%20%20%20%20%20%20CloseableHttpResponse%20response%20%3D%20null%3B%5Cn%20%20%20%20%20%20%20%20CloseableHttpClient%20client%20%3D%20null%3B%5Cn%5Cn%20%20%20%20%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20client%20%3D%20HttpClientBuilder.create().build()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20httpEntity.setURI(URI.create(open_api_url_prefix%20%2B%20uri))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20httpEntity.setEntity(new%20StringEntity(JSONObject.toJSONString(data)%2C%20ContentType.APPLICATION_JSON))%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%20%20%20%20response%20%3D%20client.execute(httpEntity)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20if%20(response%20!%3D%20null%20%26amp%3Bamp%3B%26amp%3Bamp%3B%20response.getStatusLine().getStatusCode()%20%3D%3D%20200)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20BufferedReader%20bufferedReader%20%20%3D%20new%20BufferedReader(new%20InputStreamReader(response.getEntity().getContent()))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20StringBuffer%20result%20%3D%20new%20StringBuffer()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20String%20line%20%3D%20%5C%22%5C%22%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%2