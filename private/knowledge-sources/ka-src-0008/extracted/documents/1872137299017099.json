  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\" data-listener-added_3fce491a=\"true\"><p data-id=\"p1dr9j7ls-hxw2m71x7c000\">获取关键词调控任务列表</p><div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A1858535493784647%2C%22docLibId%22%3A1743864733602830%2C%22id%22%3A%22yrF5w%22%2C%22type%22%3A%22block%22%7D\"> </div><h1 data-id=\"h4kgw8yp6-830nanydkmg00\" id=\"h4kgw8yp6-830nanydkmg00\">请求地址</h1><p data-id=\"p1dr9j7ls-2vvspey64ky00\">https://api.oceanengine.com/open_api/v3.0/oc_project/tools_keyword/list/<a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1872137299017099\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a></p><h1 data-id=\"h4kgw8yp6-cj86jecg6h400\" id=\"h4kgw8yp6-cj86jecg6h400\">请求方法</h1><p data-id=\"p1dr9j7ls-10t8voh8lnjk0\">GET</p><h1 data-id=\"h4kgw8yp6-cdmydb1yt8o0\" id=\"h4kgw8yp6-cdmydb1yt8o0\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</section></section></section><h1 data-id=\"h4kgw8yp6-h0hgeub15l40\" id=\"h4kgw8yp6-h0hgeub15l40\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">投放账户ID</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">filtering</p></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\">过滤条件（不过滤则返回全部）</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">project_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">项目IDs,list &lt;= 100（待定）</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">schedule_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">定向调控任务ID</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">name</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">定向调控任务名称,长度小于50字符</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">word</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-2sgdbq1kt9w000\">关键词名称（精确搜索）</p><p data-id=\"p1dr9j7ls-1voedcb5ug0000\"><span style=\"color: #8c8c8c;\">不区分蓝海关键词和自定义关键词</span></p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">first_status</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">定向调控任务状态（一级状态），可选值: <br/><ul data-id=\"u1dr9j7ls-bxnttrc16d400\"><li data-id=\"l19a1dmf4-q7hdzh8cxq800\"><code>ADJUSTING</code> 调控中</li><li data-id=\"l19a1dmf4-45vhfsvju4s000\"><code>ALL</code> 不限</li><li data-id=\"l19a1dmf4-5972185zx58000\"><code>ALL_INCLUDE_DELETED</code> 不限(包含任务已删除和已终止)</li><li data-id=\"l19a1dmf4-i2oa0baxn5c00\"><code>DELETED</code> 已删除</li><li data-id=\"l19a1dmf4-50vv66b3ua4000\"><code>FINISH</code> 已完成</li><li data-id=\"l19a1dmf4-4j98sg2t80o000\"><code>TERMINAL</code> 已终止</li><li data-id=\"l19a1dmf4-80nhbo15e9800\"><code>UNADJUSTED</code> 未生效</li></ul> 默认值: <code>ALL</code></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">second_status</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">定向调控任务状态（二级状态） 可选值: <br/><ul data-id=\"u1dr9j7ls-5ksjhmaggdk000\"><li data-id=\"l19a1dmf4-jd0pqnq9z2g00\"><code>ALL_KEYWORD_DELETED</code> 调控关键词均删除</li><li data-id=\"l19a1dmf4-5khap55yhow000\"><code>DISABLE</code> 已暂停</li><li data-id=\"l19a1dmf4-5mg6k5oljp8000\"><code>KEYWORD_ADJUST_AUDITING</code> 调控关键词审核中</li><li data-id=\"l19a1dmf4-1ilfel3itehs00\"><code>KEYWORD_ADJUST_NEW_CREATED_AUDITING</code> 调控关键词审核不通过</li><li data-id=\"l19a1dmf4-43n6gmo3z4y000\"><code>TASK_BID_EXCEEDS_PROJECT_BUDGET</code> 不满足出价或预算规则</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">page_info</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\">分页信息</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">page</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">页码  默认值: <code>1</code></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">page_size</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">页面大小  默认值: <code>10</code></section></section></section><h1 data-id=\"h4kgw8yp6-i5gim6cnjhc00\" id=\"h4kgw8yp6-i5gim6cnjhc00\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Foc_project%2Ftools_keyword%2Flist%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%20%20%20%20project_id%20%3D%20PROJECT_ID%5Cn%20%20%20%20schedule_id%20%3D%20SCHEDULE_ID%5Cn%20%20%20%20name%20%3D%20NAME%5Cn%20%20%20%20word%20%3D%20WORD%5Cn%20%20%20%20first_status%20%3D%20FIRST_STATUS%5Cn%20%20%20%20second_status%20%3D%20SECOND_STATUS%5Cn%20%20%20%20page%20%3D%20PAGE%5Cn%20%20%20%20page_size%20%3D%20PAGE_SIZE%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22filtering%5C%5C%5C%22%3A%20%7B%5C%5C%5C%22project_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22schedule_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22name%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22word%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22first_status%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22second_status%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%2C%20%5C%5C%5C%22page_info%5C%5C%5C%22%3A%20%7B%5C%5C%5C%22page%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%