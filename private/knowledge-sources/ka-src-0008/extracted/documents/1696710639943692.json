l-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-TzIH7hDb\">activity_id <span class=\"qz-tag-view qz-tag-type-must\" data-type=\"tag\" data-value=\"data:%7B%22tagType%22%3A%22must%22%2C%22tagValue%22%3A%22%E5%BF%85%E5%A1%AB%22%2C%22isCustom%22%3Afalse%2C%22id%22%3A%22vDGRK%22%2C%22type%22%3A%22inline%22%7D\" style=\"color:#338aff;background:#ebf3ff;\">必填</span></p></td><td data-id=\"t8b8e80e-tVvV4xiq\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-QHYxw861\">number</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"tb457ed5-Qhm8jm8S\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-SySo9FyS\">青鸟营销活动ID</p></td></tr><tr data-id=\"t28b8a14-kqPYrX6L\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-s8qFzbCM\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-KPbyPecs\">deliver_start</p></td><td data-id=\"t8b8e80e-JUwnjH7K\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-0EkJ1Qu8\">string</p></td><td class=