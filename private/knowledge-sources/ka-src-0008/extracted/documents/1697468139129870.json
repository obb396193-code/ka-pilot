{
  "abstract": "{\"business_domain\":[\"巨量千川-账户管理\",\"巨量营销-账户、客户与资质\"],\"business_line\":[\"巨量千川\",\"巨量营销\"],\"capability_summary\":\"获取投放账户详细信息，需提供客户ID集合，可指定查询字段。配合接口有【获取Access-Token】、【附录-返回码】、【附录-客户角色】、【附录-客户状态】等。\",\"id\":\"qianchuan.advertiser.get\",\"interface_path\":\"/open_api/2/advertiser/info/\",\"method\":\"GET\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1697468139129870\",\"related_docs\":[{\"id\":\"get.access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"请求该接口需要先获取授权access-token\",\"relation\":\"前置接口\",\"title\":\"获取Access-Token\"},{\"id\":\"appendix.return_code\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"reason\":\"接口应答中的返回码和返回信息需要参考该文档\",\"relation\":\"配合接口\",\"title\":\"附录-返回码\"},{\"id\":\"appendix.customer_role\",\"path\":\"https://open.oceanengine.com/labels/12/docs/1697577930691592\",\"reason\":\"接口应答中的角色字段需要参考该文档\",\"relation\":\"配合接口\",\"title\":\"附录-客户角色\"},{\"id\":\"appendix.customer_status\",\"path\":\"https://open.oceanengine.com/labels/12/docs/1697577930691592\",\"reason\":\"接口应答中的状态字段需要参考该文档\",\"relation\":\"配合接口\",\"title\":\"附录-客户状态\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1697468139129870\",\"title\":\"获取千川投放账户全量信息\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><p data-id=\"p838747a-ncSebF4W\">获取投放账户详细信息。</p>\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201772563288828941%2C%20%22docLibId%22%3A%201748264006369288%7D\">\n \n</div>\n<h1 data-id=\"h346b9f0-eH9LC12L\" id=\"link-0\">请求地址</h1><p data-id=\"p838747a-sqhqRwfX\"><a href=\"https://ad.oceanengine.com/open_api/2/advertiser/info/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"_blank\"><span style=\"color: #333333;\">https://ad.oceanengine.com/open_api/2/advertiser/info/</span></a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1697468139129870\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/12/docs/1777555692984388\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/12/docs/1839622960207943\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-hnBQHMe0\" id=\"link-1\">请求方式</h1><p data-id=\"p838747a-ns5jnj5d\"><strong>GET</strong></p><h1 data-id=\"h346b9f0-3ufTyVN0\" id=\"link-2\">请求Header</h1><div class=\"table-container qz-card-type-block\"><table class=\"data-table data-table-row-header\" data-custom=\"false\" data-id=\"t615773a-EfdcKb56\" data-transient-attributes=\"class\" data-width=\"100%\" style=\"width: 100%; outline: none; border-collapse: collapse; max-width: 100%;\"><colgroup data-id=\"c7104f7d-mwDaPLjw\"><co