  "abstract": "{\"id\":\"oauth2.app_access_token.get\",\"title\":\"获取APP Access Token\",\"interface_path\":\"/open_api/oauth2/app_access_token/\",\"method\":\"POST\",\"capability_summary\":\"获取应用级别的token，需要提供开发者申请的应用APP_ID和私钥Secret。\",\"related_docs\":[{\"id\":\"appendix.return_code.get\",\"title\":\"【附录-返回码】\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"relation\":\"配合接口\",\"reason\":\"应答中返回码和返回信息的详细说明参考此文档\"}]}",
