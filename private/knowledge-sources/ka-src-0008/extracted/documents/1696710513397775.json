  "abstract": "{\"capability_summary\":\"获取客户资质信息，资质分为描述，营业执照，开户资质，投放资质。本接口不再维护，建议使用「获取投放资质（新版）」接口。\",\"id\":\"ad.advertiser_qualification.get\",\"interface_path\":\"/open_api/2/advertiser/qualification/select_v2/\",\"method\":\"GET\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1696710513397775\",\"related_docs\":[{\"id\":\"ad.advertiser_qualification.get_new\",\"path\":\"https://open.oceanengine.com/labels/34/docs/1761500990156815\",\"reason\":\"本接口不再维护，建议使用该接口\",\"relation\":\"替代接口\",\"title\":\"获取投放资质（新版）\"},{\"id\":\"ad.get_access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"请求本接口需要先获取授权access-token\",\"relation\":\"前置接口\",\"title\":\"获取Access-Token\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1696710513397775\",\"supplemental_knowledge\":[],\"title\":\"获取投放资质（旧版）\"}",
