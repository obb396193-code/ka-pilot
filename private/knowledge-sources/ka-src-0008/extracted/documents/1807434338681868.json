  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><p data-id=\"p838747a-YQ4Cgi2B\">违规积分明细查询</p><h1 data-id=\"h4kgw8yp6-22wmxlpkm9pc00\" id=\"h4kgw8yp6-22wmxlpkm9pc00\">请求地址</h1><p data-id=\"p838747a-AlHaHJY9\"><a href=\"https://api.oceanengine.com/open_api/v3.0/security/score_violation_event/get/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://api.oceanengine.com/open_api/v3.0/security/score_violation_event/get/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1807434338681868\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-rVncs2MR\" id=\"h346b9f0-rVncs2MR\">请求方法</h1><p data-id=\"p838747a-NkSG1Dan\">GET</p><h1 data-id=\"h346b9f0-EaLDTrcl\" id=\"h346b9f0-EaLDTrcl\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-pxrPon8v\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</p></section></section></section><h1 data-id=\"h346b9f0-BB1mUqIY\" id=\"h346b9f0-BB1mUqIY\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-BOAMC73Q\">客户id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">business_line</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-8SghDvmm\">业务线 ，允许值：</p><ul data-id=\"u738a58b-aOUpLScD\"><li data-id=\"ld70c578-WlpdFv2Y\"><code>AD</code> 营销</li><li data-id=\"ld70c578-eZmNjlEA\"><code>LOCALAD</code> 本地推</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">page</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-h0p3bsSO\"><span style=\"background-color: #f8f8f9;\">页数，默认值：</span><code>1</code><span style=\"background-color: #f8f8f9;\">，page范围为[1,99999]</span></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">page_size</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-uzGkCjdw\"><span style=\"background-color: #f8f8f9;\">页面大小，默认值：</span><code>10</code><span style=\"background-color: #f8f8f9;\">，page_size范围为[1,100]</span></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">filtering</p></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\"><p data-id=\"p838747a-BUX5LzXG\">过滤器</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">status</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-NBRtHdMT\">生效状态，允许值：</p><ul data-id=\"u738a58b-oAbkk5PY\"><li data-id=\"ld70c578-b9lLJg7u\"><code>APPEAL</code> 已申诉（失效）</li><li data-id=\"ld70c578-2hnKnsV7\"><code>FAILAPPEAL</code> 申诉失败</li><li data-id=\"ld70c578-zCquaeSO\"><code>ONAPPEAL</code> 申诉中</li><li data-id=\"ld70c578-nwG1AMS8\"><code>VALID</code> 生效</li><li data-id=\"ld70c578-AiOn8ocg\"><code>TIMEOUT</code> 已超时不可申诉</li><li data-id=\"l19a1dmf4-1sglpp042l3400\"><code>APPEALDISABLED</code> 不支持申诉</li></ul></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">start_time</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-dSpdEiKS\">筛选时间（开始），格式：yyyy-mm-dd HH:mm:ss </p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">end_time</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-tx3uyhDP\">筛选时间（结束），格式：yyyy-mm-dd HH:mm:ss </p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">event_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-pDVpinr1\">积分违规单</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">illegal_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-BBTQsBxK\">违规类型 可选值: </p><ul data-id=\"u738a58b-2M16W6Pk\"><li data-id=\"ld70c578-yanYvJVS\"><code>GENERAL</code> 一般违规（AD）</li><li data-id=\"ld70c578-qosl4ET4\"><code>SERIOUS</code> 严重违规（AD）</li><li data-id=\"ld70c578-FImH3UPE\"><code>CRITICAL</code> 严重违规（本地推）</li><li data-id=\"ld70c578-KbAWE8qS\"><code>MINOR</code> 一般违规（本地推）</li><li data-id=\"l19a1dmf4-122373kix11s0\"><code>BACKLINKSERIOUS</code> 后链路严重违规（AD）</li><li data-id=\"l19a1dmf4-27bueefh0dus00\"><code>BACKLINKGENERAL</code> 后链路一般违规（AD）</li></ul></section></section></section><h1 data-id=\"h346b9f0-raLOmHWO\" id=\"h346b9f0-raLOmHWO\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Fsecurity%2Fscore_violation_event%2Fget%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%20%20%20%20business_line%20%3D%20BUSINESS_LINE%5Cn%20%20%20%20page%20%3D%20PAGE%5Cn%20%20%20%20page_size%20%3D%20PAGE_SIZE%5Cn%20%20%20%20status%20%3D%20STATUS%5Cn%20%20%20%20start_time%20%3D%20START_TIME%5Cn%20%20%20%20end_time%20%3D%20END_TIME%5Cn%20%20%20%20event_id%20%3D%20EVENT_ID%5Cn%20%20%20%20illegal_type%20%3D%20ILLEGAL_TYPE%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22business_line%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22page%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22page_size%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22filtering%5C%5C%5C%22%3A%20%7B%5C%5C%5C%22status%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22start_time%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22end_time%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22event_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22illegal_type%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%7D%5C%22%20%25%20(advertiser_id%2C%20business_line%2C%20page%2C%20page_size%2C%20status%2C%20start_time%2C%