0%20%20.method(%5C%22GET%5C%22%2C%20null)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.addHeader(%5C%22Access-Token%5C%22%2C%20ACCESS_TOKEN)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.build()%3B%5Cn%20%20%20%20%20%20%20%20Response%20response%20%3D%20client.newCall(request).execute()%3B%5Cn%20%20%20%20%20%20%20%20return%20response.body().string()%3B%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20public%20static%20void%20main(String%5B%5D%20args)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20Long%20advertiser_id%20%3D%20ADVERTISER_ID%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20Args%20in%20JSON%20format%5Cn%20%20%20%20%20%20%20%20String%20myArgs%20%3D%20String.format(%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%2Cadvertiser_id)%3B%5Cn%20%20%20%20%20%20%20%20System.out.println(get(myArgs))%3B%5Cn%20%20%20%20%7D%5Cn%7D%5Cn%5Cn%22%7D%2C%7B%22language%22%3A%22php%22%2C%22text%22%3A%22%5Cn%24ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%24PATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ftools%2Frta%2Fget%2F%5C%22%3B%5Cn%5Cn%2F**%5Cn%20*%20Build%20request%20URL%5Cn%20*%20%40param%20%24path%20%3A%20Request%20path%5Cn%20*%20%40return%20string%5Cn%20*%2F%5Cnfunction%20build_url(%24path)%5Cn%7B%5Cn%20%20%20%20return%20%5C%22https%3A%2F%2Fad.oceanengine.com%5C%22%20.%20%24path%3B%5Cn%7D%5Cn%5Cn%2F**%5Cn%20*%20Send%20GET%20request%5Cn%20*%20%40param%20%24json_str%20%3A%20Args%20in%20JSON%20format%5Cn%20*%20%40return%20bool%7Cstring%20%3A%20Response%20in%20JSON%20format%5Cn%20*%2F%5Cnfunction%20get(%24json_str)%5Cn%7B%5Cn%20%20%20%20global%20%24ACCESS_TOKEN%2C%20%24PATH%3B%5Cn%20%20%20%20%24curl%20%3D%20curl_init()%3B%5Cn%5Cn%20%20%20%20%24args%20%3D%20json_decode(%24json_str%2C%20true)%3B%5Cn%5Cn%20%20%20%20%2F*%20Values%20of%20querystring%20is%20also%20in%20JSON%20format%20*%2F%5Cn%20%20%20%20foreach%20(%24args%20as%20%24key%20%3D%3E%20%24value)%20%7B%5Cn%20%20%20%20%20%20%20%20%24args%5B%24key%5D%20%3D%20is_s