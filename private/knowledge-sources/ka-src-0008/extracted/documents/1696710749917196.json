Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%20%25%20(advertiser_id)%5Cn%20%20%20%20print(get(my_args))%5Cn%20%20%20%20%5Cn%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22import%20com.fasterxml.jackson.core.JsonProcessingException%3B%5Cnimport%20com.fasterxml.jackson.databind.ObjectMapper%3B%5Cnimport%20okhttp3.*%3B%5Cnimport%20org.apache.http.client.utils.URIBuilder%3B%5Cn%5Cnimport%20java.io.IOException%3B%5Cnimport%20java.net.URI%3B%5Cnimport%20java.net.URISyntaxException%3B%5Cnimport%20java.net.URL%3B%5Cnimport%20java.util.List%3B%5Cnimport%20java.util.Map%3B%5Cnimport%20java.util.stream.Collectors%3B%5Cn%5Cnpublic%20class%20Demo%20%7B%5Cn%20%20%20%20private%20static%20final%20String%20ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20String%20PATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ftools%2Frta%2Fget%2F%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20ObjectMapper%20mapper%20%3D%20new%20ObjectMapper()%3B%5C