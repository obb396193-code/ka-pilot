2.1 0-40.1-17.9-40.1-40.1V776.7c0-22.1 17.9-40.1 40.1-40.1h227.5c22.1 0 40.1 17.9 40.1 40.1v163.7c-0.1 22.1-18 40-40.2 40z\" fill=\"#ECEFF1\" p-id=\"13154\"></path><path d=\"M539.8 808.6H359v-36h180.8c9.9 0 18 8.1 18 18 0 10-8.1 18-18 18zM359 840.1h306v36H359zM665 943.6H494.8c-9.9 0-18-8.1-18-18s8.1-18 18-18H665v36z\" fill=\"#CFD8DC\" p-id=\"13155\"></path></svg></div><div class=\"QZCard-editor-container\"><p data-id=\"p1dr9j7ls-j1k67ubilg000\">当您订阅的投放账户下，存在智擎版标准项目修改记录时，会为您下发消息通知，通知范围：</p><ol data-id=\"o19a1oojk-586hyqgwn8k00\"><li data-id=\"l19a1dmf4-c0cviy98fh400\">仅限「<span style=\"color: #f5222d;\">巨量营销</span>」账户下的<span style=\"color: #f5222d;\">智擎版标准项目</span></li><li data-id=\"l19a1dmf4-5jaxaig370000\">您在<span style=\"color: #f5222d;\">操作日志中可见的「修改」操作，均会下发消息通知</span>，包括：项目预算（预算类型/金额）、项目出价（深度出价）、投放结束时间、投放时段<strong>等</strong></li><li data-id=\"l19a1dmf4-ejtojd9qqgg00\">注意：本事件<u>不包含项目状态变更</u>，智擎版标准项目状态变更请订阅另外一个事件<a href=\"https://open.oceanengine.com/labels/43/docs/1870870452456523?origin=left_nav\" target=\"_blank\">【智擎版标准项目状态实时推送】</a><span style=\"color: #323335;\">status.stdproject.realtime</span></li></ol></div></div></div><h1 id=\"h4kgw8yp6-46xqwrddjeu00\" data-id=\"h4kgw8yp6-46xqwrddjeu00\">回调地址</h1><p data-id=\"p1dr9j7ls-2d24vc2tassg0\">订阅任务设置回调地址</p><h1 id=\"h4kgw8yp6-3tkdfx368eg00\" data-id=\"h4kgw8yp6-3tkdfx368eg00\">关联API接口</h1><p data-id=\"p1dr9j7ls-3kod92t930e00\">https://api.oceanengine.com/open_api/v3.0/std_project/list/</p><h1 id=\"h4kgw8yp6-kya3i0jp7ow00\" data-id=\"h4kgw8yp6-kya3i0jp7ow00\">请求方式</h1><p data-id=\"p1dr9j7ls-f719hkqrucw00\">POST</p><h1 id=\"h4kgw8yp6-8o0qvrpv4hg00\" data-id=\"h4kgw8yp6-8o0qvrpv4hg00\">请求Header</h1><section class=\"table spi-table\" data-type=\"spitable\" data-tabletype=\"header\"><section class=\"row header\"><section class=\"col\" width=\"250\" style=\"width: 250px;\"><p>字段</p></section><section class=\"col\" width=\"120\" style=\"width: 120px;\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Content-Type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">请求消息类型，允许值：application/json</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">X-Open-Signature</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">签名，用来验证此次请求的合法性，具体算法见<a href=\"https://open.oceanengine.com/docs/1722481732805646\"> 【X-Open-Signature签名校验】</a></section></section></section><h1 id=\"h4kgw8yp6-j4c14zo0xm000\" data-id=\"h4kgw8yp6-j4c14zo0xm000\">请求参数</h1><h2 id=\"h4kgw8yp6-ekl1rof4wmw00\" data-id=\"h4kgw8yp6-ekl1rof4wmw00\">基础信息</h2><section class=\"table spi-table\" data-type=\"spitable\" data-tabletype=\"request\"><section class=\"row header\"><section class=\"col\" width=\"250\" style=\"width: 250px;\"><p>字段</p></section><section class=\"col\" width=\"120\" style=\"width: 120px;\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">message_id</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">消息ID,唯一标识</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">subscribe_task_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">订阅任务ID</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">service_label</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">订阅服务类型<br><p data-id=\"p1dr9j7ls-80nqds2sbjk00\">允许值: <code><span style=\"color: #1d39c4;\">settings.stdproject.realtime</span></code> 智擎版标准项目配置实时变更</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">publish_time</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-eaxccy5g5pc0\">消息实际产生时间，秒级时间戳</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">timestamp</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">毫秒时间戳，本条消息实际推送时间，获取推送数据列表时无该参数数据</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">nonce</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">随机数，和timestamp组合防重放，获取推送数据列表时无该参数数据</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">app_id</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">应用id</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"6\" height=\"8\" viewBox=\"0 0 6 8\" fill=\"none\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">account_relation</p></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\">账号对应关系，包含所有的授权关系</section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">core_user_ids</p></section></section><section class=\"col col_param_type\"><p>number[]</p></section><section class=\"col description\">用户授权账号</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"6\" height=\"8\" viewBox=\"0 0 6 8\" fill=\"none\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">data</p></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-d7qncx9two800\">推送数据信息，订阅服务类型不同，返回结构不同&nbsp;</p></section></section><section cl