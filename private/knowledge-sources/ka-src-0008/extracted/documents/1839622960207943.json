  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><div class=\"table-container qz-card-type-block\"><div class=\"scrollbar-shadow-left\"></div><div class=\"scrollbar-shadow-right\"></div><div class=\"table-content-scroll\" style=\"overflow-y: scroll\"><table data-id=\"t4y5lzbq4-yn6gaa41c0w000\" data-custom=\"true\" class=\"data-table data-table-col-header\" style=\"width: 880px; outline: none; border-collapse: collapse;\" data-transient-attributes=\"class\" data-width=\"880px\"><colgroup data-id=\"c1e4a4ebk-146v8igg0rts000\"><col width=\"174\" span=\"1\" data-id=\"c55txxd4k-mncdtxs254w000\"><col width=\"705\" span=\"1\" data-id=\"cikysw9mw-bva1kxzxr6w000\"></colgroup><tbody data-id=\"t1dr9qg4g-ncghns9nr2o000\"><tr data-id=\"t15ucy39c-h5kqkeei89k000\" style=\"height: 30px;\"><td data-id=\"t1gc62o68-pytchlyifn4000\" style=\"vertical-align: top; background: rgb(239, 239, 239); min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-x94bgsghtds000\">适用场景</p></td><td data-id=\"t1fi1b2aw-c6c5kth2isg000\" class=\"table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-q2kkztzcls0000\">作为个人业务人员/开发者，通过工具获取账户关系，业务报表数据做数据分析或二次加工处理等业务场景</p></td></tr><tr data-id=\"t15ucy39c-oxwjekj6d9s000\" style=\"height: 30px;\"><td data-id=\"t14durfkg-1by51t480lts000\" class=\"table-last-column\" style=\"vertical-align: top; background: rgb(239, 239, 239); min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-e9asqn3r2xc000\">支持协议类型</p></td><td data-id=\"t3z246w96-b6r7m77hs14000\" class=\"table-last-row table-last-column\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-ec2bqomqq3s000\"><span style=\"color: #252525;\">Streamable HTTP </span></p></td></tr></tbody></table></div></div><h2 id=\"h490b8bf-EfhYTU8O\" data-id=\"h490b8bf-dQ1Hf204\">配置示例</h2><h3 id=\"h6f20189-AUAf1Uca\" data-id=\"h6f20189-AUAf1Uca\">方式一：官方应用授权</h3><p data-id=\"p838747a-v8G81RLs\">可在【<a href=\"https://open.oceanengine.com/mcp?app_id=1837698859935771\" target=\"blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">MCP鉴权</a>】页面登录对应千川业务账户并授权获取url</p><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22wrap%22%3Afalse%2C%22language%22%3A%22json%22%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22text%22%3A%22%7B%5Cn%20%20%5C%22mcpServers%5C%22%3A%20%7B%5Cn%20%20%20%20%5C%22%E5%B7%A8%E9%87%8F%E5%8D%83%E5%B7%9D%E4%B8%9A%E5%8A%A1%E5%B7%A5%E5%85%B7%5C%22%3A%20%7B%5Cn%20%20%20%20%20%20%5C%22url%5C%22%3A%C2%B7%5C%22https%3A%2F%2Fopen.oceanengine.com%2Fqianchuan%2Fmcp%3FAPI_KEY%3D%7BAPI_KEY%7D%5C%22%5Cn%20%20%20%20%7D%5Cn%20%20%7D%5Cn%7D%22%2C%22disabled%22%3Afalse%2C%22id%22%3A%22B5dAb%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content json\"></div></div></div></div><div data-type=\"qzcard\" data-value=\"data:%7B%22borderColor%22%3A%22%23fed4a4%22%2C%22backgroundColor%22%3A%22%23fff5eb%22%2C%22text%22%3A%22%3Cp%3E%3C%2Fp%3E%22%2C%22id%22%3A%22oFBoq%22%2C%22type%22%3A%22block%22%2C%22html%22%3A%22%3Cp%20data-id%3D%5C%22p838747a-dw5cDToK%5C%22%3E%E3%80%90%E8%AD%A6%E6%83%95%E4%BF%A1%E6%81%AF%E4%BF%9D%E6%8A%A4%E3%80%91%3Cspan%20style%3D%5C%22background-color%3A%20%23fff5eb%3B%5C%22%3Eurl%E4%B8%AD%E7%9A%84%7BAPI_KEY%7D%E4%B8%BA%E6%8E%88%E6%9D%83%E