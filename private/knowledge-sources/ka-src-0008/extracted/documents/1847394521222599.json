  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><div class=\"table-container qz-card-type-block\"><div class=\"scrollbar-shadow-left\"></div><div class=\"scrollbar-shadow-right\"></div><div class=\"table-content-scroll\" style=\"overflow-y: scroll\"><table class=\"data-table data-table-col-header\" data-custom=\"true\" data-id=\"tdqvl8tei-47ilom2ddc4000\" style=\"width: 880px; outline: none; border-collapse: collapse;\" data-transient-attributes=\"class\" data-width=\"880px\"><colgroup data-id=\"c1e4a4ebk-4utwgkdable000\"><col data-id=\"c2dwrz7pc-3kwdi2rlmd0000\" span=\"1\" width=\"174\"><col data-id=\"c8ikytn5e-17fwn946ijs000\" span=\"1\" width=\"705\"></colgroup><tbody data-id=\"t1dr9qg4g-20hh8z6u3ue800\"><tr data-id=\"t15ucy39c-20b3i3l3bpi800\" style=\"height: 30px;\"><td data-id=\"t1gc62o68-3fbvjyout0i000\" style=\"vertical-align: top; background: rgb(239, 239, 239); min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-3pz0q19pkjm000\">适用场景</p></td><td class=\"table-last-row\" data-id=\"t1fi1b2aw-1c3ibc73mnj400\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-3zkk0iu76l8000\">作为个人业务人员/开发者，通过工具获取账户关系，业务报表数据做数据分析或二次加工处理等业务场景</p></td></tr><tr data-id=\"t15ucy39c-3k7om29wmcs000\" style=\"height: 30px;\"><td class=\"table-last-column\" data-id=\"t14durfkg-55b9s9c2frg000\" style=\"vertical-align: top; background: rgb(239, 239, 239); min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-14he1lsqtcyk00\">支持协议类型</p></td><td class=\"table-last-row table-last-column\" data-id=\"t3z246w96-qil2x9qgio000\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p1dr9j7ls-35a08p6bv3y000\"><span style=\"color: #252525;\">Streamable HTTP </span></p></td></tr></tbody></table></div></div><h2 data-id=\"h490b8bf-2Y1Yi9J3\" id=\"h490b8bf-EfhYTU8O\">配置示例</h2><h3 data-id=\"h6f20189-biJ3Hmj0\" id=\"h6f20189-AUAf1Uca\">方式一：官方应用授权</h3><p data-id=\"p838747a-ofOHzgAt\">可在【<a href=\"https://open.oceanengine.com/mcp?app_id=1841425772187712\" target=\"blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">MCP鉴权</a>】页面登录对应营销业务账户并授权获取url</p><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22wrap%22%3Afalse%2C%22language%22%3A%22json%22%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22text%22%3A%22%7B%5Cn%20%20%5C%22mcpServers%5C%22%3A%20%7B%5Cn%20%20%20%20%5C%22%E5%B7%A8%E9%87%8F%E5%BC%95%E6%93%8E%E5%B7%A5%E5%85%B7%5C%22%3A%20%7B%5Cn%20%20%20%20%20%20%5C%22url%5C%22%3A%C2%B7%5C%22https%3A%2F%2Fopen.oceanengine.com%2Fad%2Fmcp%3FAPI_KEY%3D%7BAPI_KEY%7D%5C%22%5Cn%20%20%20%20%7D%5Cn%20%20%7D%5Cn%7D%22%2C%22disabled%22%3Afalse%2C%22id%22%3A%22B5dAb%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content json\"></div></div></div></div><div data-type=\"qzcard\" data-value=\"data:%7B%22borderColor%22%3A%22%23fed4a4%22%2C%22backgroundColor%22%3A%22%23fff5eb%22%2C%22text%22%3A%22%3Cp%3E%3C%2Fp%3E%22%2C%22id%22%3A%22oFBoq%22%2C%22type%22%3A%22block%22%2C%22html%22%3A%22%3Cp%20data-id%3D%5C%22p838747a-dw5cDToK%5C%22%3E%E3%80%90%E8%AD%A6%E6%83%95%E4%BF%A1%E6%81%AF%E4%BF%9D%E6%8A%A4%E3%80%91%3Cspan%20style%3D%5C%22background-color%3A%20%23fff5eb%3B%5C%22%3Eurl%E4%B8%AD%E7%9A%84%7BAPI_KEY%7D%E4%B8%BA%E6%8E%88%E6%9D%83%E5%90%8E%E7%94%9F%E6%88%90%E7