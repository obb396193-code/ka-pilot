B%3Ca%20href%3D%5C%22https%3A%2F%2Fopen.oceanengine.com%2Flabels%2F7%2Fdocs%2F1713655428885516%5C%22%20target%3D%5C%22_blank%5C%22%3E%E2%80%8Bhttps%3A%2F%2Fopen.oceanengine.com%2Flabels%2F7%2Fdocs%2F1713655428885516%E2%80%8B%3C%2Fa%3E%E2%80%8B%3C%2Fli%3E%3Cli%20data-id%3D%5C%22ld70c578-Sb9feQ3a%5C%22%3E%3Cstrong%3E%E6%8E%A5%E5%8F%A3%E6%9F%A5%E8%AF%A2%E7%BB%93%E6%9E%9C%E4%B8%BAT%2B1%EF%BC%8C%E5%8F%AF%E5%9C%A8%E6%AC%A1%E6%97%A510%E7%82%B9%E5%90%8E%E6%9B%B4%E6%96%B0%E5%90%8C%E6%AD%A5%3C%2Fstrong%3E%3C%2Fli%3E%3C%2Ful%3E%22%7D\"><div class=\"QZCard-container\" style=\"border-color: #fed4a4;background-color:#fff5eb;\"><div class=\"QZCard-icon\"><svg height=\"22\" p-id=\"13148\" version=\"1.1\" viewbox=\"0 0 1024 1024\" width=\"22\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M833.5 330.5C833.5 153 689.6 7.6 512 7.6S190.5 153 190.5 330.5c0 70.3 37.3 161 97.2 227.9 59.4 66.3 103.5 177.9 103.5 266.9v34.9h241.6v-34.6c0-89 44.1-200.4 103.2-266.9 60.1-67.6 97.5-166.4 97.5-228.2z\" fill=\"#FFC807\" p-id=\"13149\"></path><path d=\"M636.5 790.6l-193.9-268L596.4 202l199.2 266.4c-17.4 36.4-39.3 67.4-63.9 95.2C685.3 621 664.1 671.1 644 741l-7.5 49.6z\" fill=\"#FFB300\" p-id=\"13150\"></path><path d=\"M499.5 378.3h-82.7c-12.6 0-21.4-12.7-16.8-24.5l59.2-153c2.7-6.9 9.4-11.5 16.8-11.5h105c13.6 0 22.3 14.5 15.9 26.5l-81.5 153c-3.2 5.8-9.3 9.5-15.9 9.5z\" fill=\"#FFF8E1\" p-id=\"13151\"></path><path d=\"M466.2 518.3l160-171c12-12.8 2.9-33.7-14.6-33.7h-105c-8.7 0-16.4 5.6-19.1 13.9l-55 171c-6.6 20.4 19.1 35.5 33.7 19.8z\" fill=\"#FFF8E1\" p-id=\"13152\"></path><path d=\"M593.6 1016.4H430.4c-5.7 0-10.9-3.7-14-9.8l-22.2-44.2h235.6l-22.2 44.2c-3.1 6.1-8.3 9.8-14 9.8z\" fill=\"#455A64\" p-id=\"13153\"></path><path d=\"M625.7 980.4H398.3c-22.1 0-40.1-17.9-40.1-40.1V776.7c0-22.1 17.9-40.1 40.1-40.1h227.5c22.1 0 40.1 17.9 40.1 40.1v163.7c-0.1 22.1-18 40-40.2 40z\" fill=\"#ECEFF1\" p-id=\"13154\"></path><path d=\"M539.8 808.6H359v-36h180.8c9.9 0 18 8.1 18 18 0 10-8.1 18-18 18zM359 840.1h306v36H359zM665 943.6H494.8c-9.9 0-18-8.1-18-18s8.1-18 18-18H665v36z\" fill=\"#CFD8DC\" p-id=\"13155\"></path></svg></div><div class=\"QZCard-editor-container\"><p data-id=\"p838747a-jJbLS1TL\">您可通过此接口查询开发者应用（APPID）下最近7天请求过的不活跃账户，<span style=\"color: #f5222d;\">平台建议您降低此类账户的请求频次或无需请求</span></p><ul data-id=\"u738a58b-GaGERQIU\"><li data-id=\"ld70c578-EG0H9iXB\">不活跃账户定义：指客户在至少90天内没有任何活跃行为，结合消耗、项目/营销创编、余额、有无开启中计划等条件综合判断</li><li data-id=\"ld70c578-2pDlfqgg\">目前仅支持返回<strong>巨量营销</strong>下的不活跃账户列表</li><li data-id=\"ld70c578-eDbHQm4X\">请求此接口时需传入应用级别token，详见：<a href=\"https://open.oceanengine.com/labels/7/docs/1713655428885516\" target=\"_blank\">https://open.oceanengine.com/labels/7/docs/1713655428885516</a></li><li data-id=\"ld70c578-Sb9feQ3a\"><strong>接口查询结果为T+1，可在次日10点后更新同步</strong></li></ul></div></div></div>\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201834072631691340%2C%20%22docLibId%22%3A%201743864733602830%7D\">\n \n</div>\n<h1 data-id=\"h346b9f0-hdCNopNS\" id=\"h346b9f0-hdCNopNS\">请求地址</h1><p data-id=\"p838747a-PMnLlm9g\"><a href=\"https://api.oceanengine.com/open_api/v3.0/tools/inactive_advertiser/list/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://api.oceanengine.com/open_api/v3.0/tools/inactive_advertiser/list/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1834548530596872\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-4AhkbTTp\" id=\"h346b9f0-4AhkbTTp\">请求方法</h1><p data-id=\"p838747a-7RmSZX1e\">GET</p><h1 data-id=\"h346b9f0-vLWXl5sO\" id=\"h346b9f0-vLWXl5sO\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">App-Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><span style=\"color: #f5222d;\">应用级token</span>，区别于普通的Access Token，通过【<a href=\"https://ad.oceanengine.com/openapi/doc/index.html?id=1713655428885516\">获取APP Access Token</a><p data-id=\"p838747a-C5B87jRu\">】接口获取</p></section></section></section><h1 data-id=\"h346b9f0-EhAWFMVE\" id=\"h346b9f0-EhAWFMVE\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">app_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-kZQPXB0l\">应用ID，即发起请求的应用程序ID（APPID），可在开发者后台-<a href=\"https://open.oceanengine.com/developer/admin/ad_list\" target=\"_blank\">应用管理</a>页面查看</p><p data-id=\"p838747a-AUYw6V1T\">1次请求会返回最近7天该APPID调用过的不活跃客户列表</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">cursor</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-B3xU7f3O\">游标，翻页使用\n最小值：0\n翻页使用，第一页传0，第二页开始，需要传前一页resp返回的cursor</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">count</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-BD9MP5V6\">单页拉取的数据量</p><p data-id=\"p838747a-D7JbWpNE\">允许值1-100000，默认值1000</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"> 返回的账户列表类型，1次只能指定一种。可选值：<br/><ul data-id=\"u738a58b-OQX4Z5hb\"><li data-id=\"ld70c578-CfON93kk\"><code>INACTIVE</code>：默认值。不活跃账户，指客户在至少90天内未活跃，根据未产生消耗、没有营销新建/编辑行为、无余额、无开启中计划等条件综合判断，<span style=\"color: #f5222d;\">建议您不要请求或降低请求频次。</span></li><li data-id=\"ld70c578-hoabgbEN\"><code>30_DAY_NO_COST</code>：客户在30天内无任何消耗，系统不会直接施加限流管控，但该类账户的请求比例影响您的开发者QPS分配，建议在QPS资源紧张时降低请求频次</li></ul></section></section></section><h1 data-id=\"h346b9f0-06o0oBo1\" id=\"h346b9f0-06o0oBo1\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Ftools%2Finactive_advertiser%2Flist%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20app_id%20%3D%20APP_ID%5Cn%20%20%20%20cursor%20%3D%20CURSOR%5Cn%20%20%20%20count%20%3D%20COUNT%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22app_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22cursor%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22count%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%20%25%20(app_id%2C%20cursor%2C%20count)%5Cn%20%20%20%20print(get(my_args))%5Cn%20%20%20%20%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22import%20com.fasterxml.jackson.core.JsonProcessingException%3B%5Cnimport%20com.fasterxml.jackson.databind.ObjectMapper%3B%5Cnimport%20okhttp3.*%3B%5Cnimport%20org.apache.http.client.utils.URIBuilder%3B%5Cn%5Cnimport%20java.io.IOException%3B%5Cnimport%20java.net.URI%3B%5Cnimport%20java.net.URISyntaxException%3B%5Cnimport%20java.net.URL%3B%5Cnimport%20java.util.List%3B%5Cnimport%20java.util.Map%3B%5Cnimport%20java.util.stream.Collectors%3B%5Cn%5Cnpublic%20class%20Demo%20%7B%5Cn%20%20%20%20private%20static%20final%20String%20ACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20String%20PATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Ftools%2Finactive_advertiser%2Flist%2F%5C%22%3B%5Cn%20%20%20%20private%20static%20final%20ObjectMapper%20mapper%20%3D%20new%20ObjectMapper()%3B%5Cn%5Cn%20%20%20%20%2F**%5Cn%20%20%20%20%20*%20Build%20request%20URL%5Cn%20%20%20%20%20*%5Cn%20%20%20%20%20*%20%40param%20path%20Request%20path%5Cn%20%20%20%20%20*%20%40return%20Request%20URL%5Cn%20%20%20%20%20*%2F%5Cn%20%20%20%20private%20static%20String%20buildUrl(String%20path)%20throws%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20URI%20uri%20%3D%20new%20URI(%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%2C%20path%2C%20%5C%22%5C%22%2C%20%5C%22%5C%22)%3B%5Cn%20%20%20%20%20%20%20%20return%20uri.toString()%3B%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%5Cn%20%20%20%20%2F**%5Cn%20%20%20%20%20*%20Send%20GET%20request%5Cn%20%20%20%20%20*%5Cn%20%20%20%20%20*%20%40param%20jsonStr%3AArgs%20in%20JSON%20format%5Cn%20%20%20%20%20*%20%40return%20Response%20in%20JSON%20format%5Cn%20%20%20%20%20*%2F%5Cn%20%20%20%20private%20static%20String%20get(String%20jsonStr)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20OkHttpClient%20client%20%3D%20new%20OkHttpClient().newBuilder().build()%3B%5Cn%20%20%20%20%20%20%20%20URIBuilder%20ub%20%3D%20new%20URIBuilder(buildUrl(PATH))%3B%5Cn%20%20%20%20%20%20%20%20Map%3C%20String%2C%20Object%20%3E%20map%20%3D%20mapper.readValue(jsonStr%2C%20Map.class)%3B%5Cn%20%20%20%20%20%20%20%20map.forEach((k%2C%20v)%20-%3E%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20ub.addParameter(k%2C%20v%20instanceof%20String%20%3F%20(String)%20v%20%3A%20mapper.writeValueAsString(v))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%20catch%20(JsonProcessingException%20e)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20e.printStackTrace()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%7D)%3B%5Cn%20%20%20%20%20%20%20%20URL%20url%20%3D%20ub.build().toURL()%3B%5Cn%5Cn%20%20%20%20%20%20%20%20Request%20request%20%3D%20new%20Request.Builder()%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.url(url)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.method(%5C%22GET%5C%22%2C%20null)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.addHeader(%5C%22Access-Token%5C%22%2C%20ACCESS_TOKEN)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.build()%3B%5Cn%20%20%20%20%20%20%20%20Response%20response%20%3D%20client.newCall(request).execute()%3B%5Cn%20%20%20%20%20%20%20%20return%20response.body().string()%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20%5Cn%5Cn%20%20%20%20public%20static%20void%20main(String%5B%5D%20args)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20Long%20app_id%20%3D%20APP_ID%3B%5Cn%20%20%20%20%20%20%20%20Long%20cursor