  "abstract": "{\"business_domain\":[\"巨量本地推-本地推\"],\"business_line\":[\"巨量本地推\"],\"capability_summary\":\"该接口用于上传本地推投放账户的视频文件，需提供视频md5值、视频文件等信息。可通过【获取Access token】接口获取授权access_token。返回码和返回信息详见【附录 - 返回码】。\",\"id\":\"local.file_video.upload\",\"interface_path\":\"/open_api/v3.0/local/file/video/upload/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1808003989738499\",\"related_docs\":[{\"id\":\"get_access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权access_token才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"appendix_return_code\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"reason\":\"此接口的返回码和返回信息需参考该文档\",\"relation\":\"配合接口\",\"title\":\"附录 - 返回码\"}],\"risk_level\":\"medium\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1808003989738499\",\"title\":\"上传视频\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\">\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201808625861485579%2C%20%22docLibId%22%3A%201743864733602830%7D\">\n \n</div>\n<h1 data-id=\"h346b9f0-1lKj1jh4\" id=\"h346b9f0-1lKj1jh4\">请求地址</h1><p data-id=\"p838747a-to1of8Qu\"><a href=\"https://api.oceanengine.com/open_api/v3.0/local/file/video/upload/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://api.oceanengine.com/open_api/v3.0/local/file/video/upload/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1808003989738499\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a></p><h1 data-id=\"h346b9f0-L6SXaVV0\" id=\"h346b9f0-L6SXaVV0\">请求方法</h1><p data-id=\"p838747a-Ue9WzkOk\">POST</p><h1 data-id=\"h346b9f0-ZjCW8dFe\" id=\"h346b9f0-ZjCW8dFe\">请求Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section>