  "abstract": "{\"business_domain\":[\"巨量营销-线索、表单与互动\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"获取投放账户下评论的「可见评论数」、「可见负评数」、「可见评论负评率」，可通过设置查询时间、评论层级、抖音号、营销视频id列表、隐藏状态等筛选条件进行查询。配合接口有【获取Access token】、【获取抖音授权关系】。\",\"id\":\"tools.comment_metrics.get\",\"interface_path\":\"/open_api/v3.0/tools/comment_metrics/get/\",\"method\":\"GET\",\"official_url\":\"1779551814119427\",\"related_docs\":[{\"id\":\"get_access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取Access token才能进行接口调用\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"get_douyin_authorization_relation\",\"path\":\"https://open.oceanengine.com/docs/1729983667746823\",\"reason\":\"可通过该接口获取item_id和视频相关信息用于本接口查询\",\"relation\":\"配合接口\",\"title\":\"获取抖音授权关系\"}],\"risk_level\":\"low\",\"schema_url\":\"1779551814119427\",\"title\":\"获取评论统计指标\"}",
