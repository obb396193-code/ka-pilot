  "abstract": "{\"business_domain\":[\"巨量营销-项目管理\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"批量获取项目和营销的否定词，支持搜索快投和搜索直投，需通过【获取Access token】接口获取授权access_token，返回码和信息详见【附录-返回码】。\",\"id\":\"tools.privative_word.batch_get\",\"interface_path\":\"/open_api/v3.0/tools/privative_word/batch_get/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1756247565488132\",\"related_docs\":[{\"id\":\"get.access_token\",\"path\":\"/open_api/v1.0/get/access_token/\",\"reason\":\"需要先获取授权access_token才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"appendix.return_code\",\"path\":\"/open_api/v1.0/appendix/return_code/\",\"reason\":\"此接口的返回码和信息需参考【附录-返回码】\",\"relation\":\"配合接口\",\"title\":\"附录-返回码\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1756247565488132\",\"supplemental_knowledge\":[],\"title\":\"批量获取项目否定词\"}",
