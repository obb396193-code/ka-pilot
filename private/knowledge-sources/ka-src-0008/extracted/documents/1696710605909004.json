  "abstract": "{\"business_domain\":[\"巨量营销-素材与创意\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"通过此接口，用户可以批量更新素材视频的名称。需配合【获取Access token】接口获取授权access_token，对于短漫剧行业白名单客户，可通过【查询白名单能力】接口查询账户是否具备特定标签能力。\",\"id\":\"material.video.update\",\"interface_path\":\"/open_api/2/file/video/update/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1696710605909004\",\"related_docs\":[{\"id\":\"token.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权access_token才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"whitelist.query\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1763407285579840\",\"reason\":\"短漫剧行业白名单客户可通过此接口查询账户是否具备特定标签能力\",\"relation\":\"配合接口\",\"title\":\"查询白名单能力\"}],\"risk_level\":\"medium\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1696710605909004\",\"title\":\"更新视频\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><p data-id=\"p1dr9j7ls-481oknzbcv4000\">通过此接口，用户可以批量更新素材视频的名称。</p><div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A1772452943159367%2C%22docLibId%22%3A1743864733602830%2C%22id%22%3A%22qLcJI%22%2C%22type%22%3A%22block%22%7D\"> </div><h1 data-id=\"h4kgw8yp6-f55wws42gmo00\" id=\"h4kgw8yp6-f55wws42gmo00\">请求地址</h1><p data-id=\"p1dr9j7ls-ah6l3g3o9g400\">https://api.oceanengine.com/open_api/2/file/video/update/<a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1696710605909004\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h4kgw8yp6-x8i10k43als00\" id=\"h4kgw8yp6-x8i10k43als00\">请求方法</h1><p data-id=\"p1dr9j7ls-l6wr1ig3els00\">POST</p><h1 data-id=\"h4kgw8yp6-f5p2jvzvhf400\" id=\"h4kgw8yp6-f5p2jvzvhf400\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Content-Type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">请求消息类型<br/>允许值: <code>application/json</code></section></section></section><h1 data-id=\"h4kgw8yp6-1sbgr9h5r1r400\" id=\"h4kgw8yp6-1sbgr9h5r1r400\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">客户ID</section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">videos</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>object[]</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-3kh9tsnp5we000\">限制最多 100 个</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">video_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-3xr0726kbgc000\">视频id</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">filename</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-3m5538fuba0000\">视频素材名称，最多255个字</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">labels</p></section></section><section class=\"col col_param_type\"><p>string[]</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-4kwu1b5hp9g000\">标签</p><ul data-id=\"u1dr9j7ls-48uk4o1msvm000\"><li data-id=\"l19a1dmf4-45i4zbidh22000\"><span style=\"color: #f5222d;\">注意：采用全量更新逻辑。不传该字段默认不更新；传入非空数组将完全替换该视频当前的所有标签；传入空数组即清空当前所有标签。</span></li><li data-id=\"l19a1dmf4-bao0plltld400\">请优先为无需付费信息的素材传入<code>仅IAA</code>标签，标记该素材仅IAA模式投放，不参与IAP模式投放；未传入该标签，素材默认为通用素材，可同时参与IAA和IAP投放。（该标签能力仅对短漫剧行业白名单客户生效，您可通过<a href=\"https://open.oceanengine.com/labels/7/docs/1763407285579840\">【查询白名单能力】</a>接口传入gray_key = <code>R3_material</code>查询您的账户是否具备该能力。未开通权限的账户传入标签将返回错误）</li></ul></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">video_cover_id</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p1dr9j7ls-g718oqt6of400\">视频封面ID，可通过<a href=\"https://open.oceanengine.com/labels/7/docs/1696710601820172?origin=left_nav\">【获取视频素材】</a><a href=\"https://open.oceanengine.com/labels/7/docs/1696710601254912\">【获取图片素材】</a><a href=\"https://open.oceanengine.com/labels/7/docs/1696710602404864?origin=left_nav\">【获取视频智能封面】</a>接口获取。</p><ul data-id=\"u1dr9j7ls-ueurixl9xgg0\"><li data-id=\"l19a1dmf4-bnn3swoetyw00\">（视频封面与视频绑定能力全新上线，素材库视频与创编主流程使用的同一视频素材将对应绑定同一个视频封面。）</li></ul></section></section></section><h1 data-id=\"h4kgw8yp6-5tu45h78980000\" id=\"h4kgw8yp6-5tu45h78980000\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ffile%2Fvideo%2Fupdate%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20post(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20POST%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20url%20%3D%20build_url(PATH)%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%20%20%20%20%5C%22Content-Type%5C%22%3A%20%5C%22application%2Fjson%5C%22%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.post(url%2C%20headers%3Dheaders%2C%20json%3Dargs)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%20%20%20%20video_id%20%3D%20VIDEO_ID%5Cn%20%20%20%20filename%20%3D%20FILENAME%5Cn%20%20%20%20labels_list%20%3D%20LABELS%5Cn%20%20%20%20labels%20%3D%20json.dumps(labels_list)%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22videos%5C%5C%5C%22%3A%20%5B%7B%5C%5C%5C%22video_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22filename%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22labels%5C%5C%5C%22%3A%20%25s%7D%5D%7D%5C%22%20%25%20(advertiser_id%2C%20video