  "abstract": "{\"business_domain\":[\"代理商-财务管理\"],\"business_line\":[\"代理商\"],\"capability_summary\":\"创建代理返点相关数据（如违规明细、核算明细、业绩明细等）的下载任务，可指定查询类型、时间范围等参数。配合【获取Access token】接口获取授权access_token，应答中返回下载任务的查询ID等信息。\",\"id\":\"agent_rebate.file_rebate.create_task\",\"interface_path\":\"/open_api/2/file/rebate/rebate_download/create_task/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1812970751420483\",\"related_docs\":[{\"id\":\"access_token.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权access_token才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1812970751420483\",\"title\":\"【代理返点】创建下载任务-返点(非素材)\\u0026激励\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><p data-id=\"p838747a-Bkg82eiG\"><span style=\"background-color: #ffbb96;\"><u><strong>返回文件详细内容请查看： </strong></u></span><a href=\"https://bytedance.larkoffice.com/docx/EBETdc8IIonmWoxWYJ7c1dNtndg\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://bytedance.larkoffice.com/docx/EBETdc8IIonmWoxWYJ7c1dNtndg</a></p><h1 data-id=\"h346b9f0-UwmXrIgn\" id=\"h346b9f0-UwmXrIgn\"><br/></h1><div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A1812694536773075%2C%22docLibId%22%3A1743864733602830%2C%22id%22%3A%22KX00v%22%2C%22type%22%3A%22block%22%7D\"> </div><h1 data-id=\"h346b9f0-UNJgcYD8\" id=\"h346b9f0-UNJgcYD8\">请求地址</h1><p data-id=\"p838747a-jcEtCnBs\"><a href=\"https://api.oceanengine.com/open_api/2/file/rebate/rebate_download/create_task/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://api.oceanengine.com/open_api/2/file/rebate/rebate_download/create_task/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1812970751420483\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-qpr9O6BQ\" id=\"h346b9f0-qpr9O6BQ\">请求方法</h1><p data-id=\"p838747a-QYi2nZQd\">POST</p><h1 data-id=\"h346b9f0-YNtTnkTV\" id=\"h346b9f0-YNtTnkTV\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-9kQl27ra\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Content-Type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-uW9P0rsq\">请求消息类型<br/>允许值: <code>application/json</code></p></section></section></section><h1 data-id=\"h346b9f0-8793BOcU\" id=\"h346b9f0-8793BOcU\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">agent_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-Rq993V3A\">代理商账户id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">query_type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-QRAAnIbC\">查询类型,目前包括\nmonth_punish_details:下载违规明细月度\nquarter_punish_details:下载违规明细季度 \nmonth_rebate_details:下载核算明细月度\nquarter_rebate_details:下载核算明细季度\nmonth_performance_details:下载业绩明细月度\nquarter_performance_details:下载业绩明细季度 可选值: </p><ul data-id=\"u738a58b-R8MERjfi\"><li data-id=\"ld70c578-oU0RD2Hj\"><code>month_punish_details</code> 违规明细月</li><li data-id=\"ld70c578-kPjQIDKI\"><code>quarter_punish_details</code> 违规明细季</li><li data-id=\"ld70c578-pXQMQht1\"><code>month_rebate_details</code> 核算明细月</li><li data-id=\"ld70c578-Na5rHKaP\"><code>quarter_rebate_details</code> 核算明细季</li><li data-id=\"ld70c578-dmeb9ZaF\"><code>month_performance_details</code> 业绩明细月</li><li data-id=\"ld70c578-Cd6ZKtpe\"><code>quarter_performance_details</code> 业绩明细季</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">year</p><section class=\"col_params_tag\"><section class=\"param-tag success\">条件必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-o5P8G2ef\">年</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">month_quarter</p><section class=\"col_params_tag\"><section class=\"param-tag success\">条件必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-5Dudofvf\">月/季度，可以传多个，以逗号分隔，如传入   1,2,3</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">wait_latest</p></section></section><section class=\"col col_param_type\"><p>bool</p></section><section class=\"col description\">等待最新数据参数，默认等待  默认值: <code>True</code></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">policy_id</p><section class=\"col_params_tag\"><section class=\"param-tag success\">条件必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\">对于激励政策，必须填写policy_id</section></section></section><h1 data-id=\"h346b9f0-YWQBbIXP\" id=\"h346b9f0-YWQBbIXP\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ffile%2Frebate%2Frebate_download%2Fcreate_task%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20post(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20POST%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20url%20%3D%20build_url(PATH)%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%20%20%20%20%5C%22Content-Type%5C%22%3A%20%5C%22application%2Fjson%5C%22%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.post(url%2C%20headers%3Dheaders%2C%20json%3Dargs)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20agent_id%20%3D%20AGENT_ID%5Cn%20%20%20%20query_type%20%3D%20QUERY_TYPE%5Cn%20%20%20%20year%20%3D%20YEAR%5Cn%20%20%20%20month_quarter%20%3D%20MONTH_QUARTER%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22agent_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22query_type%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22year%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22month_quarter%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%20%25%20(agent_id%2C%20que