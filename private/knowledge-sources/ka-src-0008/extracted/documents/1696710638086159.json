B0%20%20%20%20%20%20%20%20%5Cn%20%20%20%20FileBody%20file%20%3D%20new%20FileBody(new%20File(code_file))%3B%5Cn%20%20%20%20MultipartEntityBuilder%20entityBuilder%20%3D%20MultipartEntityBuilder.create()%5Cn%20%20%20%20%20%20%20%20%20%20%20%20.addPart(%5C%22file%5C%22%2C%20file)%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E5%85%B6%E4%BB%96%E5%8F%82%E6%95%B0%5Cn%20%20%20%20entityBuilder.addTextBody(%5C%22advertiser_id%5C%22%2C%20%5C%220%5C%22)%3B%5Cn%20%20%20%20entityBuilder.addTextBody(%5C%22mark%5C%22%2C%20%5C%22xxx%5C%22)%3B%5Cn%20%20%20%20entityBuilder.addTextBody(%5C%22resource_id%5C%22%2C%20%5C%221%5C%22)%3B%5Cn%20%20%20%20HttpEntity%20entity%20%3D%20entityBuilder.build()%3B%5Cn%5Cn%20%20%20%20CloseableHttpResponse%20response%20%3D%20null%3B%5Cn%20%20%20%20CloseableHttpClient%20client%20%3D%20null%3B%5Cn%5Cn%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20client%20%3D%20HttpClientBuilder.create().build()%3B%5Cn%20%20%20%20%20%20%20%20httpPost.setURI(URI.create(open_api_url_prefix%20%2B%20uri))%3B%5Cn%5Cn%20%20%20%20%20%20%20%20httpPost.setEntity(entity)%3B%5Cn%5Cn%20%20%20%20%20%20%20%20response%20%3D%20client.execute(httpPost)%3B%5Cn%20%20%20%20%20%20%20%20if%20(response%20!%3D%20null%20%26amp%3B%26amp%3B%20response.getStatusLine().getStatusCode()%20%3D%3D%20200)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20BufferedReader%20bufferedReader%20%3D%20new%20BufferedReader(new%20InputStreamReader(response.getEntity().getContent()))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20StringBuffer%20result%20%3D%20new%20StringBuffer()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20String%20line%20%3D%20%5C%22%5C%22%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20while%20((line%20%3D%20bufferedReader.readLine())%20!%3D%20null)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20result.append(line)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%20%20%20%20bufferedReader.close()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%20JSONObject.parseObject(result.toString())%3B%5