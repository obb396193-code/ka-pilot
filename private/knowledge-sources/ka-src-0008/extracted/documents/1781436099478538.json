: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-O0TecBcw\">detail</p></td><td colspan=\"1\" data-id=\"t8e94736-M4HDH1Y5\" class=\"table-last-column\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-Rh0SmxZY\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">object</code></p></td><td colspan=\"1\" data-id=\"t5bc59a3-iI0RIB85\" class=\"table-last-column table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-e7azdjM5\">广告详情。字段参考&nbsp;<a href=\"https://open.oceanengine.com/labels/7/docs/1741028841006095\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">获取广告列表 - 应答参数</a></p></td></tr></tbody></table></div><h1 data-id=\"h346b9f0-YmpWSC7c\" id=\"h346b9f0-XlguUb6C\">选择器 PromotionSelector</h1><p data-id=\"p838747a-rawakd04\">广告选择器对象，用来过滤所需广告；</p><p data-id=\"p838747a-D94grzbl\">调用选择器的iterator方法，将返回广告迭代器，用于遍历查询。</p><h2 id=\"h490b8bf-TFRG2vZT\" data-id=\"h490b8bf-KF03SeNj\">方法</h2><div class=\"table-container qz-card-type-block\"><table class=\"data-table\" data-id=\"t61fe7cd-qhsF11IA\" data-custom=\"false\" data-transient-attributes=\"class\" style=\"width: 100%; outline: none; border-collapse: collapse; max-width: 100%;\" data-width=\"100%\"><colgroup data-id=\"c7104f7d-X9w68i1x\"><col span=\"1\" data-id=\"c0bb105d-msQH4a8c\" width=\"33.33333333333333%\"><col span=\"1\" data-id=\"c0bb105d-SieklxRK\" width=\"33.33333333333333%\"><col span=\"1\" data-id=\"c0bb105d-bnr1FM3U\" width=\"33.33333333333333%\"></colgroup><tbody data-id=\"t6d5e859-xucZVpqf\"><tr data-id=\"t31e458f-w9Dco9xz\" style=\"height: 30px;\"><td data-id=\"t8c0e6ab-QovhCrND\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-HEIE5j7C\"><strong>名称</strong></p></td><td data-id=\"t8c0e6ab-3ml2qyBC\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-Gz646gl2\"><strong>类型</strong></p></td><td data-id=\"t1b895c3-DhnhVTBD\" class=\"table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-cVKO5w29\"><strong>描述</strong></p></td></tr><tr data-id=\"t31e458f-FtQ4RDDw\" style=\"height: 30px;\"><td data-id=\"t8c0e6ab-84S57wDP\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-ut3vkrOC\">withAdvId</p></td><td data-id=\"t8c0e6ab-BIIsijcv\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-EJaLvKcg\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">(advertiser_id) =&gt; this</code></p></td><td data-id=\"t1b895c3-EkjzQH14\" class=\"table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-ZPrRUUGw\">指定查询某个advertiser_id下的广告</p></td></tr><tr data-id=\"t31e458f-z0wQH9o4\" style=\"height: 30px;\"><td colspan=\"1\" data-id=\"t882b249-XcX7LWWd\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-JWlfYqxu\">withFields</p></td><td colspan=\"1\" data-id=\"t882b249-LIiTAGsd\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-9q7rEHEq\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">(fields: string[]) =&gt; this</code></p></td><td colspan=\"1\" data-id=\"t00cbcc2-Fm99d1KU\" class=\"table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-EqkCfgPC\"><span style=\"background-color: #f8f8f9;\">指定查询字段集合。若指定则获取到的Project对象仅具有指定字段。</span></p><p data-id=\"p838747a-ZSUSyLDz\">可从<span style=\"background-color: #f8f8f9;\">&nbsp;</span><a target=\"_blank\" href=\"https://open.oceanengine.com/labels/7/docs/1741028841006095\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\"><span style=\"background-color: #f8f8f9;\">获取广告列表 - 应答参数</span></a> data.list[]的子<span style=\"background-color: #f8f8f9;\">字段中，选择传入</span></p></td></tr><tr data-id=\"t31e458f-gsG8Cu1L\" style=\"height: 30px;\"><td colspan=\"1\" data-id=\"t882b249-NrfFYA6I\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-svHRUadL\">withFiltering</p></td><td colspan=\"1\" data-id=\"t882b249-pxNROWqb\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-7kRPBSSZ\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">(filtering: object) =&gt; this</code></p></td><td colspan=\"1\" data-id=\"t00cbcc2-7QbYB4jm\" class=\"table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-OSzOLxG0\">指定过滤条件，传入字段参考&nbsp;<a href=\"https://open.oceanengine.com/labels/7/docs/1741028841006095\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">获取广告列表 - 请求参数</a></p></td></tr><tr data-id=\"t31e458f-WBjjwfW8\" style=\"height: 30px;\"><td colspan=\"1\" data-id=\"t8e94736-QMoP2IQT\" class=\"table-last-column\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-mJQ11jMR\">iterator</p></td><td colspan=\"1\" data-id=\"t8e94736-hPW7Gfmm\" class=\"table-last-column\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-1PqllrbH\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">() =&gt; AsyncIterable&lt;Promotion&gt;</code></p></td><td colspan=\"1\" data-id=\"t5bc59a3-mne9BcZ4\" class=\"table-last-column table-last-row\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\" data-transient-attributes=\"table-cell-selection\"><p data-id=\"p838747a-8oprruWX\">用上面构建好的请求参数，获取广告列表，调用 MAPI 接口：<a href=\"https://open.oceanengine.com/labels/7/docs/1741028841006095\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">获取广告列表</a></p><p data-id=\"p838747a-HZmvsEhj\">需通过 for await of 遍历</p></td></tr></tbody></table></div><h1 data-id=\"h346b9f0-QN7HsGrj\" id=\"h346b9f0-BXd3JjNi\">代码示例</h1><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22wrap%22%3Afalse%2C%22language%22%3A%22javascript%22%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22text%22%3A%22%2F%2F%20%E4%BB%A3%E7%A0%81%E5%85%A5%E5%8F%A3%5Cnexport%20async%20function%20main()%20%7B%5Cn%20%20const%20myPromotions%20%3D%20%5B%5D%3B%5Cn%20%20const%20agents%20%3D%20await%20Mapi.getAgents()%3B%5Cn%20%20for%20(const%20agent%20of%20agents)%20%7B%5Cn%20%20%20%20const%20advs%20%3D%20agent.advSelector().iterator()%3B%5Cn%20%20%20%20for%20await%20(const%20adv%20of%20advs)%20%7B%5Cn%20%20%20%20%20%20const%20promotions%20%3D%20adv%5Cn%20%20%20%20%20%20%20%20.promotionSelector()%5Cn%20%20%20%20%20%20%20%20.withFields(%5B'promotion_name'%5D)%5Cn%20%20%20%20%20%20%20%20.withFiltering(%7B%20status%3A%5C%22AUDIT%5C%22%20%7D)%5Cn%20%20%20%20%20%20%20%20.iterator()%3B%5Cn%20%20%20%20%20%20for%20await%20(const%20promotion%20of%20promotions)%20%7B%5Cn%20%20%20%20%20%20%20%20console.log(promotion.detail.promotion_name)%3B%5Cn%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%2F%2F%20%E5%8F%91%E9%80%81%E7%9B%91%E6%8E%A7%E6%8A%A5%E8%AD%A6...%5Cn%20%20%20%20%7D%5Cn%20%20%7D%5Cn%5Cn%20%20return%20'ok'%3B%5Cn%7D%5Cn%22%2C%22disabled%22%3Afalse%2C%22id%22%3A%22toPlh%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content javascript\"></div></div></div></div><h2 id=\"h490b8bf-IcXlAkFX\" data-id=\"h490b8bf-IcXlAkFX\">指定ID使用</h2><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22wrap%22%3Afalse%2C%22language%22%3A%22javascript%22%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22text%22%3A%22%2F%2F%20%E5%B7%B2%E7%9F%A5advertiser_id%E7%9A%84%E6%83%85%E5%86%B5%E4%B8%8B%EF%BC%8C%E5%8F%AF%E4%BB%A5%E7%9B%B4%E6%8E%A5%E6%9F%A5%E8%AF%A2%E8%AF%A5advertiser%E4%B8%8B%E7%9A%84project%5Cnconst%20adv%20%3D%20new%20Mapi.Adv(%7Badvertiser_id%3A%20123%7D)%5Cnconst%20promotions%20%3D%20adv.promotionSelector().withFiltering(%7B%E5%A1%AB%E5%85%A5%E7%AD%9B%E9%80%89%E6%9D%A1%E4%BB%B6%7D).iterator()%5Cnfor%20await%20(const%20promotion%20of%20promotions)%20%7B%5Cn%20%20%20%20%2F%2F%20%E5%A4%84%E7%90%86%5Cn%7D%22%2C%22disabled%22%3Afalse%2C%22id%22%3A%22SSwUZ%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content javascript\"></div></div></div></div></div>",
