e-last-column\" colspan=\"1\" data-id=\"tcb3c9f5-mjkWVE3J\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-qmq5YHte\">授权access-token，获取方法见接口文档<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"_blank\">【获取Access-Token】</a></p></td></tr></tbody></table></div><h3 data-id=\"h6f20189-owzrRT0V\" id=\"link-3\">请求参数</h3><div class=\"table-container qz-card-type-block\"><table class=\"data-table data-table-row-header\" data-custom=\"false\" data-id=\"t3945309-9MhY3Jkm\" data-transient-attributes=\"class\" data-width=\"100%\" style=\"width: 100%; outline: none; border-collapse: collapse; max-width: 100%;\"><colgroup data-id=\"c7104f7d-8pK68n1B\"><col data-id=\"c0bb105d-4vITgBwU\" span=\"1\" width=\"33.69419858348669%\"/><col data-id=\"c0bb105d-1ZqLNZt3\" span=\"1\" width=\"19.357248087854227%\"/><col data-id=\"c0bb105d-lBLI4EeI\" span=\"1\" width=\"46.948553328659074%\"/></colgroup><tbody data-id=\"t6d5e859-I81Ikl20\"><tr data-id=\"t31e458f-OHgP77LB\" style=\"height: 30px;\"><td data-id=\"t8c0e6ab-rQ2DGauF\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-rvOmlXVm\">字段</p></td><td data-id=\"t8c0e6ab-ecXJKZpO\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-YGrBYjx7\">类型</p></td><td class=\"table-last-row\" data-id=\"t1b895c3-Inn3nOKj\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-1so