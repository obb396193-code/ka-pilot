17, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-xZ6P3Llh\">caid/caid1/caid2/caid1_md5/caid2_md5</p></td><td data-id=\"t8b8e80e-VCZkJlL5\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-o9BMshhm\">caid</p></td><td class=\"table-last-row\" data-id=\"tcc17e07-WuXFYImF\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-loYno9NR\">ios通过caid(包括caid1、caid2或者md5后的结果)进行归因上的转化</p></td></tr><tr data-id=\"t28b8a14-ybpaHK9E\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-ipriUQrN\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-Lm0DTUw5\">ip/ipv4</p></td><td data-id=\"t8b8e80e-vjCuOmtR\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-ep5KSdJ7\">ipv4</p></td><td class=\"table-last-row\" data-id=\"tcc17e07-8baStE5c\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-NgdI8DPL\">只通过ipv4进行归因上的转化</p></td></tr><tr data-id=\"t28b8a14-sLgS4HS9\" style=\"height: 100%; width: 