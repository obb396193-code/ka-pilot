%20mapper.writeValueAsString(v))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%20catch%20(JsonProcessingException%20e)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20e.printStackTrace()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%7D)%3B%5Cn%20%20%20%20%20%20%20%20URL%20url%20%3D%20ub.build().toURL()%3B%5Cn%5Cn%20%20%20%20%20%20%20%20Request%20request%20%3D%20new%20Request.Builder()%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.url(url)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.method(%5C%22GET%5C%22%2C%20null)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.addHeader(%5C%22Access-Token%5C%22%2C%20ACCESS_TOKEN)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.build()%3B%5Cn%20%20%20%20%20%20%20%20Response%20response%20%3D%20client.newCall(request).execute()%3B%5Cn%20%20%20%20%20%20%20%20return%20response.body().string()%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20%5Cn%5Cn%20%20%20%20public%20static%20void%20main(String%5B%5D%20args)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20Long%20advertiser_id%20%3D%20ADVERTISER_ID%3B%5Cn%20%20%20%20%20%20%20%20List%20%3C%20Long%20%3E%20promotion_ids_list%20%3D%20PROMOTION_IDS%3B%5Cn%20%20%20%20%20%20%20%20String%20promotion_ids%20%3D%20mapper.writeValueAsString(promotion_ids_list)%3B%5Cn%20%20%20%20%20%20%20%20String%20delivery_mode%20%3D%20DELIVERY_MODE%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20Args%20in%20JSON%20format%5Cn%20%20%20%20%20%20%20%20String%20myArgs%20%3D%20String.format(%5C%22%7B%5C%5C%5C%22advertiser_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22promotion_ids%5C%5C%5C%22%3A%20%25s%2C%20%5C%5C%5C%22delivery_mode%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%7D%5C%22%2Cadvertiser_id%2C%20promotion_ids%2C%20delivery_mode)%3B%5Cn%20%20%20%20%20%20%20%20System.out.println(get(myArgs))%3B%5Cn%20%20%20%20%7D%5Cn%7D%5Cn%22%7D%2C%7B%22language%22%3A%22php%22%2C%22text%22%3A%22%5Cn%24ACCESS_TOKEN%20%3D%20%5C%22xx