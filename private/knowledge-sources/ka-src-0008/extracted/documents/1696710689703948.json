dXFTB8ph\" id=\"link-4\">请求示例</h5><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22def%20do_request()%3A%5Cn%20%20%20%20import%20requests%5Cn%20%20%20%20open_api_url_prefix%20%3D%20%5C%22https%3A%2F%2Fad.oceanengine.com%2Fopen_api%2F%5C%22%5Cn%20%20%20%20uri%20%3D%20%5C%222%2Ftools%2Faweme_author_info%2Fget%2F%5C%22%5Cn%20%20%20%20url%20%3D%20open_api_url_prefix%20%2B%20uri%5Cn%20%20%20%20params%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22advertiser_id%5C%22%3A%200%2C%5Cn%20%20%20%20%20%20%20%20%5C%22label_ids%5C%22%3A%20%5B123221%5D%2C%5Cn%20%20%20%20%20%20%20%20%5C%22behaviors%5C%22%3A%20%5B%5C%22FOLLOWED_USER%5C%22%5D%5Cn%20%20%20%20%7D%5Cn%20%20%20%20headers%20%3D%20%7B%5C%22Access-Token%5C%22%3A%20%5C%22xxx%5C%22%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20json%3Dparams%2C%20headers%3Dheaders)%5Cn%20%20%20%20rsp_data%20%3D%20rsp.json()%5Cn%20%20%20%20return%20rsp_data%5Cn%22%7D%2C%7B%22language%22%3A%22java%22%2C%22text%22%3A%22public%20JSONObject%20getIesAccount()%20%7B%5Cn%20%20%20%20String%20access_token%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20final%20Long%20advertiser_id%20%3D%200L%3B%5Cn%20%20%20%20final%20Long%5B%5D%20label_ids%20%3D%20new%20Long%5B%5D%7B12324312L%7D%3B%5Cn%20%20%20%20String%5B%5D%20behaviors%20%3D%20new%20String%5B%5C%22FOLLOWED_USER%5C%22%5D%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E8%AF%B7%E6%B1%82%E5%9C%B0%E5%9D%80%5Cn%20%20%20%20String%20open_api_url_prefix%20%3D%20%5C%22https%3A%2F%2Fad.oceanengine.com%2Fopen_api%2F2%2F%5C%22%3B%5Cn%20%20%20%20String%20uri%20%3D%20%5C%22tools%2Faweme_author_info%2Fget%2F%5C%22%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E8%AF%B7%E6%B1%82%E5%8F%82%E6%95%B0%5Cn%20%20%20%20Map%20data%20%3D%20new%20HashMap()%7B%5Cn%20%20%20%20%20%20%20%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20put(%5C%22advertiser_id%5C%22%2C%20advertiser_id)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20put(%