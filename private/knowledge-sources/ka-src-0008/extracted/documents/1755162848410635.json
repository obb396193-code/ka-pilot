  "abstract": "{\"business_domain\":[\"巨量营销-转化资产与事件管理\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"支持获取优化目标关联橙子建站站点列表，方便通过 API 创编营销。可配合【获取橙子建站站点列表】接口区分站点来源。\",\"id\":\"tools.orange_site.get\",\"interface_path\":\"/open_api/v3.0/tools/orange_site/get/\",\"method\":\"GET\",\"official_url\":\"1755162848410635\",\"related_docs\":[{\"id\":\"tools.orange_site.list\",\"path\":\"https://open.oceanengine.com/labels/34/docs/1696710620579852?origin=left_nav\",\"reason\":\"用于区分橙子落地页是账户下自建的还是被共享的\",\"relation\":\"配合接口\",\"title\":\"获取橙子建站站点列表\"},{\"id\":\"auth.access_token.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"请求本接口需要先获取授权access_token\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"wechat.mini_program.list\",\"path\":\"https://open.oceanengine.com/labels/34/docs/1771203622020111\",\"reason\":\"用于获取小程序/小游戏资产id，筛选橙子落地页\",\"relation\":\"配合接口\",\"title\":\"获取微信小程序列表\"},{\"id\":\"wechat.mini_game.list\",\"path\":\"https://open.oceanengine.com/labels/34/docs/1771362185154564\",\"reason\":\"用于获取小程序/小游戏资产id，筛选橙子落地页\",\"relation\":\"配合接口\",\"title\":\"获取微信小游戏列表\"},{\"id\":\"bytedance.mini_program.list\",\"path\":\"https://open.oceanengine.com/labels/34/docs/1778249831680135\",\"reason\":\"用于获取小程序/小游戏资产id，筛选橙子落地页\",\"relation\":\"配合接口\",\"title\":\"获取字节小程序列表\"},{\"id\":\"bytedance.mini_game.list\",\"path\":\"https://open.oceanengine.com/labels/34/docs/1778100726681600\",\"reason\":\"用于获取小程序/小游戏资产id，筛选橙子落地页\",\"relation\":\"配合接口\",\"title\":\"获取字节小游戏列表\"}],\"risk_level\":\"low\",\"schema_url\":\"1755162848410635\",\"title\":\"通过优化目标获取橙子落地页站点信息\"}",
