{
  "abstract": "{\"id\":\"star.report.get\",\"title\":\"获取投后每日趋势数据（短视频）\",\"interface_path\":\"/open_api/2/star/report/custom_data_topic_daily_report/\",\"method\":\"GET\",\"capability_summary\":\"此接口用于获取短视频的每日趋势数据指标，支持抖音-短视频-指派、招募、投稿类型。数据更新频率为每日16:00之后可查最新数据（不包括当天），统计周期起始-结束时间间隔不得超过45天。如需查询直播间数据，请前往「获取投后数据主题累计数据」接口。\",\"related_docs\":[{\"id\":\"star.report.get_cumulative_data\",\"title\":\"获取投后数据主题累计数据\",\"path\":\"https://open.oceanengine.com/labels/13/docs/1792052602066947\",\"relation\":\"配合接口\",\"reason\":\"如需查询直播间数据，需使用此接口\"},{\"id\":\"get_access_token\",\"title\":\"获取Access token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"relation\":\"前置接口\",\"reason\":\"请求此接口需要通过该接口获取授权access_token\"},{\"id\":\"appendix_return_code\",\"title\":\"【附录-返回码】\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"relation\":\"参考文档\",\"reason\":\"请求和应答的返回码和返回信息说明需参考此文档\"}]}",
