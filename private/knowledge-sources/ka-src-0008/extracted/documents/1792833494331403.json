 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">stats</p></section></section><section class=\"col col_param_type\"><p>object[]</p></section><section class=\"col description\"><p data-id=\"p838747a-NSI1seBz\">统计数据列表</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">work_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-4OAT2QUe\">请求的作品交付物Id</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">demand_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-Kh68OIcC\">请求的任务Id</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"col_params\"><p class=\"col_params_name\">date</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-kHJWuAs5\">该指标数据的yyyy-MM-dd日期时间, 按天聚合。<code>BASIC_DATA</code>作为通用指标在每日趋势数据中date为\"0\"。</p></section></section><section class=\"row body\" data-level=\"2\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 48px;\"><section class=\"arrow\" style=\"left: 36px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">data</p></section></section><section class=\"col col_param_type\"><p>object[]</p></section><section class=\"col description\"><p data-id=\"p838747a-ErmVo5Cp\">详细增量指标数据列表</p></section></section><section class=\"row body\" data-level=\"3\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 64px;\"><section class=\"col_params\"><p class=\"col_params_name\">data_topic</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-Z298t1x6\">DataTopic，同请求中的数据主题枚举值。不存在的数据主题将缺省。 可选值: </p><ul data-id=\"u738a58b-pX9g52lT\"><li data-id=\"ld70c578-hYRM0tHS\"><code>BASIC_DATA</code> 基础信息</li><li data-id=\"ld70c578-U2oUOurA\"><code>COMMENT_DATA</code> 评论数据</li><li data-id=\"ld70c578-UGlR44lB\"><code>CONVERT_DATA</code> 转化表现</li><li data-id=\"ld70c578-BTLgum2U\"><code>DY_SHOP_DATA</code> 抖音进店</li><li data-id=\"ld70c578-rut5GK6R\"><code>FLOW_DATA</code> 流量表现</li><li data-id=\"ld70c578-AZly6p09\"><code>INDEX_SCORE_DATA</code> 指数得分</li><li data-id=\"ld70c578-noCiO1V1\"><code>RECOMMEND_DATA</code> 种草表现</li><li data-id=\"ld70c578-f7pZ3Ffr\"><code>SEARCH_DATA</code> 搜索表现</li><li data-id=\"ld70c578-N1g4TsvJ\"><code>USER_DISTRIBUTION_DATA</code> 用户画像</li></ul></section></section><section class=\"row body\" data-level=\"3\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 64px;\"><section class=\"arrow\" style=\"left: 52px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">metrics</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>object[]</p></section><section class=\"col description\"><p data-id=\"p838747a-NgXuWXNg\">数据主题下的数据指标，一个数据主题对应一个或多个数据指标。不存在的数据指标将缺省。</p></section></section><section class=\"row body\" data-level=\"4\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 80px;\"><section class=\"col_params\"><p class=\"col_params_name\">field</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-NvsWeoYW\">指标字段，仅包含英文与下划线等符号</p></section></section><section class=\"row body\" data-level=\"4\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 80px;\"><section class=\"col_params\"><p class=\"col_params_name\">name</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-Ld3vds5P\">指标名称，中文或英文描述字段名称</p></section></section><section class=\"row body\" data-level=\"4\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 80px;\"><section class=\"col_params\"><p class=\"col_params_name\">type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-zQ5Znh79\">指标数据类型：\nSTRING、\nINT64、\nFLOAT64、\nJSON格式字符串为K-V键值对, 例如画像数据为: {\"长沙\": 0.23} 可选值: </p><ul data-id=\"u738a58b-8NAbrV1V\"><li data-id=\"ld70c578-87raZxNu\"><code>FLOAT64</code> 64位浮点数</li><li data-id=\"ld70c578-yfFkkTec\"><code>INT64</code> 64位整数</li><li data-id=\"ld70c578-bbK02k7g\"><code>JSON</code> JSON</li><li data-id=\"ld70c578-hRF6oPtn\"><code>STRING</code> 字符串</li></ul></section></section><section class=\"row body\" data-level=\"4\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 80px;\"><section class=\"col_params\"><p class=\"col_params_name\">value</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-VErTaD2s\">指标值</p></section></section><section class=\"row body\" data-level=\"4\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 80px;\"><section class=\"col_params\"><p class=\"col_params_name\">description</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-svE405nz\">指标描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">request_id</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-aWKHPjFk\">请求日志id</p></section></section></section><h1 data-id=\"h346b9f0-n2baVFC3\" id=\"h346b9f0-n2baVFC3\">应答示例</h1><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22disabled%22%3Atrue%2C%22wrap%22%3Afalse%2C%22language%22%3A%22json%22%2C%22theme%22%3A%22Q