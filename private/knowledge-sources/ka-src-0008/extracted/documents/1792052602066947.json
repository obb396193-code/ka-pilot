ss)%3B%5Cn%20%20%20%20%20%20%20%20map.forEach((k%2C%20v)%20-%3E%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20ub.addParameter(k%2C%20v%20instanceof%20String%20%3F%20(String)%20v%20%3A%20mapper.writeValueAsString(v))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%20catch%20(JsonProcessingException%20e)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20e.printStackTrace()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%7D)%3B%5Cn%20%20%20%20%20%20%20%20URL%20url%20%3D%20ub.build().toURL()%3B%5Cn%5Cn%20%20%20%20%20%20%20%20Request%20request%20%3D%20new%20Request.Builder()%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.url(url)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.method(%5C%22GET%5C%22%2C%20null)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.addHeader(%5C%22Access-Token%5C%22%2C%20ACCESS_TOKEN)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.build()%3B%5Cn%20%20%20%20%20%20%20%20Response%20response%20%3D%20client.newCall(request).execute()%3B%5Cn%20%20%20%20%20%20%20%20return%20response.body().string()%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20%5Cn%5Cn%20%20%20%20public%20static%20void%20main(String%5B%5D%20args)%20throws%20IOException%2C%20URISyntaxException%20%7B%5Cn%20%20%20%20%20%20%20%20Long%20star_id%20%3D%20STAR_ID%3B%5Cn%20%20%20%20%20%20%20%20Long%20work_id%20%3D%20WORK_ID%3B%5Cn%20%20%20%20%20%20%20%20Long%20demand_id%20%3D%20DEMAND_ID%3B%5Cn%20%20%20%20%20%20%20%20List%20%3C%20String%20%3E%20topics_list%20%3D%20TOPICS%3B%5Cn%20%20%20%20%20%20%20%20String%20topics%20%3D%20mapper.writeValueAsString(topics_list)%3B%5Cn%5Cn%20%20%20%20%20%20%20%20%2F%2F%20Args%20in%20JSON%20format%5Cn%20%20%20%20%20%20%20%20String%20myArgs%20%3D%20String.format(%5C%22%7B%5C%5C%5C%22star_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22work_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22demand_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s