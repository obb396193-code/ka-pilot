  "abstract": "{\"business_domain\":[\"巨量营销-应用、小程序与游戏\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"查询游戏预约记录详情数据，应答参数按 `creative_time` 正序返回。需通过【获取Access token】接口获取授权 access_token，Android 应用的 package_id 从【查询应用信息】接口获取。\",\"id\":\"ad.booking_records.get\",\"interface_path\":\"/open_api/2/tools/app_management/booking_records/get/\",\"method\":\"GET\",\"official_url\":\"1696710743409676\",\"related_docs\":[{\"id\":\"ad.access_token.get\",\"path\":\"https://ad.oceanengine.com/openapi/doc/index.html?id=1696710506574848\",\"reason\":\"需要先获取授权 access_token 才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"ad.app_info.get\",\"path\":\"https://ad.oceanengine.com/openapi/doc/index.html?key=ad\\u0026type=api\\u0026id=1696710742760448\",\"reason\":\"Android 应用的 package_id 需要从该接口获取\",\"relation\":\"前置接口\",\"title\":\"查询应用信息\"}],\"risk_level\":\"low\",\"schema_url\":\"1696710743409676\",\"title\":\"查询游戏预约记录详情\"}",
