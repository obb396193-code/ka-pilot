  "abstract": "{\"capability_summary\":\"用户可以通过此接口预览通过【基于站点创建模板】接口创建的落地页模板，预览链接有效时间为20分钟。关键配合接口有【基于站点创建模板】、【获取Access token】、【获取站点模版列表】。\",\"id\":\"ad.site_template.preview\",\"interface_path\":\"/open_api/2/tools/site_template/preview/\",\"method\":\"GET\",\"official_url\":\"1722273233146891\",\"related_docs\":[{\"id\":\"ad.site_template.create\",\"path\":\"/open_api/2/tools/site_template/create/\",\"reason\":\"需要先创建落地页模板才能进行预览\",\"relation\":\"前置接口\",\"title\":\"基于站点创建模板\"},{\"id\":\"ad.access_token.get\",\"path\":\"/open_api/2/tools/access_token/get/\",\"reason\":\"请求此接口需要授权access_token\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"ad.site_template.list\",\"path\":\"/open_api/2/tools/site_template/list/\",\"reason\":\"请求此接口需要通过该接口查询模板ID\",\"relation\":\"前置接口\",\"title\":\"获取站点模版列表\"}],\"risk_level\":\"low\",\"schema_url\":\"1722273233146891\",\"title\":\"获取模版预览链接\"}",
