%5Cn%20%20%20%20%20%20%20%20public%20String%20getMethod()%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%20%5C%22GET%5C%22%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%7D%3B%5Cn%5Cn%20%20%20%20httpEntity.setHeader(%5C%22Access-Token%5C%22%2Caccess_token)%3B%5Cn%5Cn%20%20%20%20CloseableHttpResponse%20response%20%3D%20null%3B%5Cn%20%20%20%20CloseableHttpClient%20client%20%3D%20null%3B%5Cn%5Cn%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20client%20%3D%20HttpClientBuilder.create().build()%3B%5Cn%20%20%20%20%20%20%20%20httpEntity.setURI(URI.create(open_api_url_prefix%20%2B%20uri))%3B%5Cn%20%20%20%20%20%20%20%20httpEntity.setEntity(new%20StringEntity(JSONObject.toJSONString(data)%2C%20ContentType.APPLICATION_JSON))%3B%5Cn%5Cn%20%20%20%20%20%20%20%20response%20%3D%20client.execute(httpEntity)%3B%5Cn%20%20%20%20%20%20%20%20if%20(response%20!%3D%20null%20%26amp%3B%26amp%3B%20response.getStatusLine().getStatusCode()%20%3D%3D%20200)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20BufferedReader%20bufferedReader%20%20%3D%20new%20BufferedReader(new%20InputStreamReader(response.getEntity().getContent()))%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20StringBuffer%20result%20%3D%20new%20StringBuffer()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20String%20line%20%3D%20%5C%22%5C%22%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20while((line%20%3D%20bufferedReader.readLine())%20!%3D%20null)%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20result.append(line)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%20%20%20%20%20%20bufferedReader.close()%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%20JSONObject.parseObject(result.toString())%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%5Cn%20%20%20%20%7D%20catch%20(ClientProtocolException%20e)%20%7B%5Cn%20%20%20%20%20%20%20%20e.printStackTrace()%3B%5Cn%20%20%20%20%7D%20catch%20(IOException%20e)%20%7B%5Cn%20%20%20%20%20%20%20%20e.printStackTrace()%3B%5Cn%20%20%20%20%7D%20finally%20%7B%5Cn%20%20%20%20%20%20%20%20try%20%7B%5Cn