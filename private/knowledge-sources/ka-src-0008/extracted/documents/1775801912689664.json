  "abstract": "{\"capability_summary\":\"用于进行店铺新客定向授权，需提供投放账户id、要授权的店铺id、授权时间类型等信息，授权access_token可通过【获取Access token】接口获取，返回码和返回信息详见【附录-返回码】。\",\"id\":\"qianchuan.shop_auth.create\",\"interface_path\":\"/open_api/v1.0/qianchuan/tools/shop_auth/\",\"method\":\"GET\",\"official_url\":\"1775801912689664\",\"related_docs\":[{\"id\":\"qianchuan.access_token.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权access_token才能进行店铺新客定向授权\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"qianchuan.return_code.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"reason\":\"用于查看授权请求的返回码和返回信息\",\"relation\":\"配合接口\",\"title\":\"附录-返回码\"}],\"risk_level\":\"low\",\"schema_url\":\"1775801912689664\",\"title\":\"店铺新客定向授权\"}",
