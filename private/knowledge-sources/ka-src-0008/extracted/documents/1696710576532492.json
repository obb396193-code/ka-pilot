23%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%5D%5Cn%7D%22%2C%22id%22%3A%228ZwEb%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content json\"></div></div></div></div><h3 data-id=\"h6f20189-Bl0cFgJE\" id=\"h6f20189-Bl0cFgJE\">DPA创意模板传参方式</h3><p data-id=\"p838747a-vurxWUGE\">由于平台侧是通过前端提供界面，对于客户来说比较好理解，客户填完表单之后会动态生成一个json参数给后端，但是对于API接入方来说，不同的模板的参数都不相同，其中有的允许修改有的不允许修改，理解成本很高，因此此处只传一个template_id。</p><p data-id=\"p838747a-AXyqFxDw\">示例 url： /open_api/2/dpa/meta/get/<br/>参数：</p><div class=\"qz-codeblock_view qz-codeblock qz-card-type-block\" data-type=\"codeblock\" data-value=\"data:%7B%22wrap%22%3Afalse%2C%22language%22%3A%22json%22%2C%22theme%22%3A%22QZtheme%22%2C%22height%22%3A%22auto%22%2C%22text%22%3A%22%7B%5Cn%20%20%20%20%5C%22advertiser_id%5C%22%3A%20fields.Int(required%3DTrue)%2C%5Cn%20%20%20%20%5C%22platform_id%5C%22%3A%20fields.Int(required%3DTrue%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20validate%3Dwith_msg(partial(validate_min_number%2C%20min_number%3D1)%2C%20u'platform_id%E5%A4%A7%E4%BA%8E0'))%2C%5Cn%20%20%20%20%5C%22indexable%5C%22%3A%20fields.Int()%2C%5Cn%20%20%20%20%5C%22extractable%5C%22%3A%20fields.Int()%2C%5Cn%20%20%20%20%5C%22industry%5C%22%3A%20fields.Int()%2C%5Cn%20%20%20%20%5C%22status%5C%22%3A%20fields.Int()%2C%5Cn%20%20%20%20%5C%22mediaType%5C%22%3A%20fields.Int()%5Cn%7D%22%2C%22id%22%3A%228VflJ%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: auto; max-height: 600px; overflow-y: scroll;\"><div class=\"qz-codeblock_content json\"></div></div></div></div></div>",
