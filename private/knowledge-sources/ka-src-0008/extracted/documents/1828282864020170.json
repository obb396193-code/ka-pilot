{
  "abstract": "{\"business_domain\":[\"巨量千川-素材管理\",\"巨量营销-素材与创意\"],\"business_line\":[\"巨量千川\",\"巨量营销\"],\"capability_summary\":\"利用图片和音频塑造图文，需先通过「上传营销图片」接口获取图片id，通过「上传图文内音频素材」接口获取音频id，再利用这些id塑造图文，获取图文mid。不同图片顺序对应不同的图文mid。\",\"id\":\"material.carousel.create\",\"interface_path\":\"/open_api/2/carousel/create/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1828282864020170\",\"related_docs\":[{\"id\":\"material.image.upload\",\"path\":\"/open_api/2/image/upload/\",\"reason\":\"需要先上传营销图片获取图片id才能塑造图文\",\"relation\":\"前置接口\",\"title\":\"上传营销图片\"},{\"id\":\"material.audio.upload\",\"path\":\"/open_api/2/audio/upload/\",\"reason\":\"需要先上传图文内音频素材获取音频id才能塑造图文\",\"relation\":\"前置接口\",\"title\":\"上传图文内音频素材\"},{\"id\":\"auth.access_token.get\",\"path\":\"/open_api/2/oauth2/access_token/\",\"reason\":\"请求该接口需要授权access_token，可通过此接口获取\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"}],\"risk_level\":\"medium\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1828282864020170\",\"supplemental_knowledge\":[],\"title\":\"上传图文素材\"}",
