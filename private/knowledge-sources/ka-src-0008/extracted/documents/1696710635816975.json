ght: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-ETwMVbl0\">请求消息类型，允许值：<code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">application/json</code></p></td></tr><tr data-id=\"t28b8a14-NSOk8n70\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-d5TUnGgt\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-xmFaB16U\">Access-Token <span class=\"qz-tag-view qz-tag-type-must\" data-type=\"tag\" data-value=\"data:%7B%22tagType%22%3A%22must%22%2C%22tagValue%22%3A%22%E5%BF%85%E5%A1%AB%22%2C%22isCustom%22%3Afalse%2C%22id%22%3A%224iEmU%22%2C%22type%22%3A%22inline%22%7D\" style=\"color:#338aff;background:#ebf3ff;\">必填</span></p></td><td data-id=\"t8b8e80e-IQBCsw5U\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-jVJpqShu\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t06eb8d1-ebW3lFgj\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-iGPousqZ\">授权access-token，获取方法见接口文档<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"_blank\">【获取Access-Token】</a></p></td></tr></tbody></table></div><h3 data-id=\"h6f20189-NSMJObqj\" id=\"h6f20189-NSMJObqj\">请求参数</h3><div class=\"table-container qz-card-type-block\"><table class=\"data-table data-table-row-header\" data-custom=\"false\" data-id=\"t844fe7d-RHKmbKMK\" data-transient-attributes=\"class\" data-width=\"100%\" style=\"width: 100%; height: 100%; outline: none; border-collapse: collapse; max-width: 100%;\"><colgroup data-id=\"c7104f7d-ST7EqwGM\"><col data-id=\"c0ddd087-kLQbXm8A\" span=\"1\" width=\"293%\"/><col data-id=\"c0ddd087-37Rfj3j1\" span=\"1\" width=\"293%\"/><col data-id=\"c0ddd087-s7fHQHTS\" span=\"1\" width=\"293%\"/></colgroup><tbody data-id=\"t6d5e859-gVhwmdvZ\"><tr data-id=\"t28b8a14-skuXyoHr\" style=\"height: 100%; width: 100%;\"><td data-id=\"t54b56e0-ArO2fYCr\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-74Ua7X8R\">字段</p></td><td data-id=\"t54b56e0-ggiRaf3u\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-1flGE1Vc\">类型</p></td><td class=\"table-last-row\" data-id=\"tfafd194-Fne6Xo8L\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-iZBCh1Og\">描述</p></td></tr><tr data-id=\"t28b8a14-uS5cmdv8\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-YLgkIrDw\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-iUy0bBCT\">advertiser_id <span class=\"qz-tag-view qz-tag-type-must\" data-type=\"tag\" data-value=\"data:%7B%22tagType%22%3A%22must%22%2C%22tagValue%22%3A%22%E5%BF%85%E5%A1%AB%22%2C%22isCustom%22%3Afalse%2C%22id%22%3A%220kcZ5%22%2C%22type%22%3A%22inline%22%7D\" style=\"color:#338aff;background:#ebf3ff;\">必填</span></p></td><td data-id=\"t8b8e80e-wbe6R3nz\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-ksdylb9r\">number</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t06eb8d1-CJnR5OjG\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-cL5zS14I\">客户id</p></td></tr><tr data-id=\"t28b8a14-h5frsq0v\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-5i7WRFYq\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-FmEjgKoD\">instance_id <span class=\"qz-tag-view qz-tag-type-must\" data-type=\"tag\" data-value=\"data:%7B%22tagType%22%3A%22must%22%2C%22tagValue%22%3A%22%E5%BF%85%E5%A1%AB%22%2C%22isCustom%22%3Afalse%2C%22id%22%3A%22OkjqI%22%2C%22type%22%3A%22inline%22%7D\" style=\"color:#338aff;background:#ebf3ff;\">必填</span></p></td><td data-id=\"t8b8e80e-BDdOBonF\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-8PZTsciY\">number</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t06eb8d1-ABooWb8p\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-zszasaSC\">表单实例ID</p></td></tr><tr data-id=\"t28b8a14-OOf1qsOK\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-1NWlgizb\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-XRcioyX1\">name</p></td><td data-id=\"t8b8e80e-OxvPYiJk\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-3Tkbl5dW\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"t06eb8d1-4T40o2E0\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(217, 217, 217); padding: 4px 8px; cursor: default;\"><p data-id=\"p838747a-QUGqbL9X\">表单名称，不超过20个字符</p></td></tr><tr data-id=\"t28b8a14-M8BFk04w\" style=\"height: 100%; width: 100%;\"><td data-id=\"t8b8e80e-cJDSlGDb\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; width: 100%; height: 100%; min-width: auto; overflow-wrap: break-word; margin: 4px 8px; border: 1px solid rgb(21