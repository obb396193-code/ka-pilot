  "abstract": "{\"capability_summary\":\"查看穿山甲2.0投放版位数据，可根据客户ID、营销id列表、投放版位列表等条件筛选数据，并支持排序和分页。\",\"id\":\"tools.union_flow_package_promotion_report.get\",\"interface_path\":\"/open_api/v3.0/tools/union/flow_package/promotion/report/\",\"method\":\"GET\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1775179912274944\",\"related_docs\":[{\"id\":\"tools.get_access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权access_token才能调用本接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"appendix.return_code\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"reason\":\"本接口返回码和返回信息的说明参考此文档\",\"relation\":\"配合接口\",\"title\":\"【附录-返回码】\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1775179912274944\",\"title\":\"查看2.0rit数据\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\"><p data-id=\"p838747a-5NiQ9EfY\">查看穿山甲2.0投放版位数据</p>\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201772923958234120%2C%20%22docLibId%22%3A%201743864733602830%7D\">\n \n</div>\n<h1 data-id=\"h346b9f0-VIU7XXek\" id=\"h346b9f0-VIU7XXek\">请求地址</h1><p data-id=\"p838747a-ka2CD22F\"><a href=\"https://api.oceanengine.com/open_api/v3.0/tools/union/flow_package/promotion/report/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"_blank\">https://api.oceanengine.com/open_api/v3.0/tools/union/flow_package/promotion/report/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1775179912274944\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-D5mgKnCW\" id=\"h346b9f0-D5mgKnCW\">请求方法</h1><p data-id=\"p838747a-CpVAkmJC\">GET</p><h1 data-id=\"h346b9f0-JbbPG12N\" id=\"h346b9f0-JbbPG12N\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\"><p>字段</p></section><section class=\"col\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-4ZUBjA5W\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</p></section></section></section><h1 data-id=\"h346b9f0-QRJWVNTd\" id=\"h346b9f0-QRJWVNTd\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\"><p>字段</p></section><section class=\"col\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">advertiser_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-K0091EnU\">客户ID</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"arrow\" style=\"left: 4px;\"><svg fill=\"none\" height=\"8\" viewbox=\"0 0 6 8\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"M5.08156 4.63972C5.50823 4.31972 5.50823 3.67972 5.08156 3.35972L1.88156 0.959719C1.35417 0.564177 0.601563 0.940483 0.601563 1.59972L0.601562 6.39972C0.601562 7.05896 1.35417 7.43526 1.88156 7.03972L5.08156 4.63972Z\" fill=\"#969AA0\" fill-rule=\"evenodd\"></path></svg></section><section class=\"col_params\"><p class=\"col_params_name\">filter</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>object</p></section><section class=\"col description\"><p data-id=\"p838747a-idHqPtBj\">筛选条件</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">promotion_ids</p></section></section><section class=\"col col_param_type\"><p>number[]</p></section><section class=\"col description\"><p data-id=\"p838747a-xhCvakuF\">营销 id 列表，最大数量限制：1000</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">rits</p></section></section><section class=\"col col_param_type\"><p>number[]</p></section><section class=\"col description\"><p data-id=\"p838747a-YiZhEAlD\">投放版位列表，最大数量限制：1000</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">landing_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-IJz3BVkF\">营销目的，允许值：APP 应用、LINK 销售线索投放、MICRO_GAME 小程序、SHOP 电商、QUICK_APP快应用、DPA商品目录 可选值: <br/></p><ul data-id=\"u738a58b-16130TTX\"><li data-id=\"ld70c578-cDiKh1R9\"><code>APP</code> </li><li data-id=\"ld70c578-8VPfIIbG\"><code>DPA</code> </li><li data-id=\"ld70c578-d9SHQ1AT\"><code>LINK</code> </li><li data-id=\"ld70c578-laQ48po4\"><code>MICRO_GAME</code> </li><li data-id=\"ld70c578-5oFDOoBU\"><code>QUICK_APP</code> </li><li data-id=\"ld70c578-UY75gE00\"><code>SHOP</code> </li></ul></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">high_cost</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-Byn1MZqO\">消耗金额上限，单位元</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">low_cost</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-Wm4kVB1D\">消耗金额下限，单位元</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">start_time</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-VXGPYvPr\">开始时间，格式为\"yyyy-mm-dd\"\n限制范围100天内\n默认7天前（不包括当天），即不指定起止时间获取最近7天数据</p></section></section><section class=\"row body\" data-level=\"1\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 32px;\"><section class=\"col_params\"><p class=\"col_params_name\">end_time</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-o4sGHTM0\">结束时间，格式为\"yyyy-mm-dd\"\n默认昨天，即不指定起止时间获取最近7天数据</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">order_field</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-cvpJzGFL\">排序字段，所有的统计指标均可参与排序\n默认按rit排序</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">order_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-NE51lqlM\">排序方式\n枚举值：ASC（升序），DESC（降序）\n默认：DESC 可选值: <br/></p><ul data-id=\"u738a58b-CiS7Pg5X\"><li data-id=\"ld70c578-HjqbUMHP\"><code>ASC</code> </li><li data-id=\"ld70c578-IKNtDifP\"><code>DESC</code> </li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">page</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-3vL4FcGV\">页数\n默认值: 1</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">page_size</p></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-ITpTNibs\">页面大小,限制范围[1, 100]\n默认值: 10</p></section></section></section><h1 data-id=\"h346b9f0-JhgYmcHf\" id=\"h346b9f0-JhgYmcHf\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2Fv3.0%2Ftools%2Funion%2Fflow_package%2Fpromotion%2Freport%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20get(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20GET%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20query_string%20%3D%20urlencode(%7Bk%3A%20v%20if%20isinstance(v%2C%20string_types)%20else%20json.dumps(v)%20for%20k%2C%20v%20in%20args.items()%7D)%5Cn%20%20%20%20url%20%3D%20build_url(PATH%2C%20query_string)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.get(url%2C%20headers%3Dheaders)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20advertiser_id%20%3D%20ADVERTISER_ID%5Cn%20%20%20%20promotion_ids_list%20%3D%20PROMOTION_IDS%5Cn%20%20%20%20promotion_ids%20%3D%20json.dumps(promotion_ids_list)%5Cn%20%20%20%20rits_list%20%3D%20RITS%5Cn%20%20%20%20rits%20%3D%20json.dumps(rits_list)%5Cn%20%20%20%20landing_type%20%3D%20LANDING_TYPE%5Cn%20%20%20%20high_cost%20%3D%20HIGH_COST%5Cn%20%20%20%20low_cost%20%3D%20LOW_COST%5Cn%20%20%20%20start_time%20%3D%20START_TIME%5Cn%20%20%20%20end_time%20%3D%20END_TIME%5Cn%20%20%20%20order_field%20%3D%20ORDER_FIELD%5Cn%20%20%20%20order_type%20%3D%20ORDER_TYPE%5Cn%20%20%20%20page%20%3D%20PAGE%5Cn%20%20%20%20page_size%20%3D%20PAGE_SIZE%5Cn%5Cn%20%20%20%20%23%20Args%20in%