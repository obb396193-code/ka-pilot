-9.3 9.5-15.9 9.5z\" fill=\"#FFF8E1\" p-id=\"13151\"></path><path d=\"M466.2 518.3l160-171c12-12.8 2.9-33.7-14.6-33.7h-105c-8.7 0-16.4 5.6-19.1 13.9l-55 171c-6.6 20.4 19.1 35.5 33.7 19.8z\" fill=\"#FFF8E1\" p-id=\"13152\"></path><path d=\"M593.6 1016.4H430.4c-5.7 0-10.9-3.7-14-9.8l-22.2-44.2h235.6l-22.2 44.2c-3.1 6.1-8.3 9.8-14 9.8z\" fill=\"#455A64\" p-id=\"13153\"></path><path d=\"M625.7 980.4H398.3c-22.1 0-40.1-17.9-40.1-40.1V776.7c0-22.1 17.9-40.1 40.1-40.1h227.5c22.1 0 40.1 17.9 40.1 40.1v163.7c-0.1 22.1-18 40-40.2 40z\" fill=\"#ECEFF1\" p-id=\"13154\"></path><path d=\"M539.8 808.6H359v-36h180.8c9.9 0 18 8.1 18 18 0 10-8.1 18-18 18zM359 840.1h306v36H359zM665 943.6H494.8c-9.9 0-18-8.1-18-18s8.1-18 18-18H665v36z\" fill=\"#CFD8DC\" p-id=\"13155\"></path></svg></div><div class=\"QZCard-editor-container\"><p data-id=\"p838747a-H1fd4a58\"><strong>需要与callback address相同</strong>，否则会报错</p></div></div></div><p data-id=\"p838747a-ZQLDvDNk\"><br></p><h4 data-id=\"hce1b53f-8lVF2pn5\" id=\"link-6\">auth code</h4><ul data-id=\"u738a58b-Aw5REJsi\"><li data-id=\"ld70c578-ql4Nw6hS\"><strong>中文名称</strong>：授权码</li><li data-id=\"ld70c578-rC0jWQXV\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-NSpZfccO\" data-indent=\"1\"><li data-id=\"ld70c578-i9tA2Rud\">授权成功后，开发者通过回调地址获取的授权码auth code，可用于<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" target=\"blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\"><span style=\"color: #1890ff;\">获取 Access Token</span></a>。</li></ul><div data-type=\"qzcard\" data-value=\"data:%7B%22borderColor%22%3A%22%23fed4a4%22%2C%22backgroundColor%22%3A%22%23fff5eb%22%2C%22text%22%3A%22%3Cp%20data-id%3D%5C%22p838747a-YfV16l24%5C%22%3E%3Cstrong%3E%E6%B3%A8%E6%84%8Fauth_code%E6%9C%89%E6%95%88%E6%97%B6%E9%97%B4%E4%B8%BA10%E5%88%86%E9%92%9F%EF%BC%8C%E4%B8%94%E5%8F%AA%E5%8F%AF%E4%BD%BF%E7%94%A8%E4%B8%80%E6%AC%A1%3C%2Fstrong%3E%3C%2Fp%3E%22%2C%22id%22%3A%22GAuIc%22%2C%22type%22%3A%22block%22%2C%22html%22%3A%22%3Cp%20data-id%3D%5C%22p838747a-YfV16l24%5C%22%3E%3Cstrong%3E%E6%B3%A8%E6%84%8Fauth_code%E6%9C%89%E6%95%88%E6%97%B6%E9%97%B4%E4%B8%BA10%E5%88%86%E9%92%9F%EF%BC%8C%E4%B8%94%E5%8F%AA%E5%8F%AF%E4%BD%BF%E7%94%A8%E4%B8%80%E6%AC%A1%3C%2Fstrong%3E%3C%2Fp%3E%22%7D\"><div class=\"QZCard-container\" style=\"border-color: #fed4a4;background-color:#fff5eb;\"><div class=\"QZCard-icon\"><svg viewBox=\"0 0 1024 1024\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" p-id=\"13148\" width=\"22\" height=\"22\"><path d=\"M833.5 330.5C833.5 153 689.6 7.6 512 7.6S190.5 153 190.5 330.5c0 70.3 37.3 161 97.2 227.9 59.4 66.3 103.5 177.9 103.5 266.9v34.9h241.6v-34.6c0-89 44.1-200.4 103.2-266.9 60.1-67.6 97.5-166.4 97.5-228.2z\" fill=\"#FFC807\" p-id=\"13149\"></path><path d=\"M636.5 790.6l-193.9-268L596.4 202l199.2 266.4c-17.4 36.4-39.3 67.4-63.9 95.2C685.3 621 664.1 671.1 644 741l-7.5 49.6z\" fill=\"#FFB300\" p-id=\"13150\"></path><path d=\"M499.5 378.3h-82.7c-12.6 0-21.4-12.7-16.8-24.5l59.2-153c2.7-6.9 9.4-11.5 16.8-11.5h105c13.6 0 22.3 14.5 15.9 26.5l-81.5 153c-3.2 5.8-9.3 9.5-15.9 9.5z\" fill=\"#FFF8E1\" p-id=\"13151\"></path><path d=\"M466.2 518.3l160-171c12-12.8 2.9-33.7-14.6-33.7h-105c-8.7 0-16.4 5.6-19.1 13.9l-55 171c-6.6 20.4 19.1 35.5 33.7 19.8z\" fill=\"#FFF8E1\" p-id=\"13152\"></path><path d=\"M593.6 1016.4H430.4c-5.7 0-10.9-3.7-14-9.8l-22.2-44.2h235.6l-22.2 44.2c-3.1 6.1-8.3 9.8-14 9.8z\" fill=\"#455A64\" p-id=\"13153\"></path><path d=\"M625.7 980.4H398.3c-22.1 0-40.1-17.9-40.1-40.1V776.7c0-22.1 17.9-40.1 40.1-40.1h227.5c22.1 0 40.1 17.9 40.1 40.1v163.7c-0.1 22.1-18 40-40.2 40z\" fill=\"#ECEFF1\" p-id=\"13154\"></path><path d=\"M539.8 808.6H359v-36h180.8c9.9 0 18 8.1 18 18 0 10-8.1 18-18 18zM359 840.1h306v36H359zM665 943.6H494.8c-9.9 0-18-8.1-18-18s8.1-18 18-18H665v36z\" fill=\"#CFD8DC\" p-id=\"13155\"></path></svg></div><div class=\"QZCard-editor-container\"><p data-id=\"p838747a-YfV16l24\"><strong>注意auth_code有效时间为10分钟，且只可使用一次</strong></p></div></div></div><p data-id=\"p838747a-MFsXqpO8\"><br></p><h4 data-id=\"hce1b53f-0D4R5l5L\" id=\"link-7\">Access Token</h4><ul data-id=\"u738a58b-iK13BXTJ\"><li data-id=\"ld70c578-5q4Zm9qp\"><strong>中文名称</strong>：授权令牌</li><li data-id=\"ld70c578-YcucPBWa\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-Ipf8ftDC\" data-indent=\"1\"><li data-id=\"ld70c578-BD7qHSMj\">Access Token是调用API接口的调用凭证，用于服务端对API请求鉴权，<strong>默认有效期为1天</strong>。可以通过<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" target=\"blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\"><span style=\"color: #1890ff;\">获取 Access Token</span></a>接口获取。</li><li data-id=\"ld70c578-VhclFQjo\">一旦Access Token失效，您将无法调用接口，可以使用<a href=\"https://ad.oceanengine.com/openapi/doc/index.html?id=1696710506097679\" target=\"blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\"><span style=\"color: #1890ff;\">刷新 Refresh Token</span></a>接口进行刷新，获取新的Access Token。</li></ul><p data-id=\"p838747a-Zou0kkgo\"><br></p><h4 data-id=\"hce1b53f-RLdmo41g\" id=\"link-8\">Refresh Token</h4><ul data-id=\"u738a58b-12EODALG\"><li data-id=\"ld70c578-12UmSXkG\"><strong>中文名称</strong>：刷新令牌</li><li data-id=\"ld70c578-1IEtodNy\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-rRP8HDi1\" data-indent=\"1\"><li data-id=\"ld70c578-sELCZZBP\">用于刷新Access token，<strong>默认有效期为30天</strong></li><li data-id=\"ld70c578-sdBZgp29\">刷新会生成新的Access Token 和 Refresh Token ，<strong>之前的Access Token 和 Refresh Token 都将失效不可再使用</strong>，请做好Token的存储和管理工作，确保每次使用的是最新的Token</li></ul><p data-id=\"p838747a-WrLDRxuh\"><br></p><h4 data-id=\"hce1b53f-UD07Avcc\" id=\"link-9\">advertiser id</h4><ul data-id=\"u738a58b-nQfE4EiC\"><li data-id=\"ld70c578-QmqXh1kK\"><strong>中文名称</strong>：客户账号ID/代理商ID/旧版巨量引擎工作台ID</li><li data-id=\"ld70c578-DjVr5JDq\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-NF3pYQdL\" data-indent=\"1\"><li data-id=\"ld70c578-NqLSo1PO\">平台的应用角色有客户、代理商、旧版巨量引擎工作台三类，advertiser id即客户ID，客户是基础角色，而代理商、旧版巨量引擎工作台是特殊的客户，其下可能管理多个客户，<strong>您需要根据具体的接口判断advertiser id是哪一类ID</strong>，可参考【<a href=\"https://ad.oceanengine.com/athena/faq/index.html?plat_id=7&amp;id=1675534359718924\" target=\"blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\"><span style=\"color: #1890ff;\">如何确认advertiser_id类型</span></a>】</li></ul><p data-id=\"p838747a-icRbQKuO\"><br></p><h4 data-id=\"hce1b53f-DoTPkhAI\" id=\"link-10\">campaign id</h4><ul data-id=\"u738a58b-MXSiTyDL\"><li data-id=\"ld70c578-yGeOFeF0\"><strong>中文名称</strong>：计划组ID</li><li data-id=\"ld70c578-pvL9xVJz\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-jhAejoeQ\" data-indent=\"1\"><li data-id=\"ld70c578-rdBaK8IT\">计划组是一批同一营销目的计划的集合，计划组和投放计划是一对多的关系，例如，您可以将投放某一款产品的所有投放计划放在一个计划组中。</li><li data-id=\"ld70c578-XA4zWOdh\">在计划组相关操作接口中，campaign id是唯一标识</li><li data-id=\"ld70c578-QFUQajZg\">通过计划组id可以进行计划组预算、计划组状态等数据的相关操作。</li></ul><p data-id=\"p838747a-7LeA5Srw\"><br></p><h4 data-id=\"hce1b53f-VN2fff6i\" id=\"link-11\">ad id</h4><ul data-id=\"u738a58b-0bo4pRbT\"><li data-id=\"ld70c578-YkpyXmkJ\"><strong>中文名称</strong>：投放计划ID</li><li data-id=\"ld70c578-6oVmvCOn\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-GYL3l6cj\" data-indent=\"1\"><li data-id=\"ld70c578-2XEYu4Rv\">在投放计划中，您可以设置营计划的投放目标、定向、计划预算等信息。</li><li data-id=\"ld70c578-wD4EqUwc\">在投放计划相关操作接口中，ad id是唯一标识。</li><li data-id=\"ld70c578-NuFAqGmd\">一个计划必须从属于一个计划组，一个计划可以设置多个投放创意。</li></ul><p data-id=\"p838747a-x6cbVUWC\"><br></p><h4 data-id=\"hce1b53f-goUiYPkW\" id=\"link-12\">creative id</h4><ul data-id=\"u738a58b-xL8kvxrW\"><li data-id=\"ld70c578-J8awcLXs\"><strong>中文名称</strong>：投放创意ID</li><li data-id=\"ld70c578-NFU2R5d5\"><strong>详细描述</strong>：</li></ul><ul data-id=\"udcdd064-kgB29ZJr\" data-indent=\"1\"><li data-id=\"ld70c578-YG67908z\">投放创意可以设置投放位置、投放内容（图片、视频、标题等）、监测链接等信息。</li><li data-id=\"ld70c578-llLRMpB3\">在投放创意相关操作接口中，creative id是唯一标识。</li><li data-id=\"ld70c578-qrss8djJ\">一个投放创意必须从属于一个计划。</li></ul></div>",
