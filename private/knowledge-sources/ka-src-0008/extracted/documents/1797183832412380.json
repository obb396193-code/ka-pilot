  "abstract": "{\"business_domain\":[\"巨量营销-单元管理\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"本接口支持删除一条营销下存在的素材，仅支持删除「巨量营销」账户下的营销素材，包括图片、视频、图文素材，不支持删除已删除状态的素材和将营销下素材全部删除。\",\"id\":\"promotion.material.delete\",\"interface_path\":\"/open_api/v3.0/promotion/material/delete/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1797183832412380\",\"related_docs\":[{\"id\":\"get.access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要通过此接口获取授权access_token\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"appendix.return_code\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"reason\":\"应答字段中的返回码和返回信息需参考此文档\",\"relation\":\"配合接口\",\"title\":\"【附录-返回码】\"}],\"risk_level\":\"high\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1797183832412380\",\"title\":\"删除营销下素材\"}",
