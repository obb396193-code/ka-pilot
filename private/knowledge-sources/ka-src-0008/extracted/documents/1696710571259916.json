  "abstract": "{\"business_domain\":[\"巨量营销-人群定向、DMP 与 RTA\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"用户可以通过调用此接口，查询客户下的指定人群包信息。支持查询已删除的人群包信息。人群包创建时间大于6个月，且近6个月没绑定计划以及产生消耗，该人群包会过期，对于过期的人群包，只能重新建包，再次推送。\",\"id\":\"ad.dmp_custom_audience.read\",\"interface_path\":\"/open_api/2/dmp/custom_audience/read/\",\"method\":\"GET\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1696710571259916\",\"related_docs\":[{\"id\":\"ad.get_access_token\",\"path\":\"\",\"reason\":\"调用此接口需要授权access-token，获取方法见该接口文档\",\"relation\":\"前置接口\",\"title\":\"获取Access-Token\"},{\"id\":\"ad.appendix_return_code\",\"path\":\"\",\"reason\":\"该接口应答参数中的返回码和返回信息详见此文档\",\"relation\":\"配合接口\",\"title\":\"附录-返回码\"},{\"id\":\"ad.dmp_related_custom_audience_source\",\"path\":\"\",\"reason\":\"该接口应答参数中的人群包来源详见此文档\",\"relation\":\"配合接口\",\"title\":\"附录-DMP相关-人群包来源\"},{\"id\":\"ad.dmp_related_custom_audience_status\",\"path\":\"\",\"reason\":\"该接口应答参数中的人群包状态详见此文档\",\"relation\":\"配合接口\",\"title\":\"附录-DMP相关-人群包状态\"},{\"id\":\"ad.dmp_related_dmp_push_status\",\"path\":\"\",\"reason\":\"该接口应答参数中的推送状态详见此文档\",\"relation\":\"配合接口\",\"title\":\"附录-DMP相关-DMP推送状态\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1696710571259916\",\"title\":\"人群包详细信息\"}",
