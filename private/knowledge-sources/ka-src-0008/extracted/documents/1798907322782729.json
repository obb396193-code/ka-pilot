  "abstract": "{\"business_domain\":[\"代理商-财务管理\",\"巨量营销-资金、钱包与结算\"],\"business_line\":[\"代理商\",\"巨量营销\"],\"capability_summary\":\"查询账户对应公司下的钱包关系，需提供账户ID和账户类型。授权access_token可通过【获取Access token】接口获取，返回码和返回信息详见【附录-返回码】。\",\"id\":\"shared_wallet.account_relation.get\",\"interface_path\":\"/open_api/v3.0/shared_wallet/account_relation/get/\",\"method\":\"GET\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1798907322782729\",\"related_docs\":[{\"id\":\"access_token.get\",\"path\":\"\",\"reason\":\"需要先获取授权access_token才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"appendix.return_code\",\"path\":\"\",\"reason\":\"此接口的返回码和返回信息需参考该文档\",\"relation\":\"配合文档\",\"title\":\"附录-返回码\"}],\"risk_level\":\"high\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1798907322782729\",\"title\":\"共享钱包-查询账户对应公司下的钱包关系\"}",
