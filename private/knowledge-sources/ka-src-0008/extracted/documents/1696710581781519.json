%20%20%20String%20access_token%20%3D%20%5C%22xxx%5C%22%3B%5Cn%20%20%20%20final%20Long%20advertiser_id%20%3D%200L%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E8%AF%B7%E6%B1%82%E5%9C%B0%E5%9D%80%5Cn%20%20%20%20String%20open_api_url_prefix%20%3D%20%5C%22https%3A%2F%2Fad.oceanengine.com%2Fopen_api%2F2%2F%5C%22%3B%5Cn%20%20%20%20String%20uri%20%3D%20%5C%22dpa%2Ftemplate%2Fget%2F%5C%22%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E8%AF%B7%E6%B1%82%E5%8F%82%E6%95%B0%5Cn%20%20%20%20Map%20data%20%3D%20new%20HashMap()%7B%5Cn%20%20%20%20%20%20%20%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20put(%5C%22advertiser_id%5C%22%2C%20advertiser_id)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20put(%5C%22page%5C%22%2C%201)%3B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20put(%5C%22page_size%5C%22%2C%2010)%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%7D%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E6%9E%84%E9%80%A0%E8%AF%B7%E6%B1%82%5Cn%20%20%20%20HttpEntityEnclosingRequestBase%20httpEntity%20%3D%20new%20HttpEntityEnclosingRequestBase()%20%7B%5Cn%20%20%20%20%20%20%20%20%40Override%5Cn%20%20%20%20%20%20%20%20public%20String%20getMethod()%20%7B%5Cn%20%20%20%20%20%20%20%20%20%20%20%20return%20%5C%22GET%5C%22%3B%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%7D%3B%5Cn%5Cn%20%20%20%20httpEntity.setHeader(%5C%22Access-Token%5C%22%2Caccess_token)%3B%5Cn%5Cn%20%20%20%20CloseableHttpResponse%20response%20%3D%20null%3B%5Cn%20%20%20%20CloseableHttpClient%20client%20%3D%20null%3B%5Cn%5Cn%20%20%20%20try%20%7B%5Cn%20%20%20%20%20%20%20%20client%20%3D%20HttpClientBuilder.create().build()%3B%5Cn%20%20%20%20%20%20%20%20httpEntity.setURI(URI.create(open_api_url_prefix%20%2B%20uri))%3B%5Cn%20%20%20%20%20%20%20%20httpEntity.setEntity(new%20StringEntity(JSONObject.toJSONString(data)%2C%20ContentType.APPLICATION_JSON))%3B%5Cn%5Cn%20%20%20%20%20%20%20%20response%20%3D%20client.execute(httpEntity)%3B%5Cn%20%20%20%20%20%20%20%20if%20(response%20!%3D%20null%20%26amp%3B%26amp%3B%20response.getStatusLine().getStatusCode()%20%3D%3D%20200)%20%7B%5Cn%20%20%20%20