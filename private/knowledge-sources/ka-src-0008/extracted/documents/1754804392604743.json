  "abstract": "{\"business_domain\":[\"巨量营销-线索、表单与互动\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"该接口可用于删除屏蔽用户，支持根据抖音id或昵称关键词进行删除操作。获取授权access_token可使用【获取Access token】接口，应答返回码和信息可参考【附录-返回码】。\",\"id\":\"tools.aweme_banned.delete\",\"interface_path\":\"/open_api/v3.0/tools/aweme_banned/delete/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1754804392604743\",\"related_docs\":[{\"id\":\"tools.access_token.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权access_token才能调用本接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"appendix.return_code.get\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710760866831\",\"reason\":\"本接口应答的返回码和返回信息需要参考该文档\",\"relation\":\"配合文档\",\"title\":\"附录-返回码\"}],\"risk_level\":\"medium\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1754804392604743\",\"title\":\"删除屏蔽用户\"}",
  "content": "<div class=\"qz-editor-engine am-engine\" data-element=\"root\" data-listener-added_fe0afcc5=\"true\"><p data-id=\"p838747a-1kfniFOp\">删除屏蔽用户</p>\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201751443290355723%2C%20%22docLibId%22%3A%201743864733602830%7D\">\n \n</div>\n<h3 data-id=\"h6f20189-wIW8c5El\" id=\"link-0\">请求地址</h3><p data-id=\"p838747a-oYaUK8Rp\"><a href=\"https://api.oceanengine.com/open_api/v3.0/tools/aweme_banned/delete/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\"><span style=\"color: #333333;\">https://api.oceanengine.com/open_api/v3.0/tools/aweme_banned/delete/</span></a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1754804392604743\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h3 data-id=\"h6f20189-tNsizE2y\" id=\"link-1\">请求方法</h3><p data-id=\"p838747a-zLMgO4nJ\">POST</p><h3 data-id=\"h6f20189-nyUXutHi\" id=\"link-2\">Header</h3><div class=\"table-container qz-card-type-block\"><table class=\"data-table data-table-row-header\" data-custom=\"false\" data-id=\"t615773a-ZBR0UTK3\" data-transient-attributes=\"class\" data-width=\"100%\" style=\"width: 100%; outline: none; border-collapse: collapse; max-width: 100%;\"><colgroup data-id=\"c7104f7d-ab3nH3bP\"><col data-id=\"c0bb105d-EmRD5iEi\" span=\"1\" width=\"33.33333333333333%\"/><col data-id=\"c0bb105d-mliSAjF5\" span=\"1\" width=\"33.33333333333333%\"/><col data-id=\"c0bb105d-FJnxRM86\" span=\"1\" width=\"33.33333333333333%\"/></colgroup><tbody data-id=\"t6d5e859-i3pWC6a0\"><tr data-id=\"t31e458f-NiksNdUZ\" style=\"height: 30px;\"><td data-id=\"t8c0e6ab-8SWN2i4R\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-0KbpINMj\">字段</p></td><td data-id=\"t8c0e6ab-sE7X5bW9\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-ybFFFfir\">类型</p></td><td class=\"table-last-row\" data-id=\"t1b895c3-A8739kji\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-gFUBYWEj\">描述</p></td></tr><tr data-id=\"t31e458f-rBpk0Xxa\" style=\"height: 30px;\"><td data-id=\"tff4a61f-Ts7dJX59\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-tHQeHE65\">Access-Token<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">必填</span></span></p></td><td data-id=\"tff4a61f-IoLPlmg1\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-HLY1DlAt\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"td0a4e23-oVystjdB\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-R1qH8Sbt\">授权access_token，可以通过<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">【获取Access token】</a>接口获取</p></td></tr><tr data-id=\"t31e458f-HgUjov7Q\" style=\"height: 30px;\"><td class=\"table-last-column\" data-id=\"t498e912-WZDYeMTD\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-H8NHewPD\">Content-Type<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">必填</span></span></p></td><td class=\"table-last-column\" data-id=\"t498e912-qCdMqJIV\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-h3KiAHhZ\">string</p></td><td class=\"table-last-column table-last-row\" colspan=\"1\" data-id=\"tb871063-8HI7WQgp\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-UWDUKE5I\">请求消息类型<br/>允许值: <code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">application/json</code></p></td></tr></tbody></table></div><h3 data-id=\"h6f20189-tZG2gx7T\" id=\"link-3\">请求参数</h3><div class=\"table-container qz-card-type-block\"><table class=\"data-table data-table-row-header\" data-custom=\"false\" data-id=\"t615773a-gfAZmUqq\" data-transient-attributes=\"class\" data-width=\"100%\" style=\"width: 100%; outline: none; border-collapse: collapse; max-width: 100%;\"><colgroup data-id=\"c7104f7d-Xc65WWjH\"><col data-id=\"c0bb105d-ZgK0DgvI\" span=\"1\" width=\"33.33333333333333%\"/><col data-id=\"c0bb105d-4jULMDmp\" span=\"1\" width=\"33.33333333333333%\"/><col data-id=\"c0bb105d-41lKPOJ1\" span=\"1\" width=\"33.33333333333333%\"/></colgroup><tbody data-id=\"t6d5e859-mlTgWWgd\"><tr data-id=\"t31e458f-az2Vv4wg\" style=\"height: 30px;\"><td data-id=\"t8c0e6ab-ngFfI235\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-oGMW6Q0H\">字段</p></td><td data-id=\"t8c0e6ab-rZWObFAB\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-9aH1PIqj\">类型</p></td><td class=\"table-last-row\" data-id=\"t1b895c3-03VGOpTa\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: top; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-UY9blE2k\">描述</p></td></tr><tr data-id=\"t31e458f-42QXYUjt\" style=\"height: 30px;\"><td data-id=\"tff4a61f-NS2ee7rl\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-VQcNmFFd\">advertiser_id<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">必填</span></span></p></td><td data-id=\"tff4a61f-hMp742pL\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-wdpVI1kQ\">number</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"td0a4e23-TSzRlhFQ\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-pJGT6wzB\">客户id</p></td></tr><tr data-id=\"t31e458f-Y14SENQT\" style=\"height: 30px;\"><td data-id=\"tff4a61f-vZmODKjI\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-mIQ1mEQ2\">banned_type<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">必填</span></span></p></td><td data-id=\"tff4a61f-Z5LNgrOZ\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-sHORzLU9\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"td0a4e23-4x3Xh3tM\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-x8GzOxy6\">屏蔽类型， 可选值:</p><ul data-id=\"u738a58b-L3GJeeLQ\"><li data-id=\"ld70c578-gTi0D4ZM\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">AWEME_TYPE</code>: 根据抖音id屏蔽</li><li data-id=\"ld70c578-BBm1Eg3f\"><code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">CUSTOM_TYPE</code>: 自定义规则，根据昵称关键词屏蔽</li></ul><p data-id=\"p838747a-abRKbMbX\"><br/></p></td></tr><tr data-id=\"t31e458f-3RqC3pst\" style=\"height: 30px;\"><td data-id=\"tff4a61f-vIpPo2Zi\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-Ncp7lMJj\">aweme_id</p></td><td data-id=\"tff4a61f-gNpKVDt7\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-Dni4PQMv\">string</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"td0a4e23-OppMXCiI\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-MckITrpY\">抖音号，当is_apply_to_adv不传或为false时，aweme_id生效</p></td></tr><tr data-id=\"t31e458f-FsnozaT2\" style=\"height: 30px;\"><td data-id=\"tff4a61f-2Jz9TPXk\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-7ZpI7ih7\">is_apply_to_adv</p></td><td data-id=\"tff4a61f-5EUtvJKb\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-sCSJweuf\">bool</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"td0a4e23-ufP6PLtB\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-UaDTwPdt\">是否应用于当前账户，当is_apply_to_adv不传或为false时，aweme_id生效</p></td></tr><tr data-id=\"t31e458f-uBoNQuOp\" style=\"height: 30px;\"><td data-id=\"tff4a61f-WycoyWk1\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-EU8XX6mK\">nickname_keywords<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">条件必填</span></span></p></td><td data-id=\"tff4a61f-pAExQgk1\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-6sAirHXA\">string[]</p></td><td class=\"table-last-row\" colspan=\"1\" data-id=\"td0a4e23-FsezX6is\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-G0Czs70a\">抖音昵称关键词列表，当banned_type为<code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">CUSTOM_TYPE</code>时必填，关键词长度不大于20个字；每次最多传50个关键词。</p></td></tr><tr data-id=\"t31e458f-39wpPdiK\" style=\"height: 30px;\"><td class=\"table-last-column\" data-id=\"t498e912-rsNLY7NC\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-BAWoM2ZQ\">aweme_user_ids<span style=\"color: #338aff;\"><span style=\"background-color: #ebf3ff;\">条件必填</span></span></p></td><td class=\"table-last-column\" data-id=\"t498e912-bT1A13PT\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-CVCFW05l\">string[]</p></td><td class=\"table-last-column table-last-row\" colspan=\"1\" data-id=\"tb871063-9XFSDeTg\" data-transient-attributes=\"table-cell-selection\" style=\"vertical-align: middle; min-width: auto; overflow-wrap: break-word; border: 1px solid rgb(222, 224, 227);\"><p data-id=\"p838747a-cbXcgBsq\">抖音用户id列表，传入屏蔽用户的抖音号；当banned_type为<code style=\"font-family: monospace; font-size: inherit; background-color: rgba(0, 0, 0, 0.06); padding: 0px 2px; border-radius: 6px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">AWEME_TYPE</code>时必填，每次最多传50个抖音id，纯数字id不能以0开头；一个抖音号最多屏蔽5000个抖音ID。</p></td></tr></tbody></table></div><h3 data-id=\"h6f20189-jwDdVpZV\" id=\"link-4\">请求示例</h3>