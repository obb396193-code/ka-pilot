  "abstract": "{\"business_domain\":[\"巨量营销-转化资产与事件管理\"],\"business_line\":[\"巨量营销\"],\"capability_summary\":\"此接口用于创建投放账户下资产，需授权 access_token，支持多种资产类型，如 APP、三方落地页、快应用等。\",\"id\":\"event_manager.assets.create\",\"interface_path\":\"/open_api/2/event_manager/assets/create/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1850398228888576\",\"related_docs\":[{\"id\":\"get.access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"需要先获取授权 access_token 才能调用此接口\",\"relation\":\"前置接口\",\"title\":\"获取Access token\"},{\"id\":\"get.byte_app_info\",\"path\":\"\",\"reason\":\"创建字节小程序资产时需要通过此工具获取字节小程序资产 ID\",\"relation\":\"前置接口\",\"title\":\"获取字节小程序/小游戏\"}],\"risk_level\":\"medium\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1850398228888576\",\"title\":\" 创建事件资产\"}",
