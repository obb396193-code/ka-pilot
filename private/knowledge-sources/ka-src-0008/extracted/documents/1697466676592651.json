{
  "abstract": "{\"business_domain\":[\"巨量千川-素材管理\",\"巨量营销-素材与创意\"],\"business_line\":[\"巨量千川\",\"巨量营销\"],\"capability_summary\":\"用户可以通过此接口上传和营销相关的素材视频，支持文件上传和网址上传两种方式。需注意若同一素材已进行上传，重新上传不会改名，且由于素材库存在分钟级延迟，上传素材后请勿立即获取并创建计划。配合接口有【获取Access-Token】。\",\"id\":\"ad.file_video.ad.upload\",\"interface_path\":\"/open_api/2/file/video/ad/\",\"method\":\"POST\",\"official_url\":\"https://open.oceanengine.com/skiff/api/doc/client/markdown/get/?language=CHINESE\\u0026doc_id=1697466676592651\",\"related_docs\":[{\"id\":\"get_access_token\",\"path\":\"https://open.oceanengine.com/labels/7/docs/1696710505596940\",\"reason\":\"请求此接口需要授权access-token，获取方法见【获取Access-Token】接口文档\",\"relation\":\"前置接口\",\"title\":\"获取Access-Token\"}],\"risk_level\":\"low\",\"schema_url\":\"https://open.oceanengine.com/skiff/api/doc/client/schema/markdown/get/?doc_id=1697466676592651\",\"supplemental_knowledge\":[],\"title\":\"上传视频素材\"}",
