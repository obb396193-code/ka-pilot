22d%3B%5C%22%3E%E5%B7%A8%E9%87%8F%E5%8D%83%E5%B7%9D%3C%2Fspan%3E%E4%BB%A3%E7%90%86%E5%95%86%E5%AE%8C%E6%88%90%E6%8E%88%E6%9D%83%E5%90%8E%EF%BC%8C%E8%B0%83%E7%94%A8%E6%8E%A5%E5%8F%A3%E4%B8%8A%E4%BC%A0%E8%A7%86%E9%A2%91%E7%B4%A0%E6%9D%90%E8%87%B3%E5%B7%A8%E9%87%8F%E6%96%B9%E8%88%9F%3C%2Fli%3E%3C%2Ful%3E%22%7D\"><div class=\"QZCard-container\" style=\"border-color: #fed4a4;background-color:#fff5eb;\"><div class=\"QZCard-icon\"><svg height=\"22\" p-id=\"13148\" version=\"1.1\" viewbox=\"0 0 1024 1024\" width=\"22\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M833.5 330.5C833.5 153 689.6 7.6 512 7.6S190.5 153 190.5 330.5c0 70.3 37.3 161 97.2 227.9 59.4 66.3 103.5 177.9 103.5 266.9v34.9h241.6v-34.6c0-89 44.1-200.4 103.2-266.9 60.1-67.6 97.5-166.4 97.5-228.2z\" fill=\"#FFC807\" p-id=\"13149\"></path><path d=\"M636.5 790.6l-193.9-268L596.4 202l199.2 266.4c-17.4 36.4-39.3 67.4-63.9 95.2C685.3 621 664.1 671.1 644 741l-7.5 49.6z\" fill=\"#FFB300\" p-id=\"13150\"></path><path d=\"M499.5 378.3h-82.7c-12.6 0-21.4-12.7-16.8-24.5l59.2-153c2.7-6.9 9.4-11.5 16.8-11.5h105c13.6 0 22.3 14.5 15.9 26.5l-81.5 153c-3.2 5.8-9.3 9.5-15.9 9.5z\" fill=\"#FFF8E1\" p-id=\"13151\"></path><path d=\"M466.2 518.3l160-171c12-12.8 2.9-33.7-14.6-33.7h-105c-8.7 0-16.4 5.6-19.1 13.9l-55 171c-6.6 20.4 19.1 35.5 33.7 19.8z\" fill=\"#FFF8E1\" p-id=\"13152\"></path><path d=\"M593.6 1016.4H430.4c-5.7 0-10.9-3.7-14-9.8l-22.2-44.2h235.6l-22.2 44.2c-3.1 6.1-8.3 9.8-14 9.8z\" fill=\"#455A64\" p-id=\"13153\"></path><path d=\"M625.7 980.4H398.3c-22.1 0-40.1-17.9-40.1-40.1V776.7c0-22.1 17.9-40.1 40.1-40.1h227.5c22.1 0 40.1 17.9 40.1 40.1v163.7c-0.1 22.1-18 40-40.2 40z\" fill=\"#ECEFF1\" p-id=\"13154\"></path><path d=\"M539.8 808.6H359v-36h180.8c9.9 0 18 8.1 18 18 0 10-8.1 18-18 18zM359 840.1h306v36H359zM665 943.6H494.8c-9.9 0-18-8.1-18-18s8.1-18 18-18H665v36z\" fill=\"#CFD8DC\" p-id=\"13155\"></path></svg></div><div class=\"QZCard-editor-container\"><p data-id=\"p838747a-DfziiAsu\">代理商可以通过此接口将「首发素材」上传视频素材至巨量方舟，上传后「首发素材」即可自动完成保护（前置需要先完成整体保护授权，参考详细文档介绍<a href=\"https://bytedance.larkoffice.com/docx/Fpn4dn4ldoAHrmxrCEfcpWO1n8f\" target=\"_blank\">「搬运治理-首发保护」说明手册（可对外）</a>）。<strong>保护后系统将根据代理授权范围识别搬运素材生效打压，避免其他方抢夺代理的流量。</strong></p><ul data-id=\"u738a58b-Y0TbEZ6Y\"><li data-id=\"ld70c578-dFlZf0fm\"><strong>注意1：</strong>建议代理商务必将自己制作的「首发素材」<span style=\"color: #f5222d;\">先通过本接口上传到方舟平台</span>（素材才可能按照代理授权生效，否则可能会被客户先做授权保护），避免素材被其他方抢先保护。</li><li data-id=\"ld70c578-Q3LYFGpB\"><strong>注意2：</strong>非首发素材，即使进行上传也不会生效授权保护（<a href=\"https://bytedance.larkoffice.com/docx/IYTId7xsEo8p3ax3YkHcTHdxnNb\" target=\"_blank\">点此查看「首发素材」相关说明</a>）</li><li data-id=\"ld70c578-wOh8FALu\"><strong>注意3：</strong>调用接口上传的素材可在“方舟-优化-新版素材管理-公司素材库”查看</li><li data-id=\"ld70c578-cOFfD4hA\"><strong>注意4：</strong>本接口支持<span style=\"color: #f5222d;\">巨量营销</span>代理商、<span style=\"color: #f5222d;\">巨量千川</span>代理商完成授权后，调用接口上传视频素材至巨量方舟</li></ul></div></div></div><h1 data-id=\"h346b9f0-GfZREoCU\" id=\"h346b9f0-GfZREoCU\"><img data-auto=\"true\" data-type=\"inline\" src=\"https://p26-business-sign.byteadimg.com/tos-cn-i-yvqzo4lhg5/13d096527f7a4e4fa5e17479c03d2160~noop.image?rk3s=d3394059&amp;x-expires=2032949467&amp;x-signature=FIKk%2Bu04jUuSzKyeVN%2FcSNbU2Fg%3D\" style=\"width: 2000px; visibility: visible; height: auto;\"/></h1>\n<div class=\"qz-api-metadata\" data-type=\"apimetadata\" data-value=\"data:%7B%22interfaceId%22%3A%201792562391010368%2C%20%22docLibId%22%3A%201743864733602830%7D\">\n \n</div>\n<h1 data-id=\"h346b9f0-b7kR17RY\" id=\"h346b9f0-b7kR17RY\">请求地址</h1><p data-id=\"p838747a-81oJ6v0f\"><a href=\"https://api.oceanengine.com/open_api/2/file/video/agent/\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\" target=\"blank\">https://api.oceanengine.com/open_api/2/file/video/agent/</a><a href=\"https://open.oceanengine.com/tools/visual_debug.html?docId=1792582253929536\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">可视化调试</a><a href=\"https://open.oceanengine.com/labels/7/docs/1773083358100557\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">SDK下载</a><a href=\"https://open.oceanengine.com/labels/7/docs/1847394521222599\" style=\"font-size: 12px;color: #fff; display: inline-block; padding: 2px 8px;border-radius: 4px;background: #2a55e5;margin-left: 8px; color: #fff !important;\" target=\"_blank\">MCP调用</a></p><h1 data-id=\"h346b9f0-CKcGHYM4\" id=\"h346b9f0-CKcGHYM4\">请求方法</h1><p data-id=\"p838747a-UY3GgnOg\">POST</p><h1 data-id=\"h346b9f0-i5KpCSES\" id=\"h346b9f0-i5KpCSES\">Header</h1><section class=\"table api-table\" data-tabletype=\"header\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 250px;\" width=\"250\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Access-Token</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-xcMHBl0N\">授权access_token，可以通过【<a href=\"https://open.oceanengine.com/labels/7/docs/1696710505596940\">获取Access token</a>】接口获取</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">Content-Type</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-6LiV5nrr\">请求消息类型<br/>允许值: <code>application/json</code></p></section></section></section><h1 data-id=\"h346b9f0-rYTF5JDk\" id=\"h346b9f0-rYTF5JDk\">请求参数</h1><section class=\"table api-table\" data-tabletype=\"request\" data-type=\"apitable\"><section class=\"row header\"><section class=\"col\" style=\"width: 205px;\" width=\"205\"><p>字段</p></section><section class=\"col\" style=\"width: 120px;\" width=\"120\"><p>类型</p></section><section class=\"col\"><p>描述</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">agent_id</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>number</p></section><section class=\"col description\"><p data-id=\"p838747a-MG2CXVKp\">代理商id</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">upload_type</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-1YCUwejX\">视频上传方式，暂仅支持文件上传，可选值: </p><ul data-id=\"u738a58b-IgNCdOTj\"><li data-id=\"ld70c578-N39HZaWF\"><code>UPLOAD_BY_FILE</code> 文件上传（<span style=\"color: #f5222d;\">默认值</span>）</li><li data-id=\"ld70c578-S8fkLcbE\"><code>UPLOAD_BY_URL</code> url上传</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">video_file</p></section></section><section class=\"col col_param_type\"><p>file</p></section><section class=\"col description\"><p data-id=\"p838747a-wzPhuEO6\">视频文件数据，upload_type为<code>UPLOAD_BY_FILE</code>必填</p><ul data-id=\"u738a58b-0E3OKggd\"><li data-id=\"ld70c578-SDBlU2MZ\">文件支持格式：mp4,mpeg,3gp,avi</li><li data-id=\"ld70c578-DC55Z6MJ\">文件大小要求：＜1000M</li><li data-id=\"ld70c578-WDdCfOBi\">文件分辨率要求：&gt;=1280*720</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">video_url</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\">视频URL地址，upload_type为<code>UPLOAD_BY_URL</code>必传<p data-id=\"p838747a-PjHBfZgW\">只支持连山tos地址，接入流程详见：<a href=\"https://ad.oceanengine.com/cloud/doc/1756427622851659\" target=\"_blank\">https://ad.oceanengine.com/cloud/doc/1756427622851659</a></p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">video_signature</p></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-d1CE90rv\">视频的md5值(用于服务端校验) </p><p data-id=\"p838747a-5m8Yq0g2\">upload_type为<code>UPLOAD_BY_FILE</code>文件上传时必填</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">file_name</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>string</p></section><section class=\"col description\"><p data-id=\"p838747a-RSDIbvV0\">视频上传名称</p></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">is_aigc</p></section></section><section class=\"col col_param_type\"><p>bool</p></section><section class=\"col description\"><p data-id=\"p838747a-CltxpdPn\">是否为AIGC生成，允许值：</p><ul data-id=\"u738a58b-41L3PGMh\"><li data-id=\"ld70c578-MC1UTC6S\">false （默认值）</li><li data-id=\"ld70c578-fcIMMMme\">true</li></ul></section></section><section class=\"row body\" data-level=\"0\" style=\"display: table-row\"><section class=\"col\" style=\"padding-left: 16px;\"><section class=\"col_params\"><p class=\"col_params_name\">is_need_auth</p><section class=\"col_params_tag\"><section class=\"param-tag primary\">必填</section></section></section></section><section class=\"col col_param_type\"><p>bool</p></section><section class=\"col description\"><p data-id=\"p838747a-xRYrmY5w\">标注是否允许生效代理商公司的首发保护授权范围</p><p data-id=\"p838747a-xCOaCdht\">（允许授权的前提是素材是代理商自产且与客户达成了一致）</p><ul data-id=\"u738a58b-UQmKA01j\"><li data-id=\"ld70c578-i8HaLWlX\">true (默认值）</li><li data-id=\"ld70c578-FED8biLh\">false (仅用于素材前测时请输入false)</li></ul></section></section></section><h1 data-id=\"h346b9f0-xrkaF1MB\" id=\"h346b9f0-xrkaF1MB\">请求示例</h1><div class=\"qz-codeblock_view qz-mulit-codeblock qz-card-type-block\" data-type=\"multicodeblock\" data-value=\"data:%7B%22langs%22%3A%5B%7B%22language%22%3A%22python%22%2C%22text%22%3A%22%23%20coding%3Dutf-8%5Cnimport%20json%5Cnimport%20requests%5Cn%5Cnfrom%20six%20import%20string_types%5Cnfrom%20six.moves.urllib.parse%20import%20urlencode%2C%20urlunparse%20%20%23%20noqa%5Cn%5CnACCESS_TOKEN%20%3D%20%5C%22xxx%5C%22%5CnPATH%20%3D%20%5C%22%2Fopen_api%2F2%2Ffile%2Fvideo%2Fagent%2F%5C%22%5Cn%5Cn%5Cndef%20build_url(path%2C%20query%3D%5C%22%5C%22)%3A%5Cn%20%20%20%20%23%20type%3A%20(str%2C%20str)%20-%3E%20str%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Build%20request%20URL%5Cn%20%20%20%20%3Aparam%20path%3A%20Request%20path%5Cn%20%20%20%20%3Aparam%20query%3A%20Querystring%5Cn%20%20%20%20%3Areturn%3A%20Request%20URL%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20scheme%2C%20netloc%20%3D%20%5C%22https%5C%22%2C%20%5C%22api.oceanengine.com%5C%22%5Cn%20%20%20%20return%20urlunparse((scheme%2C%20netloc%2C%20path%2C%20%5C%22%5C%22%2C%20query%2C%20%5C%22%5C%22))%5Cn%5Cndef%20post(json_str)%3A%5Cn%20%20%20%20%23%20type%3A%20(str)%20-%3E%20dict%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20Send%20POST%20request%5Cn%20%20%20%20%3Aparam%20json_str%3A%20Args%20in%20JSON%20format%5Cn%20%20%20%20%3Areturn%3A%20Response%20in%20JSON%20format%5Cn%20%20%20%20%5C%22%5C%22%5C%22%5Cn%20%20%20%20url%20%3D%20build_url(PATH)%5Cn%20%20%20%20args%20%3D%20json.loads(json_str)%5Cn%20%20%20%20headers%20%3D%20%7B%5Cn%20%20%20%20%20%20%20%20%5C%22Access-Token%5C%22%3A%20ACCESS_TOKEN%2C%5Cn%20%20%20%20%20%20%20%20%5C%22Content-Type%5C%22%3A%20%5C%22application%2Fjson%5C%22%2C%5Cn%20%20%20%20%7D%5Cn%20%20%20%20rsp%20%3D%20requests.post(url%2C%20headers%3Dheaders%2C%20json%3Dargs)%5Cn%20%20%20%20return%20rsp.json()%5Cn%20%20%20%20%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20agent_id%20%3D%20AGENT_ID%5Cn%20%20%20%20upload_type%20%3D%20UPLOAD_TYPE%5Cn%20%20%20%20video_file%20%3D%20VIDEO_FILE%5Cn%20%20%20%20video_url%20%3D%20VIDEO_URL%5Cn%20%20%20%20video_signature%20%3D%20VIDEO_SIGNATURE%5Cn%20%20%20%20file_name%20%3D%20FILE_NAME%5Cn%20%20%20%20is_aigc%20%3D%20IS_AIGC%5Cn%20%20%20%20is_need_auth%20%3D%20IS_NEED_AUTH%5Cn%5Cn%20%20%20%20%23%20Args%20in%20JSON%20format%5Cn%20%20%20%20my_args%20%3D%20%5C%22%7B%5C%5C%5C%22agent_id%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22upload_type%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22video_file%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22video_url%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22video_signature%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22file_name%5C%5C%5C%22%3A%20%5C%5C%5C%22%25s%5C%5C%5C%22%2C%20%5C%5C%5C%22is_aigc%5C%5C%5C%22%3A%20%5C%5C%