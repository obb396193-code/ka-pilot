json())%3B%5Cn%20%20%7D%20catch%20(e)%20%7B%5Cn%20%20%20%20console.log('send%20weixin%20failed'%2C%20e.message)%3B%5Cn%20%20%7D%5Cn%7D%5Cn%2F%2F%20%E8%8E%B7%E5%8F%96%E5%BD%93%E5%A4%A9%E7%9A%84%E6%97%A5%E6%9C%9F%5Cnfunction%20getTodayDate()%20%7B%5Cn%20%20return%20Utils.dayjs().format('YYYY-MM-DD')%3B%5Cn%7D%5Cn%2F%2F%20%E8%8E%B7%E5%8F%96%E5%BD%93%E4%B8%8B%E7%9A%84%E6%97%A5%E6%9C%9F%E6%97%B6%E9%97%B4%5Cnfunction%20getTime()%20%7B%5Cn%20%20return%20Utils.dayjs().format('YYYY-MM-DD%20HH%3Amm')%3B%5Cn%7D%5Cn%5Cn%2F%2F%20%E4%B8%8D%E8%A6%81%E4%BF%AE%E6%94%B9%EF%BC%81%EF%BC%81%EF%BC%81%5Cnfunction%20checkConfig()%20%7B%5Cn%20%20if%20(CONFIG.webHookURL%20%3D%3D%20'')%5Cn%20%20%20%20throw%20Error(%5Cn%20%20%20%20%20%20'%E8%AF%B7%E5%9C%A8%E9%85%8D%E7%BD%AE%E4%B8%AD%E5%A1%AB%E5%85%A5%E9%A3%9E%E4%B9%A6%E6%9C%BA%E5%99%A8%E4%BA%BAwebhook%E5%9C%B0%E5%9D%80%E3%80%82%E5%8F%82%E8%80%83%E6%AD%A4%E6%96%87%E8%8E%B7%E5%8F%96%EF%BC%9Ahttps%3A%2F%2Fopen.feishu.cn%2Fdocument%2Fclient-docs%2Fbot-v3%2Fadd-custom-bot%20%E5%A6%82%E8%A6%81%E9%85%8D%E7%BD%AE%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%9C%BA%E5%99%A8%E4%BA%BA%EF%BC%8C%E5%8F%AF%E5%8F%82%E8%80%83%EF%BC%9Ahttps%3A%2F%2Fopen.work.weixin.qq.com%2Fhelp2%2Fpc%2F14931'%5Cn%20%20%20%20)%3B%5Cn%20%20if%20(CONFIG.advIds.length%20%3D%3D%200)%20throw%20Error('%E8%AF%B7%E5%85%88%E9%85%8D%E7%BD%AEadvId')%3B%5Cn%20%20CONFIG.type%20%3D%20'lark'%3B%5Cn%20%20if%20(CONFIG.webHookURL.includes('weixin'))%20%7B%5Cn%20%20%20%20CONFIG.type%20%3D%20'weixin'%3B%5Cn%20%20%20%20const%20regex%20%3D%20%2F(%3F%3A%5B%3F%26%5D)key%3D(%5B%5E%26%5D%2B)%2F%3B%5Cn%20%20%20%20const%20match%20%3D%20CONFIG.webHookURL.match(regex)%3B%5Cn%20%20%20%20if%20(!match)%20%7B%5Cn%20%20%20%20%20%20throw%20Error('weixin%20webhook%E6%A0%BC%E5%BC%8F%E9%94%99%E8%AF%AF')%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20CONFIG.weixinKey%20%3D%20match%5B1%5D%3B%5Cn%20%20%7D%5Cn%7D%5Cn%22%2C%22id%22%3A%229q2Zo%22%2C%22type%22%3A%22block%22%7D\"><div class=\"qz-codeblock_view_contain qz-codeblock_inner\"><div class=\"qz-codeblock_view_scroll qz-codeblock-scroll\" style=\"height: 601px; max-height: 601px; overflow-y: scroll;\"><div class=\"qz-codeblock_content javascript\"></div></div></div></div><h1 id=\"h346b9f0-OaPgkM44\" data-id=\"h346b9f0-OaPgkM44\">配套飞书卡片模板</h1><p data-id=\"pa028eb2-XdSDm4BJ\" style=\"text-align: center;\"><img src=\"https://p26-business-sign.byteadimg.com/tos-cn-i-yvqzo4lhg5/07ce92004fb448c8a243f7b9f8a85dcd~noop.image?rk3s=d3394059&amp;x-expires=2026378245&amp;x-signature=mZ%2Fpwea%2BI%2Bv2rTvwebUDnkVTw60%3D\" data-auto=\"true\" style=\"width: 2000px; visibility: visible; height: auto;\" data-type=\"inline\"></p><p data-id=\"p838747a-lbmRpRps\">参考此文档<a href=\"https://open.feishu.cn/document/client-docs/bot-v3/add-custom-bot\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">https://open.feishu.cn/document/client-docs/bot-v3/add-custom-bot</a>，获取飞书群机器人的webhook后，填入代码CONFIG中。</p><p data-id=\"p838747a-x5pDDdAh\">默认已提供一个默认模板，可直接使用，若希望修改模板，可以下载<a href=\"https://lf3-openapi.byteadverts.com/obj/open-api-file-public/325df9e994ce2d8427a9591e1d68ad75.json\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">报告推送卡片模板</a>后，登录<a href=\"https://open.feishu.cn/tool/cardbuilder?from=howtoguide\" target=\"_blank\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">飞书消息卡片搭建器</a>，导入修改模板后，可以在自己的代码中应用。</p><h1 data-id=\"h346b9f0-6Vg2Tb3M\" id=\"h346b9f0-hg3KeaTg\">配套企业微信</h1><p data-id=\"p838747a-DlrVoelj\">如要配置企业微信机器人，可参考：<a target=\"_blank\" href=\"https://open.work.weixin.qq.com/help2/pc/14931\" style=\"font-size: inherit; padding: 0px 2px; line-height: inherit; overflow-wrap: break-word; text-indent: 0px;\">https://open.work.weixin.qq.com/help2/pc/14931</a>获取到企业微信机器人的webhook后，填入代码CONFIG中。</p><p data-id=\"p838747a-9YI25mPf\">配合企业微信可实现在企业微信群中，发送一个csv文件。</p><p data-id=\"p838747a-PBEEKuFX\"><img src=\"https://p3-business-sign.byteadimg.com/tos-cn-i-yvqzo4lhg5/e4f9dfe580d84135b134396e56c76611~noop.image?rk3s=d3394059&amp;x-expires=2026378913&amp;x-signature=cDRdNEc2alplsJlKkh%2F1I8%2F2aeE%3D\" data-auto=\"true\" style=\"width: 2000px; visibility: visible; height: auto;\" data-type=\"inline\"></p><h1 id=\"h346b9f0-400ZcDJl\" data-id=\"h346b9f0-i1p4N5MG\">扩展</h1><h2 id=\"h490b8bf-JG7MYHB4\" data-id=\"h490b8bf-pgSilROs\">1 支持更多指标</h2><p data-id=\"p838747a-xJwDy4nV\">你需要做几个事：</p><ol data-id=\"o9d5df12-hbmQe93F\"><li data-id=\"ld70c578-dhTeVYWQ\">若你依然使用飞书卡片，你首先需要修改推送卡片，因为默认模板我们只设计了7个参数，你可以根据你的需要扩展参数</li><li data-id=\"ld70c578-TjR4OSlf\">修改程序代码，请求需要同时增加对应的指标，并在代码中能成功打包并在最后推送发送到飞书进行发送</li></ol><h2 id=\"h490b8bf-GiJ9bNIo\" data-id=\"h490b8bf-JogkXO1J\">2 账户数据不理想后，对广告进行停投/拉空时段操作</h2><p data-id=\"p838747a-Q2XrkCB8\">暂时不支持广告数据修改，后续扩展支持，可通过【建议与反馈】向我们提出诉求</p></div>",
