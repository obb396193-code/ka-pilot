# FaaS正式部署显式设production；不得保留任何KA_DATA_DEV_*，即使值为空/false也拒绝启动。
NODE_ENV=development
DATABASE_URL=postgres://ka:ka@127.0.0.1:55432/ka
QIHANG_BASE_URL=https://qh.alibaba-inc.com/qihang/api/rta_auto/tmp/get_data
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
# 仅供无账户归属的全局只读任务；用户/账户任务不会回退到此身份
WORKER_SERVICE_QIHANG_USER_ID=

# 素材来源桥默认拒绝下载候选。只有显式列出的 host 才允许做 HEAD/单字节 Range 探针。
# 支持精确 host 与 *.example.com；不要填写协议、路径或裸 *。
MATERIAL_SOURCE_ALLOWED_HOSTS=
MATERIAL_SOURCE_MAX_BYTES=524288000
# 可选；不填时使用已验证的奇航 dataservice-api 素材池只读入口。
MATERIAL_POOL_BASE_URL=

# IdeaLab whole-video ASR Provider 默认关闭，B22 尚未接生产任务；启用时 AK 只能进入环境变量。
# Endpoint 被固定校验为已实测地址，不能改投其他 HTTPS 主机或路径。
IDEALAB_ASR_ENABLED=false
IDEALAB_AK=
IDEALAB_ASR_ENDPOINT=https://idealab.alibaba-inc.com/api/openai/v1/audio/transcriptions
IDEALAB_ASR_MAX_WAV_BYTES=5242880
IDEALAB_ASR_MAX_RESPONSE_BYTES=262144
IDEALAB_ASR_MIN_TIMEOUT_MS=30000
IDEALAB_ASR_MAX_TIMEOUT_MS=300000
IDEALAB_ASR_TIMEOUT_MULTIPLIER=3

# Agent 后端默认关闭；打开后以下 MODEL_GATEWAY_* 配置必须完整。
# Single-shot Worker deployment command only (not a browser or Data API control).
# UUID of an active personal workspace; no default owner/workspace/media fallback.
WORKER_ONCE_WORKSPACE_ID=
WORKER_ONCE_MEDIA=
WORKER_ONCE_MODE=auto
WORKER_ONCE_MAX_MS=600000
# QIHANG_BASE_URL and DATABASE_URL are required; source identity comes from DB membership/user.
# WORKER_SERVICE_QIHANG_USER_ID is deliberately ignored by worker:once.

# 网关只监听 localhost。真实模型 AK 由 Secret 服务按用户在运行时解析，禁止写进环境变量或 profiles JSON。
AGENT_ENABLED=false
AGENT_MAX_TURNS=8
AGENT_MAX_BUDGET_USD=1
AGENT_TIMEOUT_MS=120000

# KA Data shared read-only service. The mapped HTTPS origin may change when its sandbox restarts.
# Keep the reader token only in the server secret store; never expose it to browsers or logs.
# Disabled by default. Only explicit true requires the origin and reader token below.
KA_DATA_ENABLED=false
KA_DATA_BASE_URL=
KA_DATA_READER_TOKEN=
# Server-only: one shared reader is bound to one team workspace UUID.
# Missing/invalid/mismatched binding returns team SOURCE_UNAVAILABLE; no grants fallback.
KA_DATA_TEAM_WORKSPACE_ID=
KA_DATA_ACCESS_MODE=internal_trial_shared_reader
KA_DATA_TIMEOUT_MS=15000
KA_DATA_MAX_RESPONSE_BYTES=16777216

# Optional server-side diagnostic path. Roles alone never grant access.
# When enabled, list exact workspace-local principals; browsers cannot supply this entitlement.
DATA_DIAGNOSTIC_ENABLED=false
# Format: [{"workspaceId":"uuid","userId":"uuid"}]
DATA_DIAGNOSTIC_ENTITLEMENTS_JSON=

# Internal Next BFF -> data API only. Browser must never receive this token or call this port.
DATA_API_HOST=127.0.0.1
DATA_API_PORT=3101
DATA_API_INTERNAL_TOKEN=
DATA_API_MAX_REQUEST_BYTES=1048576
DATA_API_MAX_RESPONSE_BYTES=16777216

# Internal-trial login only. Production default is false; credentials contain scrypt verifier material,
# never plaintext passwords. See docs/runbooks/2026-09-04-DataAPI内网部署与环境变量.md.
INTERNAL_TEST_AUTH_ENABLED=false
# Format: [{"username":"...","passwordSalt":"base64url","passwordScrypt":"64 lowercase hex","identityId":"uuid"}]
INTERNAL_TEST_AUTH_CREDENTIALS_JSON=
AUTH_SESSION_TTL_SECONDS=28800
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:3456
MODEL_GATEWAY_CLIENT_KEY=
# 32-byte 随机值的标准 base64；仅用于加密短时 provider 凭证信封。
MODEL_GATEWAY_ENVELOPE_KEY_BASE64=
# 示例：[{
#   "id":"idealab-primary","protocol":"openai_chat_completions",
#   "baseUrl":"https://provider.example/v1","models":["model-a"],
#   "defaultModel":"model-a","taskKinds":["chat","diagnosis"]
# }]
MODEL_PROVIDER_PROFILES_JSON=
