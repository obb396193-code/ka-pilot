{
  "name": "toufang-layout-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json}' 'scripts/**/*.mjs' '*.{css,json,md,html,ts}'",
