# 默认使用 internal_api。浏览器只请求同源固定路径 /api/internal/data-query。
# NEXT_PUBLIC_KA_DATA_PROVIDER 不设置即为 internal_api。

# 仅本地开发可显式开启脱敏 Mock；production build 会拒绝 mock。
# NEXT_PUBLIC_KA_DATA_PROVIDER=mock

# 以下变量仅供 Next.js Route Handler 服务端读取，必须由内网 Secret 管理。
# 不得使用 NEXT_PUBLIC_ 前缀，也不得把真实值提交到仓库。
KA_DATA_BACKEND_ORIGIN=https://replace-with-approved-internal-origin.example
KA_DATA_SERVICE_TOKEN=

# 仅本机 development 可用的显式、服务端假权限范围。production 会强制忽略。
# 示例均为脱敏假值；不要复制真实 workspace/user/account 到仓库。
# KA_DATA_DEV_AUTH_CONTEXT_ENABLED=true
# KA_DATA_DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000024
# KA_DATA_DEV_USER_ID=demo-user
# KA_DATA_DEV_ACCOUNT_SCOPE_JSON=[{"media":"KUAISHOU","accountId":"demo-account-07"}]
