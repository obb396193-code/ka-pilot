DATABASE_URL=postgres://ka:ka@127.0.0.1:55432/ka
DINGTALK_CLIENT_ID=
# 由部署平台 Secret 服务在运行时注入，仓库与数据库不保存真实值
DINGTALK_CLIENT_SECRET=
KA_WORKSPACE_ID=
KA_API_BASE_URL=http://ka-web-api.internal
# 可选的应用间鉴权密钥，同样由 Secret 服务注入
KA_API_BEARER_TOKEN=
GATEWAY_API_TIMEOUT_MS=15000
# 32-byte AES-GCM key as 64 hex chars, injected by Secret service, never committed/logged.
# Generate securely: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Keep stable across restarts. Drain pending inbox before rotation; retain old key securely
# for operator recovery of dead records. No automatic plaintext fallback or key guessing.
GATEWAY_INBOX_KEY_HEX=
