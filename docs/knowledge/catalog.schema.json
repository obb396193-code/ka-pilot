{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ka-pilot.internal/schemas/knowledge-catalog-record-v1.json",
  "title": "KA 投放经营平台资料目录单条记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "title",
    "source_type",
    "original_source",
    "source_file_location",
    "source_system",
    "author_or_owner",
    "published_at",
    "ingested_at",
    "current_version",
    "content_hash_sha256",
    "applicable_media",
    "applicable_business",
    "access_level",
    "allowed_roles",
    "evidence_level",
    "analysis_status",
    "lifecycle_status",
    "review_status",
    "product_kb_publication_status",
    "supersedes_document_id",
    "deprecated_by_document_id",
    "related_product_modules",
    "related_specs",
    "storage_ref",
    "assessment_ref",
    "source_url",
    "license",
    "tags"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^ka-src-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["internal", "official", "competitor", "open_source", "research"]},
    "original_source": {"type": "string", "minLength": 1},
    "source_file_location": {"type": "string", "minLength": 1},
    "source_system": {"type": "string", "minLength": 1},
    "author_or_owner": {"type": "string", "minLength": 1},
    "published_at": {"type": ["string", "null"]},
    "ingested_at": {"type": "string", "minLength": 1},
    "current_version": {"type": "string", "minLength": 1},
    "content_hash_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applicable_media": {"type": "array", "items": {"type": "string"}},
    "applicable_business": {"type": "array", "items": {"type": "string"}},
    "access_level": {"enum": ["public", "project_internal", "restricted", "confidential"]},
    "allowed_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_level": {"enum": ["E1", "E2", "E3", "E4", "E5"]},
    "analysis_status": {"enum": ["not_started", "in_progress", "completed"]},
    "lifecycle_status": {"enum": ["raw", "analyzed", "review_pending", "reviewed", "approved", "published", "deprecated"]},
    "review_status": {"enum": ["not_submitted", "pending", "in_review", "reviewed", "approved", "rejected"]},
    "product_kb_publication_status": {"enum": ["not_ready", "ready", "published", "deprecated"]},
    "supersedes_document_id": {"type": ["string", "null"]},
    "deprecated_by_document_id": {"type": ["string", "null"]},
    "related_product_modules": {"type": "array", "items": {"type": "string"}},
    "related_specs": {"type": "array", "items": {"type": "string"}},
    "storage_ref": {"type": "string", "pattern": "^private/knowledge-sources/"},
    "assessment_ref": {"type": "string", "pattern": "^docs/knowledge/assessments/"},
    "source_url": {"type": ["string", "null"]},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "citation_boundary"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "citation_boundary": {"type": "string", "minLength": 1}
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
