{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ka-pilot.local/schemas/frontend-source-import-manifest.json",
  "title": "KA Pilot frontend source import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "imports"],
  "properties": {
    "version": { "const": 1 },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_kind",
          "source_repo",
          "source_commit",
          "source_files",
          "destination_files",
          "copied_dependencies",
          "license_or_internal_authority",
          "modifications",
          "boss_approved",
          "runtime_status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_kind": { "enum": ["official", "contentradar"] },
          "source_repo": { "type": "string", "minLength": 1 },
          "source_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "source_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "destination_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "copied_dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "license_or_internal_authority": { "type": "string", "minLength": 1 },
          "modifications": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "boss_approved": { "type": "boolean" },
          "runtime_status": { "enum": ["candidate", "isolated", "adapted", "approved"] }
        }
      }
    }
  }
}
