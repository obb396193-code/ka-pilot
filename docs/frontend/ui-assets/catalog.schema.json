{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ka-pilot/ui-asset-catalog.schema.json",
  "title": "KA Pilot UI Asset Catalog Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "upstream_name",
    "display_name",
    "description",
    "kind",
    "category",
    "preview_url",
    "source_url",
    "install_command",
    "foundation",
    "license",
    "dependencies",
    "project_fit",
    "theme_ready",
    "last_verified",
    "upstream_ref",
    "local_status",
    "local_path",
    "decision_record",
    "comparison_record",
    "upstream_meta"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "upstream_name": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["primitive", "component", "particle", "block", "page", "template", "theme", "motion", "style", "hook", "utility", "font"]
    },
    "category": { "type": "string", "minLength": 1 },
    "preview_url": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "minLength": 1 },
    "install_command": { "type": "string" },
    "foundation": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "project_fit": { "type": "string", "minLength": 1 },
    "theme_ready": { "type": "string", "enum": ["yes", "partial", "no", "unknown"] },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "upstream_ref": { "type": "string", "minLength": 1 },
    "local_status": {
      "type": "string",
      "enum": ["catalogued", "approved", "preferred", "vendored", "adapted", "deprecated"]
    },
    "local_path": { "type": "string" },
    "decision_record": { "type": "string" },
    "comparison_record": { "type": "string" },
    "upstream_meta": { "type": "object" }
  }
}
